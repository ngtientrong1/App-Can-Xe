@model CanXe.Debt.Web.PeriodCardModel
@{
    var v = Model.View;
    var open = v.IsOpen;
}
<section class="period @(open ? "open" : "")" id="@(open ? "ky-mo" : "ky-" + v.Id)">
    <div class="period-head">
        <h3>@(open ? $"Xe chưa gom lô · {v.TruckCount} xe" : $"Lô {Fmt.PeriodRange(v)}")</h3>
        @switch (v.Status)
        {
            case PeriodStatus.Open: <span class="badge pending">Chưa chốt</span> break;
            case PeriodStatus.Owing: <span class="badge unpaid">Còn nợ @Fmt.Vnd(v.Remaining)</span> break;
            case PeriodStatus.Settled: <span class="badge paid">Đã trả đủ</span> break;
            default: <span class="badge partial">Đã ứng trước @Fmt.Vnd(-v.Remaining)</span> break;
        }
    </div>

    <div class="mini-stats">
        <div><div class="label">Nợ từ lô trước</div><div class="value">@Fmt.Balance(v.CarryIn)</div></div>
        <div><div class="label">Tiền hàng · @v.PricedCount xe · @Fmt.Kg(v.BillableKg) kg</div><div class="value">@Fmt.Vnd(v.TicketsTotal)</div></div>
        <div><div class="label">Tổng phải trả</div><div class="value">@Fmt.Balance(v.Payable)</div></div>
        <div><div class="label">Đã trả@(v.Payments.Count > 0 ? $" · {v.Payments.Count} lần" : "")</div><div class="value credit">@Fmt.Vnd(v.Paid)</div></div>
    </div>

    @if (v.ByStation.Count > 0)
    {
        <div class="chips" aria-label="Cà theo điểm cân">
            @foreach (var s in v.ByStation)
            {
                <span class="chip"><span class="@Fmt.StationClass(s.StationCode)">@s.StationName</span> @s.TruckCount xe · @Fmt.Kg(s.BillableKg) kg · <strong>@Fmt.Vnd(s.Amount)</strong></span>
            }
        </div>
    }

    @if (v.AwaitingCount > 0 || v.NoPriceCount > 0)
    {
        <div class="alert warn" role="status">
            @if (v.AwaitingCount > 0) { <span><strong>@v.AwaitingCount xe</strong> chờ cân lần 2 (trả xác). </span> }
            @if (v.NoPriceCount > 0) { <span><strong>@v.NoPriceCount xe</strong> chưa có đơn giá. </span> }
            Chưa tính vào tiền. Khi app cân có đủ số cân và giá, nhập lại file là các xe này tự cộng vào lô này.
        </div>
    }
    @if (v.ChangedAfterCloseCount > 0)
    {
        <div class="alert warn" role="status">
            <strong>@v.ChangedAfterCloseCount xe</strong> được nhập hoặc đổi giá sau khi chốt lô (tổng @Fmt.Vnd(v.ChangedAfterCloseAmount)). Tiền hàng và số còn nợ của lô đã tính lại.
        </div>
    }

    @if (v.Payments.Count > 0)
    {
        <div>
            @foreach (var p in v.Payments)
            {
                <div class="pay-line">
                    <span>
                        @Fmt.Date(p.PaidOn) · @(open ? "Ứng trước · " : "")@(p.Method == PaymentMethod.Cash ? "Tiền mặt" : p.Method == PaymentMethod.Offset ? (string.IsNullOrWhiteSpace(p.BankName) ? "Bù trừ công nợ" : $"Bù trừ ({p.BankName})") : string.IsNullOrWhiteSpace(p.BankName) ? "Chuyển khoản" : $"Chuyển khoản ({p.BankName})")
                        @if (!string.IsNullOrWhiteSpace(p.PaidBy)) { <span> · @p.PaidBy chi</span> }
                        @if (!string.IsNullOrWhiteSpace(p.ReceivedBy)) { <span> · @p.ReceivedBy nhận</span> }
                        @if (!string.IsNullOrWhiteSpace(p.Note)) { <span class="muted"> · @p.Note</span> }
                        <span class="muted small"> · nhập bởi @p.CreatedBy lúc @Fmt.DateTime(p.CreatedAt)</span>
                        @if (p.EditedAt is { } editedAt)
                        {
                            <details class="edit-log small"><summary class="muted">đã sửa lúc @Fmt.DateTime(editedAt) bởi @p.EditedBy</summary><div class="muted">@foreach (var line in (p.EditLog ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <div>@line</div> }</div></details>
                        }
                    </span>
                    <span>
                        <span class="amount">@Fmt.Vnd(p.AmountVnd)</span>
                        @if (Model.SeasonOpen)
                        {
                            <details class="no-print edit-pay">
                                <summary>Sửa</summary>
                                <form method="post" asp-page="/Customers/Detail" asp-page-handler="EditPayment" asp-route-id="@Model.CustomerId" asp-route-SeasonId="@Model.SeasonId" class="form-grid">
                                    <input type="hidden" name="EditId" value="@p.Id" />
                                    <label>Ngày trả<input type="text" name="PaidOn" inputmode="numeric" data-date maxlength="10" value="@Fmt.Date(p.PaidOn)" autocomplete="off" required /></label>
                                    <label>Số tiền (đồng)<input type="text" name="AmountText" inputmode="numeric" data-money value="@Fmt.Vnd(p.AmountVnd)" autocomplete="off" required /></label>
                                    <label>Hình thức
                                        <select name="Method">
                                            <option value="Transfer" selected="@(p.Method == PaymentMethod.Transfer)">Chuyển khoản</option>
                                            <option value="Cash" selected="@(p.Method == PaymentMethod.Cash)">Tiền mặt</option>
                                            <option value="Offset" selected="@(p.Method == PaymentMethod.Offset)">Trừ vào công nợ khác</option>
                                        </select>
                                    </label>
                                    <label>Ngân hàng / tài khoản<input type="text" name="BankName" value="@p.BankName" list="banks" /></label>
                                    <label>Người chi (bên mình)<input type="text" name="PaidBy" value="@p.PaidBy" list="payers" /></label>
                                    <label>Người nhận tiền<input type="text" name="ReceivedBy" value="@p.ReceivedBy" list="receivers" /></label>
                                    <label>Ghi chú<input type="text" name="Note" value="@p.Note" /></label>
                                    <div><button type="submit">Lưu sửa</button></div>
                                </form>
                            </details>
                            <details class="no-print">
                                <summary>Hủy</summary>
                                <form method="post" asp-page="/Customers/Detail" asp-page-handler="Void" asp-route-id="@Model.CustomerId" asp-route-SeasonId="@Model.SeasonId" class="inline-form" data-confirm="Hủy khoản trả này?">
                                    <input type="hidden" name="VoidId" value="@p.Id" />
                                    <input type="text" name="VoidReason" placeholder="Lý do hủy" required />
                                    <button type="submit" class="danger">Hủy</button>
                                </form>
                            </details>
                        }
                    </span>
                </div>
            }
        </div>
    }

    @if (open)
    {
        <div class="outcome open">Tổng nợ chủ hàng hiện tại: @(v.Remaining > 0 ? Fmt.Vnd(v.Remaining) : v.Remaining < 0 ? $"đã trả trước {Fmt.Vnd(-v.Remaining)}" : "không còn nợ")</div>
    }
    else if (v.Status == PeriodStatus.Owing)
    {
        <div class="outcome owe">Còn nợ @Fmt.Vnd(v.Remaining) (trả sau)</div>
    }
    else if (v.Status == PeriodStatus.PaidAhead)
    {
        <div class="outcome ahead">Trả dư @Fmt.Vnd(-v.Remaining) → trừ vào lô sau</div>
    }
    else
    {
        <div class="outcome done">Đã trả đủ lô này</div>
    }

    @if (v.Tickets.Count > 0 && open && Model.SeasonOpen)
    {
        <form method="post" asp-page="/Customers/Detail" asp-page-handler="Close" asp-route-id="@Model.CustomerId" asp-route-SeasonId="@Model.SeasonId" data-close-form>
            <div class="select-bar no-print">
                <strong>Chọn xe để gom thành lô</strong>
                <button type="button" class="secondary" data-select="all">Chọn tất cả</button>
                <button type="button" class="secondary" data-select="none">Bỏ chọn</button>
                <span class="select-range">
                    <label>Từ phiếu
                        <select data-range-from>
                            @for (var i = 0; i < v.Tickets.Count; i++)
                            {
                                var o = v.Tickets[i];
                                <option value="@i">@Fmt.Date(o.TicketDate) · @o.DisplayNumber · @Model.StationName(o.StationCode)@(string.IsNullOrWhiteSpace(o.LicensePlate) ? "" : " · " + o.LicensePlate)</option>
                            }
                        </select>
                    </label>
                    <label>đến phiếu
                        <select data-range-to>
                            @for (var i = 0; i < v.Tickets.Count; i++)
                            {
                                var o = v.Tickets[i];
                                <option value="@i" selected="@(i == v.Tickets.Count - 1)">@Fmt.Date(o.TicketDate) · @o.DisplayNumber · @Model.StationName(o.StationCode)@(string.IsNullOrWhiteSpace(o.LicensePlate) ? "" : " · " + o.LicensePlate)</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="secondary" data-select="range">Chọn dải này</button>
                </span>
                <span class="select-range">
                    <label>hoặc đến hết ngày <input type="text" inputmode="numeric" data-date maxlength="10" placeholder="dd/MM/yyyy" autocomplete="off" data-select-until /></label>
                    <button type="button" class="secondary" data-select="until">Chọn</button>
                </span>
            </div>

            <div class="table-wrap">
                <table class="pick">
                    <thead>
                    <tr>
                        <th class="no-print"></th><th>Ngày giờ</th><th>Số phiếu</th><th>Điểm cân</th><th>Biển số</th><th class="col-opt">Loại hàng</th>
                        <th class="num col-opt">Tổng</th><th class="num col-opt">Bì</th><th class="num">Hàng</th><th class="num">KL tính tiền</th>
                        <th class="num">Đơn giá</th><th class="num">Thành tiền</th><th>Tình trạng</th><th>Ghi chú</th><th class="no-print"></th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (var ti = 0; ti < v.Tickets.Count; ti++)
                    {
                        var t = v.Tickets[ti];
                        var st = v.TruckStatuses[ti];
                        <tr class="@(t.Stage == TicketStage.Priced ? "" : "dim")">
                            <td class="no-print"><input type="checkbox" name="TicketIds" value="@t.Id" aria-label="Chọn phiếu @t.DisplayNumber"
                                       data-pick data-day="@t.TicketDate.ToString("yyyy-MM-dd")" data-amount="@(t.Stage == TicketStage.Priced ? t.AmountVnd ?? 0 : 0)"
                                       data-kg="@((t.Stage == TicketStage.Priced ? t.BillableWeightKg ?? 0 : 0).ToString(System.Globalization.CultureInfo.InvariantCulture))" /></td>
                            <td class="nowrap">@Fmt.DateTime(t.TicketDateTime)</td>
                            <td>@t.DisplayNumber</td>
                            <td><span class="@Fmt.StationClass(t.StationCode)">@Model.StationName(t.StationCode)</span></td>
                            <td class="nowrap">@t.LicensePlate</td>
                            <td class="col-opt">@t.Cargo</td>
                            @if (t.Stage == TicketStage.AwaitingSecondWeigh)
                            {
                                <td class="num col-opt">—</td>
                                <td class="num col-opt">—</td>
                                <td class="num" title="Chờ cân lần 2">Lần 1: @Fmt.Kg(t.FirstWeightKg)</td>
                            }
                            else
                            {
                                <td class="num col-opt">@Fmt.Kg(t.GrossWeightKg)</td>
                                <td class="num col-opt">@Fmt.Kg(t.TareWeightKg)</td>
                                <td class="num">@Fmt.Kg(t.NetWeightKg)@if (t.IsAdjusted) { <span class="adj" title="@Fmt.AdjustTitle(t)">đã chỉnh</span> }</td>
                            }
                            <td class="num">@Fmt.Kg(t.BillableWeightKg)</td>
                            <td class="num">@Fmt.UnitPrice(t)</td>
                            <td class="num">@Fmt.Vnd(t.AmountVnd)</td>
                            <td>
                                @switch (t.Stage)
                                {
                                    case TicketStage.AwaitingSecondWeigh: <span class="badge partial stage">Chờ cân lần 2</span> break;
                                    case TicketStage.NoPrice: <span class="badge pending stage">Chưa có giá</span> break;
                                    default:
                                        if (st.Status == SettlementStatus.Paid) { <span class="badge paid stage">Đã trả đủ</span> }
                                        else if (st.Status == SettlementStatus.Partial) { <span class="badge partial stage">Đã trả @Fmt.Vnd(st.Allocated)</span> }
                                        else { <span class="badge unpaid stage">Chưa trả</span> }
                                        break;
                                }
                            </td>
                            <td>@t.Notes@if (User.IsInRole("Admin") && t.Stage != TicketStage.AwaitingSecondWeigh) { <a class="no-print small edit-ticket" asp-page="/Admin/TicketEdit" asp-route-id="@t.Id">Sửa phiếu</a> }</td>
                            <td class="no-print"><button type="submit" name="PayOne" value="@t.Id" class="secondary pay-one" title="Gom riêng xe này thành một lô rồi trả">Trả riêng</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="select-foot no-print">
                <div class="outcome open" data-sel-summary data-carry="@v.CarryIn">Chưa chọn xe nào.</div>
                <button type="submit" name="PayNow" value="false">Gom thành lô</button>
                <button type="submit" name="PayNow" value="true" class="secondary">Gom lô rồi trả luôn</button>
            </div>
        </form>
    }
    else if (v.Tickets.Count > 0)
    {
        <details>
            <summary>Xem @v.TruckCount xe trong lô</summary>
            <h4 class="small-head">Theo ngày và điểm cân</h4>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Ngày</th><th>Điểm cân</th><th class="num">Số xe</th><th class="num">KL tính tiền</th><th class="num">Đơn giá</th><th class="num">Thành tiền</th></tr></thead>
                    <tbody>
                    @foreach (var day in v.Days)
                    {
                        <tr>
                            <td class="nowrap">@Fmt.Date(day.Date)</td>
                            <td><span class="@Fmt.StationClass(day.StationCode)">@day.StationName</span></td>
                            <td class="num">@day.TruckCount@(day.UnfinishedCount > 0 ? $" ({day.UnfinishedCount} chưa tính)" : "")</td>
                            <td class="num">@Fmt.Kg(day.BillableKg)</td>
                            <td class="num">@(string.IsNullOrEmpty(day.PricesText) ? "—" : day.PricesText)</td>
                            <td class="num">@Fmt.Vnd(day.Amount)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <h4 class="small-head">Từng xe</h4>
            <div class="table-wrap">
                <table>
                    <thead>
                    <tr>
                        <th>Ngày giờ</th><th>Số phiếu</th><th>Điểm cân</th><th>Biển số</th><th class="col-opt">Loại hàng</th>
                        <th class="num col-opt">Tổng</th><th class="num col-opt">Bì</th><th class="num">Hàng</th><th class="num">KL tính tiền</th>
                        <th class="num">Đơn giá</th><th class="num">Thành tiền</th><th>Tình trạng</th><th>Ghi chú</th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (var ti = 0; ti < v.Tickets.Count; ti++)
                    {
                        var t = v.Tickets[ti];
                        var st = v.TruckStatuses[ti];
                        <tr class="@(t.Stage == TicketStage.Priced ? "" : "dim")">
                            <td class="nowrap">@Fmt.DateTime(t.TicketDateTime)</td>
                            <td>@t.DisplayNumber</td>
                            <td><span class="@Fmt.StationClass(t.StationCode)">@Model.StationName(t.StationCode)</span></td>
                            <td class="nowrap">@t.LicensePlate</td>
                            <td class="col-opt">@t.Cargo</td>
                            @if (t.Stage == TicketStage.AwaitingSecondWeigh)
                            {
                                <td class="num col-opt">—</td>
                                <td class="num col-opt">—</td>
                                <td class="num" title="Chờ cân lần 2">Lần 1: @Fmt.Kg(t.FirstWeightKg)</td>
                            }
                            else
                            {
                                <td class="num col-opt">@Fmt.Kg(t.GrossWeightKg)</td>
                                <td class="num col-opt">@Fmt.Kg(t.TareWeightKg)</td>
                                <td class="num">@Fmt.Kg(t.NetWeightKg)@if (t.IsAdjusted) { <span class="adj" title="@Fmt.AdjustTitle(t)">đã chỉnh</span> }</td>
                            }
                            <td class="num">@Fmt.Kg(t.BillableWeightKg)</td>
                            <td class="num">@Fmt.UnitPrice(t)</td>
                            <td class="num">@Fmt.Vnd(t.AmountVnd)</td>
                            <td>
                                @switch (t.Stage)
                                {
                                    case TicketStage.AwaitingSecondWeigh: <span class="badge partial stage">Chờ cân lần 2</span> break;
                                    case TicketStage.NoPrice: <span class="badge pending stage">Chưa có giá</span> break;
                                    default:
                                        if (st.Status == SettlementStatus.Paid) { <span class="badge paid stage">Đã trả đủ</span> }
                                        else if (st.Status == SettlementStatus.Partial) { <span class="badge partial stage">Đã trả @Fmt.Vnd(st.Allocated)</span> }
                                        else { <span class="badge unpaid stage">Chưa trả</span> }
                                        break;
                                }
                            </td>
                            <td>@t.Notes@if (User.IsInRole("Admin") && t.Stage != TicketStage.AwaitingSecondWeigh) { <a class="no-print small edit-ticket" asp-page="/Admin/TicketEdit" asp-route-id="@t.Id">Sửa phiếu</a> }</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr>
                        <th colspan="4" class="right">Tổng</th>
                        <th class="col-opt" colspan="3"></th>
                        <th class="num">@Fmt.Kg(v.NetKg)</th>
                        <th class="num">@Fmt.Kg(v.BillableKg)</th>
                        <th></th>
                        <th class="num">@Fmt.Vnd(v.TicketsTotal)</th>
                        <th></th>
                        <th></th>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </details>
    }

    @if (Model.CanUndo)
    {
        <form method="post" asp-page="/Customers/Detail" asp-page-handler="Undo" asp-route-id="@Model.CustomerId" asp-route-SeasonId="@Model.SeasonId" class="no-print" data-confirm="Hủy chốt lô này? Các xe sẽ quay về lô đang mở.">
            <button type="submit" class="secondary">Hủy chốt lô này</button>
        </form>
    }
</section>
