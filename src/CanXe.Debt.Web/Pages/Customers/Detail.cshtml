@page "{id:int}"
@using System.Security.Claims
@inject SeasonService Seasons
@inject LedgerService Ledger
@inject PaymentService Payments
@functions {
    [BindProperty(SupportsGet = true)] public int Id { get; set; }
    [BindProperty(SupportsGet = true)] public int? SeasonId { get; set; }

    [BindProperty] public DateOnly PaidOn { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [BindProperty] public string AmountText { get; set; } = "";
    [BindProperty] public PaymentMethod Method { get; set; } = PaymentMethod.Cash;
    [BindProperty] public string? BankName { get; set; }
    [BindProperty] public string? ReceivedBy { get; set; }
    [BindProperty] public string? Note { get; set; }
    [BindProperty] public int VoidId { get; set; }
    [BindProperty] public string? VoidReason { get; set; }

    public CustomerLedgerView? View { get; set; }
    public Dictionary<string, string> Stations { get; set; } = [];
    public string? Error { get; set; }
    public string? Message { get; set; }

    public async Task<IActionResult> OnGetAsync()
    {
        Message = TempData["Message"] as string;
        return await LoadAsync() ? Page() : NotFound();
    }

    public async Task<IActionResult> OnPostPayAsync()
    {
        if (!await LoadAsync())
            return NotFound();

        if (!Fmt.TryParseVnd(AmountText, out var amount))
        {
            Error = "Số tiền không hợp lệ. Chỉ nhập chữ số, ví dụ 150.000.000.";
            return Page();
        }

        var result = await Payments.AddAsync(
            Id, View!.Season.Id, PaidOn, amount, Method, Note, User.Identity!.Name!, ReceivedBy, BankName);
        if (!result.Ok)
        {
            Error = result.Error;
            return Page();
        }

        TempData["Message"] = $"Đã ghi nhận trả {Fmt.Vnd(amount)} đ ({Fmt.Method(Method).ToLowerInvariant()}).";
        return RedirectToPage(new { id = Id, seasonId = View.Season.Id });
    }

    public async Task<IActionResult> OnPostVoidAsync()
    {
        if (!await LoadAsync())
            return NotFound();

        var result = await Payments.VoidAsync(VoidId, VoidReason ?? "", User.Identity!.Name!);
        if (!result.Ok)
        {
            Error = result.Error;
            return Page();
        }

        TempData["Message"] = "Đã hủy khoản trả (vẫn lưu lại trong lịch sử).";
        return RedirectToPage(new { id = Id, seasonId = View!.Season.Id });
    }

    private async Task<bool> LoadAsync()
    {
        var season = SeasonId is { } sid ? await Seasons.GetAsync(sid) : await Seasons.GetCurrentAsync();
        if (season is null)
            return false;

        View = await Ledger.GetCustomerAsync(Id, season);
        Stations = await Ledger.GetStationNamesAsync();
        if (View is not null && !View.Season.Contains(PaidOn))
            PaidOn = View.Season.EndDate ?? View.Season.StartDate;
        return View is not null;
    }

    private string Station(string code) => Stations.GetValueOrDefault(code, code);
}
@if (View is null) { return; }
@{
    var customer = View.Customer;
    var ledger = View.Ledger;
    var season = View.Season;
    ViewData["Title"] = customer.Name;
    var open = !season.IsClosed;
    var voided = View.Payments.Where(p => p.IsVoided).ToList();
}
<div class="page-head">
    <div>
        <h1>@customer.Name</h1>
        <div class="muted">@season.Name · @Fmt.Date(season.StartDate) – @(season.EndDate is { } e ? Fmt.Date(e) : "nay")@(customer.Phone is null ? "" : " · " + customer.Phone)</div>
    </div>
    <div class="toolbar">
        <a class="btn secondary" asp-page="/Customers/Statement" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id">In bảng kê</a>
        <a class="btn secondary" asp-page="/Index" asp-route-SeasonId="@season.Id">← Tổng quan</a>
    </div>
</div>

@if (Message is not null) { <div class="alert ok" role="status">@Message</div> }
@if (Error is not null) { <div class="alert error" role="alert">@Error</div> }

<section class="stats" aria-label="Tổng hợp chủ hàng">
    <div class="stat"><div class="label">Phải trả · @View.Tickets.Count(t => t.Settlement.Status != SettlementStatus.Pending) xe · @Fmt.Kg(View.TotalBillableKg) kg</div><div class="value">@Fmt.Vnd(ledger.Billed)</div></div>
    <div class="stat good"><div class="label">Đã trả · mặt @Fmt.Vnd(View.CashPaid) · CK @Fmt.Vnd(View.TransferPaid)</div><div class="value">@Fmt.Vnd(ledger.Paid)</div></div>
    @if (ledger.Balance >= 0)
    {
        <div class="stat debt"><div class="label">Còn nợ</div><div class="value">@Fmt.Vnd(ledger.Balance)</div></div>
    }
    else
    {
        <div class="stat good"><div class="label">Đã ứng trước (trừ vào các xe sau)</div><div class="value">@Fmt.Vnd(ledger.Credit)</div></div>
    }
</section>

@if (View.Tickets.Any(t => t.Settlement.Status == SettlementStatus.Pending))
{
    <div class="alert warn" role="status">Có phiếu chưa có đơn giá nên chưa tính vào nợ. Khi app cân cập nhật giá, hãy nhập lại file.</div>
}

@if (open)
{
    <div class="card" id="thu">
        <h2>Ghi nhận trả tiền</h2>
        <form method="post" asp-page-handler="Pay" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id">
            <div class="form-grid">
                <div class="field"><label for="PaidOn">Ngày trả</label><input id="PaidOn" name="PaidOn" type="date" value="@PaidOn.ToString("yyyy-MM-dd")" required /></div>
                <div class="field">
                    <label for="AmountText">Số tiền (đồng)</label>
                    <input id="AmountText" name="AmountText" type="text" inputmode="numeric" data-money value="@AmountText" autocomplete="off" required />
                </div>
                <div class="field">
                    <label>Hình thức</label>
                    <div class="radio-row">
                        <label><input type="radio" name="Method" value="Cash" checked="@(Method == PaymentMethod.Cash)" /> Tiền mặt</label>
                        <label><input type="radio" name="Method" value="Transfer" checked="@(Method == PaymentMethod.Transfer)" /> Chuyển khoản</label>
                    </div>
                </div>
                <div class="field"><label for="BankName">Ngân hàng (nếu chuyển khoản)</label><input id="BankName" name="BankName" type="text" value="@BankName" placeholder="Vietcombank…" /></div>
                <div class="field"><label for="ReceivedBy">Người nhận tiền</label><input id="ReceivedBy" name="ReceivedBy" type="text" value="@ReceivedBy" placeholder="Ai nhận giùm…" /></div>
                <div class="field"><label for="Note">Ghi chú (không bắt buộc)</label><input id="Note" name="Note" type="text" value="@Note" /></div>
            </div>
            <p class="toolbar">
                <button type="submit">Ghi nhận trả tiền</button>
                @if (ledger.Balance > 0)
                {
                    <button type="button" class="secondary" data-fill="AmountText" data-value="@ledger.Balance">Trả hết (@Fmt.Vnd(ledger.Balance))</button>
                }
            </p>
        </form>
    </div>
}
else
{
    <div class="alert warn">Mùa này đã chốt nên không trả thêm hoặc hủy khoản trả được.</div>
}

<div class="card">
    <h2>Sổ công nợ</h2>
    @if (View.Statement.Count == 0)
    {
        <p class="muted">Chưa có phiếu hay khoản trả nào trong mùa này.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="ledger">
                <thead>
                <tr>
                    <th>Ngày</th><th>Nội dung</th>
                    <th class="num">Phải trả</th><th class="num">Đã trả</th><th class="num">Còn nợ</th><th class="no-print"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var line in View.Statement)
                {
                    if (line.Kind == StatementLineKind.Tickets)
                    {
                        <tr>
                            <td class="nowrap">@Fmt.Date(line.Date)</td>
                            <td>
                                <details>
                                    <summary>@line.Description · @Fmt.Kg(line.TotalBillableKg) kg@(line.PendingCount > 0 ? $" · {line.PendingCount} xe chưa có giá" : "")</summary>
                                    <ul class="truck-list">
                                        @foreach (var t in line.Tickets)
                                        {
                                            <li>@t.DisplayNumber · @t.LicensePlate · @Fmt.Kg(t.BillableWeightKg) kg × @Fmt.UnitPrice(t) = @(t.AmountVnd is null ? "chưa có giá" : Fmt.Vnd(t.AmountVnd))</li>
                                        }
                                    </ul>
                                </details>
                            </td>
                            <td class="num">@Fmt.Vnd(line.Debit)</td>
                            <td class="num"></td>
                            <td class="num @(line.Balance > 0 ? "debt-pos" : line.Balance < 0 ? "debt-neg" : "debt-zero")">@Fmt.Balance(line.Balance)</td>
                            <td class="no-print"></td>
                        </tr>
                    }
                    else
                    {
                        var p = line.Payment!;
                        <tr class="payment-row">
                            <td class="nowrap">@Fmt.Date(line.Date)</td>
                            <td>@line.Description<div class="muted small">Nhập bởi @p.CreatedBy lúc @Fmt.DateTime(p.CreatedAt)</div></td>
                            <td class="num"></td>
                            <td class="num credit">@Fmt.Vnd(line.Credit)</td>
                            <td class="num @(line.Balance > 0 ? "debt-pos" : line.Balance < 0 ? "debt-neg" : "debt-zero")">@Fmt.Balance(line.Balance)</td>
                            <td class="no-print">
                                @if (open)
                                {
                                    <details>
                                        <summary>Hủy</summary>
                                        <form method="post" asp-page-handler="Void" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id" class="inline-form" data-confirm="Hủy khoản trả này?">
                                            <input type="hidden" name="VoidId" value="@p.Id" />
                                            <input type="text" name="VoidReason" placeholder="Lý do hủy" required />
                                            <button type="submit" class="danger">Hủy</button>
                                        </form>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <p class="muted">Bấm vào dòng số xe để xem từng xe. “Còn nợ” là số dư sau mỗi dòng; đã ứng trước thì hiện màu xanh.</p>
    }

    @if (voided.Count > 0)
    {
        <details>
            <summary>@voided.Count khoản trả đã hủy</summary>
            <ul>
                @foreach (var p in voided)
                {
                    <li>@Fmt.Date(p.PaidOn): @Fmt.Vnd(p.AmountVnd) đ (@Fmt.Method(p.Method)) — hủy bởi @p.VoidedBy: @p.VoidReason</li>
                }
            </ul>
        </details>
    }
</div>

<div class="card">
    <h2>Chi tiết các xe đã cân (@View.Tickets.Count)</h2>
    @if (View.Tickets.Count == 0)
    {
        <p class="muted">Chưa có phiếu nào của chủ hàng trong mùa này.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>Ngày giờ</th><th>Số phiếu</th><th>Điểm cân</th><th>Biển số</th><th>Loại hàng</th>
                    <th class="num">Tổng</th><th class="num">Bì</th><th class="num">Hàng</th><th class="num">KL tính tiền</th>
                    <th class="num">Đơn giá</th><th class="num">Thành tiền</th><th>Thanh toán</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in View.Tickets)
                {
                    var t = row.Ticket;
                    <tr>
                        <td class="nowrap">@Fmt.DateTime(t.TicketDateTime)</td>
                        <td>@t.DisplayNumber</td>
                        <td>@Station(t.StationCode)</td>
                        <td class="nowrap">@t.LicensePlate</td>
                        <td>@t.Cargo</td>
                        <td class="num">@Fmt.Kg(t.GrossWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.TareWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.NetWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.BillableWeightKg)</td>
                        <td class="num">@Fmt.UnitPrice(t)</td>
                        <td class="num">@Fmt.Vnd(t.AmountVnd)</td>
                        <td>
                            @switch (row.Settlement.Status)
                            {
                                case SettlementStatus.Paid: <span class="badge paid">Đã trả</span> break;
                                case SettlementStatus.Partial: <span class="badge partial">Còn @Fmt.Vnd(row.Settlement.Remaining)</span> break;
                                case SettlementStatus.Unpaid: <span class="badge unpaid">Chưa trả</span> break;
                                default: <span class="badge pending">Chưa có giá</span> break;
                            }
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                <tr>
                    <th colspan="7" class="right">Tổng</th>
                    <th class="num">@Fmt.Kg(View.TotalNetKg)</th>
                    <th class="num">@Fmt.Kg(View.TotalBillableKg)</th>
                    <th></th>
                    <th class="num">@Fmt.Vnd(ledger.Billed)</th>
                    <th></th>
                </tr>
                </tfoot>
            </table>
        </div>
        <p class="muted">Tiền chủ hàng trả được trừ dần vào các xe cũ nhất trước để biết xe nào đã thanh toán.</p>
    }
</div>
