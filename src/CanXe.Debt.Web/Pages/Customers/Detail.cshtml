@page "{id:int}"
@inject SeasonService Seasons
@inject LedgerService Ledger
@inject SettlementService Settlements
@inject PaymentService Payments
@inject CustomerService Customers
@functions {
    private string? DateError(string field, string label) =>
        ModelState.GetFieldValidationState(field) == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid
            ? $"{label} không hợp lệ. Nhập dạng 27/10/2026."
            : null;
    public PaymentSuggestions Suggestions { get; set; } = new([], [], []);
    [BindProperty(SupportsGet = true)] public int Id { get; set; }
    [BindProperty(SupportsGet = true)] public int? SeasonId { get; set; }
    [BindProperty(SupportsGet = true)] public int? Pay { get; set; }
    [BindProperty] public List<int> TicketIds { get; set; } = [];
    [BindProperty] public int? PayOne { get; set; }
    [BindProperty] public bool PayNow { get; set; }

    [BindProperty] public DateOnly PaidOn { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [BindProperty] public string AmountText { get; set; } = "";
    [BindProperty] public PaymentMethod Method { get; set; } = PaymentMethod.Cash;
    [BindProperty] public int? PeriodId { get; set; }
    [BindProperty] public string? BankName { get; set; }
    [BindProperty] public string? PaidBy { get; set; }
    [BindProperty] public string? ReceivedBy { get; set; }
    [BindProperty] public string? Note { get; set; }
    [BindProperty] public int VoidId { get; set; }
    [BindProperty] public string? VoidReason { get; set; }

    [BindProperty] public int UndoPaymentId { get; set; }
    public int? JustPaidId { get; set; }

    public Customer? Customer { get; set; }
    public Season? Season { get; set; }
    public CustomerSettlement? Settlement { get; set; }
    public Dictionary<string, string> Stations { get; set; } = [];
    public string? Error { get; set; }
    public string? Message { get; set; }

    public async Task<IActionResult> OnGetAsync()
    {
        Message = TempData["Message"] as string;
        JustPaidId = TempData["UndoPaymentId"] as int?;
        Error ??= TempData["Error"] as string;
        if (!await LoadAsync())
            return NotFound();

        // Coming from "Trả riêng" / "Chốt rồi trả luôn": the payment form opens on that period with its whole remainder filled in.
        if (Pay is { } target && Settlement!.Closed.FirstOrDefault(p => p.Id == target) is { Remaining: > 0 } period)
        {
            PeriodId = target;
            AmountText = period.Remaining.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }

        return Page();
    }

    public async Task<IActionResult> OnPostPayAsync()
    {
        if (!await LoadAsync())
            return NotFound();

        if (DateError(nameof(PaidOn), "Ngày trả") is { } dateError)
        {
            Error = dateError;
            return Page();
        }

        if (!Fmt.TryParseVnd(AmountText, out var amount))
        {
            Error = "Số tiền không hợp lệ. Chỉ nhập chữ số, ví dụ 150.000.000.";
            return Page();
        }

        var result = await Payments.AddAsync(
            Id, Season!.Id, PaidOn, amount, Method, Note, User.Identity!.Name!, ReceivedBy, BankName, PeriodId, paidBy: PaidBy);
        if (!result.Ok)
        {
            Error = result.Error;
            return Page();
        }

        TempData["Message"] = $"Đã ghi nhận trả {Fmt.Vnd(amount)} đ ({Fmt.Method(Method).ToLowerInvariant()}).";
        TempData["UndoPaymentId"] = result.Value!.Id;
        return RedirectToPage(new { id = Id, seasonId = Season.Id });
    }

    public async Task<IActionResult> OnPostUndoPaymentAsync()
    {
        var result = await Payments.UndoRecentAsync(UndoPaymentId, User.Identity!.Name!);
        TempData[result.Ok ? "Message" : "Error"] = result.Ok ? "Đã hoàn tác khoản trả vừa nhập (vẫn lưu lại trong lịch sử)." : result.Error;
        return RedirectToPage(new { id = Id, seasonId = SeasonId });
    }

    public async Task<IActionResult> OnPostCloseAsync()
    {
        if (!await LoadAsync())
            return NotFound();

        // "Trả riêng" on a row closes just that truck; otherwise the ticked trucks are gathered into one period.
        var ids = PayOne is { } one ? [one] : TicketIds;
        var result = await Settlements.ClosePeriodAsync(Id, Season!.Id, ids, User.Identity!.Name!);
        if (!result.Ok)
        {
            Error = result.Error;
            return Page();
        }

        var count = ids.Distinct().Count();
        if (PayOne is not null || PayNow)
            return RedirectToPage(new { id = Id, seasonId = Season.Id, pay = result.Value!.Id });

        TempData["Message"] = $"Đã chốt lô gồm {count} xe. Giờ có thể ghi nhận trả tiền cho lô này.";
        return RedirectToPage(new { id = Id, seasonId = Season.Id });
    }
    public async Task<IActionResult> OnPostUndoAsync()
    {
        if (!await LoadAsync())
            return NotFound();

        var result = await Settlements.UndoLastCloseAsync(Id, Season!.Id);
        if (!result.Ok)
        {
            Error = result.Error;
            return Page();
        }

        TempData["Message"] = "Đã hủy chốt lô gần nhất.";
        return RedirectToPage(new { id = Id, seasonId = Season.Id });
    }

    public async Task<IActionResult> OnPostVoidAsync()
    {
        if (!await LoadAsync())
            return NotFound();

        var result = await Payments.VoidAsync(VoidId, VoidReason ?? "", User.Identity!.Name!);
        if (!result.Ok)
        {
            Error = result.Error;
            return Page();
        }

        TempData["Message"] = "Đã hủy khoản trả (vẫn lưu lại trong lịch sử).";
        return RedirectToPage(new { id = Id, seasonId = Season!.Id });
    }

    private async Task<bool> LoadAsync()
    {
        Season = SeasonId is { } sid ? await Seasons.GetAsync(sid) : await Seasons.GetCurrentAsync();
        Customer = await Customers.GetAsync(Id);
        if (Season is null || Customer is null)
            return false;

        Settlement = await Settlements.GetAsync(Id, Season);
        Stations = await Ledger.GetStationNamesAsync();
        Suggestions = await Payments.GetSuggestionsAsync();
        if (!Season.Contains(PaidOn))
            PaidOn = Season.EndDate ?? Season.StartDate;
        return Settlement is not null;
    }
}
@if (Settlement is null || Customer is null || Season is null) { return; }
@{
    var customer = Customer;
    var season = Season;
    var s = Settlement;
    var open = !season.IsClosed;
    ViewData["Title"] = customer.Name;

    var openPeriod = s.Open;
    var lastClosed = s.Closed.LastOrDefault();
    var payable = s.Closed.Where(p => p.Remaining > 0).OrderBy(p => p.Number).ToList();
    var defaultPeriod = PeriodId;
}
<div class="page-head">
    <div>
        <h1>@customer.Name</h1>
        <div class="muted">@season.Name · @Fmt.Date(season.StartDate) – @(season.EndDate is { } e ? Fmt.Date(e) : "nay")@(customer.Phone is null ? "" : " · " + customer.Phone)</div>
    </div>
    <div class="toolbar">
        <a class="btn secondary" asp-page="/Customers/Statement" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id">In bảng kê</a>
        <a class="btn secondary" asp-page="/Index" asp-route-SeasonId="@season.Id">← Tổng quan</a>
    </div>
</div>

@if (Message is not null)
{
    <div class="alert ok undo-row" role="status">
        <span>@Message</span>
        @if (JustPaidId is { } justPaid)
        {
            <form method="post" asp-page-handler="UndoPayment" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id" class="inline-form">
                <input type="hidden" name="UndoPaymentId" value="@justPaid" />
                <button type="submit" class="secondary">Nhập nhầm? Hoàn tác</button>
            </form>
        }
    </div>
}
@if (Error is not null) { <div class="alert error" role="alert">@Error</div> }

<div class="split">
<aside class="rail">
<section class="stats stack" aria-label="Tổng hợp chủ hàng">
    <div class="stat"><div class="label">Tổng tiền hàng · @s.Periods.Sum(p => p.PricedCount) xe · @Fmt.Kg(s.Periods.Sum(p => p.BillableKg)) kg</div><div class="value">@Fmt.Vnd(s.TotalBilled)</div></div>
    <div class="stat good"><div class="label">Đã trả</div><div class="value">@Fmt.Vnd(s.TotalPaid)</div></div>
    @if (s.Balance >= 0)
    {
        <div class="stat debt">
            <div class="label">Còn nợ chủ hàng@(s.OldestUnpaidDate is { } since && s.Balance > 0 ? $" · nợ lâu nhất {Fmt.DaysSince(since)} ngày (từ {Fmt.Date(since)})" : "")</div>
            <div class="value">@Fmt.Vnd(s.Balance)</div>
        </div>
    }
    else
    {
        <div class="stat good"><div class="label">Đã ứng trước (trừ vào các xe sau)</div><div class="value">@Fmt.Vnd(-s.Balance)</div></div>
    }
</section>

@if (open)
{
    <div class="card" id="thu">
        <h2>Trả tiền / ứng tiền</h2>
        <form method="post" asp-page-handler="Pay" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id" data-pay-form>
            <div class="field full">
                <label for="AmountText">Số tiền (đồng)</label>
                <input id="AmountText" name="AmountText" class="big-input" type="text" inputmode="numeric" data-money data-pay-amount value="@AmountText" autocomplete="off" placeholder="Ví dụ 100.000.000" required />
            </div>
            <div class="chips-row" aria-label="Số tiền nhanh">
                <button type="button" class="secondary" data-pay-set="50000000">50 triệu</button>
                <button type="button" class="secondary" data-pay-set="100000000">100 triệu</button>
                <button type="button" class="secondary" data-pay-set="200000000">200 triệu</button>
                <button type="button" class="secondary" data-pay-set="500000000">500 triệu</button>
                <button type="button" class="secondary" data-pay-all>Trả hết nợ</button>
            </div>
            <div class="outcome open" data-pay-result></div>
            <div class="form-grid">
                <div class="field full">
                    <label for="PeriodId">Trả cho</label>
                    <select id="PeriodId" name="PeriodId" data-pay-period>
                        <option value="" data-remaining="@openPeriod.Remaining" data-label="Đang nợ" selected="@(defaultPeriod is null)">Chung: trừ vào tổng nợ (ứng trước hoặc trả theo số tiền)</option>
                        @foreach (var p in payable)
                        {
                            <option value="@p.Id" data-remaining="@p.Remaining" data-label="Lô @p.Number còn nợ" selected="@(p.Id == defaultPeriod)">Lô @p.Number · @p.TruckCount xe · còn nợ @Fmt.Vnd(p.Remaining)</option>
                        }
                    </select>
                </div>
                <div class="field"><label for="PaidOn">Ngày trả</label><input id="PaidOn" name="PaidOn" type="text" inputmode="numeric" data-date maxlength="10" placeholder="dd/MM/yyyy" autocomplete="off" value="@Fmt.Date(PaidOn)" required /></div>
                <div class="field full">
                    <label>Hình thức</label>
                    <div class="radio-row">
                        <label><input type="radio" name="Method" value="Cash" checked="@(Method == PaymentMethod.Cash)" /> Tiền mặt</label>
                        <label><input type="radio" name="Method" value="Transfer" checked="@(Method == PaymentMethod.Transfer)" /> Chuyển khoản</label>
                        <label><input type="radio" name="Method" value="Offset" checked="@(Method == PaymentMethod.Offset)" /> Trừ vào công nợ khác</label>
                    </div>
                </div>
            </div>
            <details class="more" open="@(!string.IsNullOrWhiteSpace(BankName) || !string.IsNullOrWhiteSpace(PaidBy) || !string.IsNullOrWhiteSpace(ReceivedBy) || !string.IsNullOrWhiteSpace(Note))">
                <summary>Thêm chi tiết (không bắt buộc): ngân hàng, người chi, người nhận, ghi chú</summary>
                <div class="form-grid">
                    <div class="field full"><label for="BankName">Ngân hàng / tài khoản</label><input id="BankName" name="BankName" type="text" value="@BankName" list="banks" placeholder="Vietcombank, tk công ty…" /></div>
                    <div class="field"><label for="PaidBy">Người chi (bên mình)</label><input id="PaidBy" name="PaidBy" type="text" value="@PaidBy" list="payers" placeholder="Bố giao, tài xế ứng…" /></div>
                    <div class="field"><label for="ReceivedBy">Người nhận tiền</label><input id="ReceivedBy" name="ReceivedBy" type="text" value="@ReceivedBy" list="receivers" placeholder="Ai nhận giùm…" /></div>
                    <div class="field full"><label for="Note">Ghi chú</label><input id="Note" name="Note" type="text" value="@Note" placeholder="Ví dụ: ứng để nhập hàng tiếp" /></div>
                </div>
            </details>
            <datalist id="banks">@foreach (var b in Suggestions.Banks) { <option value="@b"></option> }</datalist>
            <datalist id="payers">@foreach (var b in Suggestions.Payers) { <option value="@b"></option> }</datalist>
            <datalist id="receivers">@foreach (var b in Suggestions.Receivers) { <option value="@b"></option> }</datalist>
            <p class="toolbar"><button type="submit" class="big-btn">Ghi nhận</button></p>
            <p class="muted small">Mọi khoản trả đều trừ vào tổng nợ. Muốn trả riêng cho vài xe, tick xe ở bảng bên phải rồi bấm “Gom lô rồi trả luôn” hoặc “Trả riêng”.</p>
        </form>
    </div>
}
else
{
    <div class="alert warn">Mùa này đã chốt nên không trả thêm hoặc hủy khoản trả được.</div>
}

</aside>
<div class="content">
<h2>Các lô</h2>
<partial name="_PeriodCard" model="new PeriodCardModel(openPeriod, customer.Id, season.Id, open, false, Stations)" />
@foreach (var p in s.Closed.OrderByDescending(p => p.Number))
{
    <partial name="_PeriodCard" model="new PeriodCardModel(p, customer.Id, season.Id, open, open && lastClosed is not null && p.Id == lastClosed.Id && p.Payments.Count == 0, Stations)" />
}
</div>
</div>
