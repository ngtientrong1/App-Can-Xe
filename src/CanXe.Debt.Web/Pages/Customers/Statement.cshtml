@page "{id:int}"
@inject SeasonService Seasons
@inject LedgerService Ledger
@inject SettlementService Settlements
@inject CustomerService Customers
@functions {
    [BindProperty(SupportsGet = true)] public int Id { get; set; }
    [BindProperty(SupportsGet = true)] public int? SeasonId { get; set; }
    [BindProperty(SupportsGet = true)] public string? From { get; set; }
    [BindProperty(SupportsGet = true)] public string? To { get; set; }

    public Customer? Customer { get; set; }
    public Season? Season { get; set; }
    public CustomerSettlement? Settlement { get; set; }
    public Dictionary<string, string> Stations { get; set; } = [];
    public DateOnly FromDate { get; set; }
    public DateOnly ToDate { get; set; }
    public string? RangeError { get; set; }

    public async Task<IActionResult> OnGetAsync()
    {
        Season = SeasonId is { } sid ? await Seasons.GetAsync(sid) : await Seasons.GetCurrentAsync();
        Customer = await Customers.GetAsync(Id);
        if (Season is null || Customer is null)
            return NotFound();

        Settlement = await Settlements.GetAsync(Id, Season);
        Stations = await Ledger.GetStationNamesAsync();

        var today = DateOnly.FromDateTime(System.DateTime.Today);
        var seasonEnd = Season.EndDate is { } e && e < today ? e : today;
        FromDate = Fmt.TryParseDate(From, out var f) ? f : Season.StartDate;
        ToDate = Fmt.TryParseDate(To, out var t) ? t : seasonEnd;
        if (ToDate < FromDate)
        {
            RangeError = "Ngày kết thúc nhỏ hơn ngày bắt đầu nên tôi đã đổi chỗ hai ngày cho bạn.";
            (FromDate, ToDate) = (ToDate, FromDate);
        }

        return Page();
    }

    public sealed record PayLine(Payment Payment, string Label);
}
@{
    var customer = Customer!;
    var season = Season!;
    var s = Settlement!;
    var from = FromDate;
    var to = ToDate;
    ViewData["Title"] = "Báo cáo công nợ " + customer.Name;

    bool InRange(DateOnly d) => d >= from && d <= to;

    // Everything below is cut to the chosen days. The opening debt is what was owed the day before the first day.
    var allTickets = s.Periods.SelectMany(p => p.Tickets).ToList();
    var allPayments = s.Periods.SelectMany(p => p.Payments.Select(pay => new PayLine(pay, p.IsOpen ? "Ứng trước (chưa gom lô)" : "Trả " + Fmt.LotLabel(p).ToLowerInvariant()))).ToList();
    var allExtras = s.Periods.SelectMany(p => p.Extras).ToList();
    var extraLines = allExtras.Where(x => InRange(x.Date)).OrderBy(x => x.Date).ThenBy(x => x.Id).ToList();
    var extrasInRange = extraLines.Sum(x => x.AmountVnd);
    var opening = allTickets.Where(t => t.Stage == TicketStage.Priced && t.TicketDate < from).Sum(t => t.AmountVnd ?? 0)
        + allExtras.Where(x => x.Date < from).Sum(x => x.AmountVnd)
        - allPayments.Where(l => l.Payment.PaidOn < from).Sum(l => l.Payment.AmountVnd);
    var billedInRange = allTickets.Where(t => t.Stage == TicketStage.Priced && InRange(t.TicketDate)).Sum(t => t.AmountVnd ?? 0);
    var billedKgInRange = allTickets.Where(t => t.Stage == TicketStage.Priced && InRange(t.TicketDate)).Sum(t => t.BillableWeightKg ?? 0);
    var payLines = allPayments.Where(l => InRange(l.Payment.PaidOn)).OrderBy(l => l.Payment.PaidOn).ThenBy(l => l.Payment.CreatedAt).ToList();
    var paidInRange = payLines.Sum(l => l.Payment.AmountVnd);
    var closing = opening + billedInRange + extrasInRange - paidInRange;

    var groups = s.Periods
        .Select(p => new { Period = p, Tickets = p.Tickets.Where(t => InRange(t.TicketDate)).ToList(), Paid = p.Payments.Where(pay => InRange(pay.PaidOn)).Sum(pay => pay.AmountVnd) })
        .Where(g => g.Tickets.Count > 0 || g.Paid > 0)
        // Oldest day first; trucks not yet gathered into a lot come last.
        .OrderBy(g => g.Period.IsOpen ? 1 : 0)
        .ThenBy(g => g.Tickets.Count > 0
            ? g.Tickets.Min(t => t.TicketDateTime)
            : new DateTimeOffset(g.Period.Payments.Where(pay => InRange(pay.PaidOn)).Min(pay => pay.PaidOn).ToDateTime(TimeOnly.MinValue)))
        .ThenBy(g => g.Period.Id)
        .ToList();
    var sideBySide = payLines.Count <= 12 && groups.Count <= 8;
    var rangeText = $"từ {Fmt.Date(from)} đến {Fmt.Date(to)}";

    var today = DateOnly.FromDateTime(System.DateTime.Today);
    var monthStart = new DateOnly(today.Year, today.Month, 1);
    var seasonEnd = season.EndDate is { } se && se < today ? se : today;
}
<div class="page-head no-print">
    <h1>Báo cáo công nợ · @customer.Name</h1>
    <div class="toolbar">
        <button type="button" data-print="all">In 2 tờ</button>
        <button type="button" class="secondary" data-print="1">Chỉ in tờ 1</button>
        <button type="button" class="secondary" data-print="2">Chỉ in tờ 2</button>
        <a class="btn secondary" asp-page="/Customers/Detail" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id">← Quay lại</a>
    </div>
</div>

<div class="card no-print preview-bar" data-image-name="@($"cong-no {customer.Name} {Fmt.Date(from)} {Fmt.Date(to)}")">
    <div class="preview-row">
        <span class="lbl">Xem trước</span>
        <button type="button" class="chip on" data-view="all">Cả 2 tờ</button>
        <button type="button" class="chip" data-view="1">Tờ 1</button>
        <button type="button" class="chip" data-view="2">Tờ 2</button>
    </div>
    <div class="preview-row">
        <span class="lbl">Ảnh để gửi</span>
        <span class="grp">Tờ 1 <button type="button" class="secondary" data-image="1" data-mode="save">Lưu ảnh</button> <button type="button" class="secondary" data-image="1" data-mode="copy" hidden>Sao chép</button></span>
        <span class="grp">Tờ 2 <button type="button" class="secondary" data-image="2" data-mode="save">Lưu ảnh</button> <button type="button" class="secondary" data-image="2" data-mode="copy" hidden>Sao chép</button></span>
        <span class="muted" data-image-status role="status"></span>
    </div>
</div>

<div class="card no-print">
    <form method="get" class="form-grid range-form">
        <input type="hidden" name="SeasonId" value="@season.Id" />
        <div class="field"><label for="From">Từ ngày</label><input id="From" name="From" type="text" inputmode="numeric" data-date maxlength="10" placeholder="dd/MM/yyyy" autocomplete="off" value="@Fmt.Date(from)" /></div>
        <div class="field"><label for="To">Đến ngày</label><input id="To" name="To" type="text" inputmode="numeric" data-date maxlength="10" placeholder="dd/MM/yyyy" autocomplete="off" value="@Fmt.Date(to)" /></div>
        <div><button type="submit">Xem</button></div>
        <div class="quick">
            <a class="chip" asp-route-SeasonId="@season.Id" asp-route-From="@Fmt.Date(today.AddDays(-6))" asp-route-To="@Fmt.Date(today)">7 ngày gần đây</a>
            <a class="chip" asp-route-SeasonId="@season.Id" asp-route-From="@Fmt.Date(monthStart)" asp-route-To="@Fmt.Date(today)">Tháng này</a>
            <a class="chip" asp-route-SeasonId="@season.Id" asp-route-From="@Fmt.Date(season.StartDate)" asp-route-To="@Fmt.Date(seasonEnd)">Cả mùa</a>
        </div>
    </form>
    @if (RangeError is not null) { <div class="alert warn">@RangeError</div> }
</div>

<section class="sheet sheet-1">
    <header class="sheet-head">
        <div class="doc">BẢNG KÊ PHIẾU CÂN KÈM GIÁ</div><div class="sub">@season.Name · @rangeText</div>
    </header>
    <div class="who">Chủ hàng: <strong>@customer.Name</strong></div>
    <table class="sheet-table">
        <thead>
        <tr>
            <th>Ngày giờ</th><th>Số phiếu</th><th>Điểm cân</th><th>Biển số</th>
            <th class="num">Tổng</th><th class="num">Bì</th><th class="num">Hàng</th><th class="num">KL tính tiền</th>
            <th class="num">Đơn giá</th><th class="num">Thành tiền</th>
        </tr>
        </thead>
        @foreach (var g in groups.Where(g => g.Tickets.Count > 0))
        {
            var priced = g.Tickets.Where(t => t.Stage == TicketStage.Priced).ToList();
            <tbody>
            <tr class="group"><td colspan="10">@(g.Period.IsOpen ? "Xe chưa gom lô" : Fmt.LotLabel(g.Period)) · @g.Tickets.Count xe</td></tr>
            @foreach (var t in g.Tickets)
            {
                <tr>
                    <td class="nowrap">@Fmt.DateTime(t.TicketDateTime)</td>
                    <td class="nowrap">@t.DisplayNumber</td>
                    <td>@Stations.GetValueOrDefault(t.StationCode, t.StationCode)</td>
                    <td class="nowrap">@t.LicensePlate</td>
                    @if (t.Stage == TicketStage.AwaitingSecondWeigh)
                    {
                        <td colspan="6">Chờ cân lần 2 (cân lần 1: @Fmt.Kg(t.FirstWeightKg) kg) · chưa tính tiền</td>
                    }
                    else
                    {
                        <td class="num">@Fmt.Kg(t.GrossWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.TareWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.NetWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.BillableWeightKg)</td>
                        <td class="num">@Fmt.UnitPrice(t)</td>
                        <td class="num">@(t.Stage == TicketStage.Priced ? Fmt.Vnd(t.AmountVnd) : "Chưa có giá")</td>
                    }
                </tr>
                @if (t.IsAdjusted)
                {
                    <tr class="note"><td></td><td colspan="9">Tính tiền theo @Fmt.Kg(t.NetWeightKg) kg (cân nhà @Fmt.Kg(t.OriginalNetKg) kg)@(string.IsNullOrWhiteSpace(t.AdjustReason) ? "" : " · " + t.AdjustReason)</td></tr>
                }
                @if (!string.IsNullOrWhiteSpace(t.Notes))
                {
                    <tr class="note"><td></td><td colspan="9">Ghi chú: @t.Notes</td></tr>
                }
            }
            <tr class="subtotal">
                <td colspan="6">Cộng @(g.Period.IsOpen ? "xe chưa gom lô" : Fmt.LotLabel(g.Period).ToLowerInvariant()) (@priced.Count xe tính tiền)</td>
                <td class="num">@Fmt.Kg(priced.Sum(t => t.NetWeightKg ?? 0))</td>
                <td class="num">@Fmt.Kg(priced.Sum(t => t.BillableWeightKg ?? 0))</td>
                <td></td>
                <td class="num">@Fmt.Vnd(priced.Sum(t => t.AmountVnd ?? 0))</td>
            </tr>
            </tbody>
        }
        @if (groups.All(g => g.Tickets.Count == 0))
        {
            <tbody><tr><td colspan="10" class="empty">Không có phiếu cân trong khoảng ngày này.</td></tr></tbody>
        }
        <tfoot>
        <tr class="grand">
            <td colspan="6">TỔNG CỘNG</td>
            <td class="num">@Fmt.Kg(allTickets.Where(t => t.Stage == TicketStage.Priced && InRange(t.TicketDate)).Sum(t => t.NetWeightKg ?? 0))</td>
            <td class="num">@Fmt.Kg(billedKgInRange)</td>
            <td></td>
            <td class="num">@Fmt.Vnd(billedInRange)</td>
        </tr>
        </tfoot>
    </table>
    <div class="printed">In ngày @Fmt.DateTime(DateTimeOffset.Now)</div>
</section>

<section class="sheet sheet-2">
    <header class="sheet-head">
        <div class="doc">BẢNG KÊ CÔNG NỢ THANH TOÁN</div><div class="sub">@season.Name · @rangeText</div>
    </header>
    <div class="who">Chủ hàng: <strong>@customer.Name</strong></div>

    <div class="boxes @(extraLines.Count > 0 ? "five" : "")">
        <div class="box"><div class="lbl">@(opening < 0 ? "Đã ứng trước từ trước" : "Nợ đầu kỳ")</div><div class="val">@Fmt.Vnd(Math.Abs(opening))</div></div>
        <div class="box"><div class="lbl">Tiền hàng trong kỳ (@Fmt.Kg(billedKgInRange) kg)</div><div class="val">@Fmt.Vnd(billedInRange)</div></div>
        @if (extraLines.Count > 0)
        {
            <div class="box"><div class="lbl">Phụ phí trong kỳ</div><div class="val">@(extrasInRange < 0 ? "−" : "")@Fmt.Vnd(Math.Abs(extrasInRange))</div></div>
        }
        <div class="box"><div class="lbl">Đã trả trong kỳ</div><div class="val">@Fmt.Vnd(paidInRange)</div></div>
        <div class="box total"><div class="lbl">@(closing < 0 ? "ĐÃ ỨNG TRƯỚC" : "CÒN NỢ") đến @Fmt.Date(to)</div><div class="val">@Fmt.Vnd(Math.Abs(closing))</div></div>
    </div>

    <div class="@(sideBySide ? "two-col" : "one-col")">
        <div>
            <div class="part">Các lô</div>
            <table class="sheet-table">
                <thead>
                <tr><th>Lô</th><th>Số phiếu</th><th class="num">Số xe</th><th class="num">Tiền hàng</th><th class="num">Đã trả</th></tr>
                </thead>
                <tbody>
                @foreach (var g in groups)
                {
                    var billed = g.Tickets.Where(t => t.Stage == TicketStage.Priced).Sum(t => t.AmountVnd ?? 0);
                    var waiting = g.Tickets.Count(t => t.Stage != TicketStage.Priced);
                    <tr>
                        <td class="nowrap">@Fmt.LotLabel(g.Period)</td>
                        <td>@Html.Raw(string.Join("<br />", g.Tickets.GroupBy(t => t.StationCode).Select(sg => System.Net.WebUtility.HtmlEncode(Stations.GetValueOrDefault(sg.Key, sg.Key)) + " " + (sg.Count() == 1 ? System.Net.WebUtility.HtmlEncode(sg.First().DisplayNumber) : System.Net.WebUtility.HtmlEncode(sg.First().DisplayNumber) + " → " + System.Net.WebUtility.HtmlEncode(sg.Last().DisplayNumber)))))</td>
                        <td class="num">@g.Tickets.Count@(waiting > 0 ? $" ({waiting} chờ)" : "")</td>
                        <td class="num">@Fmt.Vnd(billed)</td>
                        <td class="num">@Fmt.Vnd(g.Paid)</td>
                    </tr>
                }
                @if (groups.Count == 0)
                {
                    <tr><td colspan="5" class="empty">Không có phiếu hay khoản trả trong khoảng ngày này.</td></tr>
                }
                </tbody>
                <tfoot>
                <tr class="grand"><td colspan="2">CỘNG</td><td class="num">@groups.Sum(g => g.Tickets.Count)</td><td class="num">@Fmt.Vnd(billedInRange)</td><td class="num">@Fmt.Vnd(paidInRange)</td></tr>
                </tfoot>
            </table>
            @if (extraLines.Count > 0)
            {
                <div class="part">Phụ phí phát sinh</div>
                <table class="sheet-table">
                    <thead>
                    <tr><th>Ngày</th><th>Khoản</th><th>Thuộc</th><th class="num">Số tiền</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var x in extraLines)
                    {
                        var lot = s.Periods.First(p => p.Extras.Contains(x));
                        <tr>
                            <td class="nowrap">@x.Date.ToString("dd/MM", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@x.Label@(string.IsNullOrWhiteSpace(x.Note) ? "" : " · " + x.Note)</td>
                            <td class="nowrap">@Fmt.LotLabel(lot)</td>
                            <td class="num">@(x.AmountVnd < 0 ? "−" : "")@Fmt.Vnd(Math.Abs(x.AmountVnd))</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr class="grand"><td colspan="3">CỘNG PHỤ PHÍ</td><td class="num">@(extrasInRange < 0 ? "−" : "")@Fmt.Vnd(Math.Abs(extrasInRange))</td></tr>
                    </tfoot>
                </table>
            }
        </div>
        <div>
            <div class="part">Các lần thanh toán</div>
            <table class="sheet-table">
                <thead>
                <tr><th>Ngày</th><th>Nội dung</th><th>Hình thức</th><th class="num">Số tiền</th></tr>
                </thead>
                <tbody>
                @foreach (var l in payLines)
                {
                    var pay = l.Payment;
                    var who = string.Join(" · ", new[]
                    {
                        string.IsNullOrWhiteSpace(pay.PaidBy) ? null : $"{pay.PaidBy} chi",
                        string.IsNullOrWhiteSpace(pay.ReceivedBy) ? null : $"{pay.ReceivedBy} nhận",
                        string.IsNullOrWhiteSpace(pay.Note) ? null : pay.Note
                    }.Where(x => x is not null));
                    <tr>
                        <td class="nowrap">@pay.PaidOn.ToString("dd/MM", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@l.Label@(who.Length > 0 ? $" · {who}" : "")</td>
                        <td>@Fmt.Method(pay.Method)@(string.IsNullOrWhiteSpace(pay.BankName) ? "" : $" · {pay.BankName}")</td>
                        <td class="num">@Fmt.Vnd(pay.AmountVnd)</td>
                    </tr>
                }
                @if (payLines.Count == 0)
                {
                    <tr><td colspan="4" class="empty">Chưa có khoản trả trong khoảng ngày này.</td></tr>
                }
                </tbody>
                <tfoot>
                <tr class="grand"><td colspan="3">CỘNG ĐÃ TRẢ</td><td class="num">@Fmt.Vnd(paidInRange)</td></tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="printed">Còn nợ = nợ đầu kỳ + tiền hàng@(extraLines.Count > 0 ? " + phụ phí" : "") trong kỳ − đã trả trong kỳ · In ngày @Fmt.DateTime(DateTimeOffset.Now)</div>
</section>
<script src="~/lib/html2canvas.min.js"></script>
