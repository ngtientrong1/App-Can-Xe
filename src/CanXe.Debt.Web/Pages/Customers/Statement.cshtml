@page "{id:int}"
@inject SeasonService Seasons
@inject LedgerService Ledger
@inject SettlementService Settlements
@inject CustomerService Customers
@functions {
    [BindProperty(SupportsGet = true)] public int Id { get; set; }
    [BindProperty(SupportsGet = true)] public int? SeasonId { get; set; }
    public Customer? Customer { get; set; }
    public Season? Season { get; set; }
    public CustomerSettlement? Settlement { get; set; }
    public Dictionary<string, string> Stations { get; set; } = [];

    public async Task<IActionResult> OnGetAsync()
    {
        Season = SeasonId is { } sid ? await Seasons.GetAsync(sid) : await Seasons.GetCurrentAsync();
        Customer = await Customers.GetAsync(Id);
        if (Season is null || Customer is null)
            return NotFound();
        Settlement = await Settlements.GetAsync(Id, Season);
        Stations = await Ledger.GetStationNamesAsync();
        return Page();
    }
}
@{
    var customer = Customer!;
    var season = Season!;
    var s = Settlement!;
    ViewData["Title"] = "Bảng kê công nợ " + customer.Name;
}
<div class="page-head no-print">
    <h1>Bảng kê công nợ</h1>
    <div class="toolbar">
        <button type="button" data-print>In bảng kê</button>
        <a class="btn secondary" asp-page="/Customers/Detail" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id">← Quay lại</a>
    </div>
</div>

<div class="statement-head">
    <h1>BẢNG KÊ CÔNG NỢ</h1>
</div>
<div class="card">
    <h2>@customer.Name</h2>
    <div>@season.Name · từ @Fmt.Date(season.StartDate) @(season.EndDate is { } e ? $"đến {Fmt.Date(e)}" : "đến " + Fmt.Date(DateOnly.FromDateTime(DateTime.Today)))</div>
    @if (customer.Phone is not null) { <div>Điện thoại: @customer.Phone</div> }
</div>

<div class="stats">
    <div class="stat"><div class="label">Tổng tiền hàng (@Fmt.Kg(s.Periods.Sum(p => p.BillableKg)) kg tính tiền)</div><div class="value">@Fmt.Vnd(s.TotalBilled)</div></div>
    <div class="stat"><div class="label">Đã trả</div><div class="value">@Fmt.Vnd(s.TotalPaid)</div></div>
    <div class="stat debt"><div class="label">@(s.Balance >= 0 ? "CÒN NỢ" : "ĐÃ ỨNG TRƯỚC")</div><div class="value">@Fmt.Vnd(Math.Abs(s.Balance))</div></div>
</div>

@foreach (var p in s.Periods)
{
    <div class="card">
        <h2>@(p.IsOpen ? $"Kỳ chưa chốt · {Fmt.Range(p.From, null)}" : $"Kỳ {Fmt.Range(p.From, p.To)}")</h2>
        <table>
            <thead>
            <tr>
                <th>Ngày giờ</th><th>Số phiếu</th><th>Điểm cân</th><th>Biển số</th><th>Loại hàng</th>
                <th class="num">Tổng</th><th class="num">Bì</th><th class="num">Hàng</th><th class="num">KL tính tiền</th>
                <th class="num">Đơn giá</th><th class="num">Thành tiền</th><th>Ghi chú</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var t in p.Tickets)
            {
                <tr>
                    <td class="nowrap">@Fmt.DateTime(t.TicketDateTime)</td>
                    <td>@t.DisplayNumber</td>
                    <td>@Stations.GetValueOrDefault(t.StationCode, t.StationCode)</td>
                    <td class="nowrap">@t.LicensePlate</td>
                    <td>@t.Cargo</td>
                    @if (t.Stage == TicketStage.AwaitingSecondWeigh)
                    {
                        <td class="num" colspan="3">Chờ cân lần 2 (cân lần 1: @Fmt.Kg(t.FirstWeightKg))</td>
                    }
                    else
                    {
                        <td class="num">@Fmt.Kg(t.GrossWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.TareWeightKg)</td>
                        <td class="num">@Fmt.Kg(t.NetWeightKg)</td>
                    }
                    <td class="num">@Fmt.Kg(t.BillableWeightKg)</td>
                    <td class="num">@Fmt.UnitPrice(t)</td>
                    <td class="num">@(t.Stage == TicketStage.Priced ? Fmt.Vnd(t.AmountVnd) : "Chưa có giá")</td>
                    <td>@t.Notes</td>
                </tr>
            }
            </tbody>
            <tfoot>
            <tr>
                <th colspan="7" class="right">Tổng @p.PricedCount xe đã tính tiền</th>
                <th class="num">@Fmt.Kg(p.NetKg)</th>
                <th class="num">@Fmt.Kg(p.BillableKg)</th>
                <th></th>
                <th class="num">@Fmt.Vnd(p.TicketsTotal)</th>
                <th></th>
            </tr>
            </tfoot>
        </table>

        <table class="ledger">
            <tbody>
            <tr><td>Nợ từ kỳ trước</td><td class="num">@Fmt.Balance(p.CarryIn)</td></tr>
            <tr><td>Tiền hàng kỳ này</td><td class="num">@Fmt.Vnd(p.TicketsTotal)</td></tr>
            <tr><th>Tổng phải trả</th><th class="num">@Fmt.Balance(p.Payable)</th></tr>
            @foreach (var pay in p.Payments)
            {
                <tr class="payment-row">
                    <td>
                        @Fmt.Date(pay.PaidOn) · @(p.IsOpen ? "Ứng trước · " : "")@(pay.Method == PaymentMethod.Cash ? "Tiền mặt" : pay.Method == PaymentMethod.Offset ? (string.IsNullOrWhiteSpace(pay.BankName) ? "Bù trừ công nợ" : $"Bù trừ ({pay.BankName})") : string.IsNullOrWhiteSpace(pay.BankName) ? "Chuyển khoản" : $"Chuyển khoản ({pay.BankName})")
                        @(string.IsNullOrWhiteSpace(pay.PaidBy) ? "" : $" · {pay.PaidBy} chi")
                        @(string.IsNullOrWhiteSpace(pay.ReceivedBy) ? "" : $" · {pay.ReceivedBy} nhận")
                        @(string.IsNullOrWhiteSpace(pay.Note) ? "" : $" · {pay.Note}")
                    </td>
                    <td class="num credit">− @Fmt.Vnd(pay.AmountVnd)</td>
                </tr>
            }
            <tr><th>@(p.IsOpen ? "Tạm tính còn nợ" : p.Remaining < 0 ? "Đã ứng trước" : p.Remaining == 0 ? "Đã tất toán" : "Còn nợ, chuyển sang kỳ sau")</th><th class="num">@Fmt.Balance(p.Remaining)</th></tr>
            </tbody>
        </table>
    </div>
}
<p class="muted">In ngày @Fmt.DateTime(DateTimeOffset.Now)</p>
