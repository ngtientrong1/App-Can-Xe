@page "{id:int}"
@inject SeasonService Seasons
@inject LedgerService Ledger
@functions {
    [BindProperty(SupportsGet = true)] public int Id { get; set; }
    [BindProperty(SupportsGet = true)] public int? SeasonId { get; set; }
    public CustomerLedgerView? View { get; set; }
    public Dictionary<string, string> Stations { get; set; } = [];

    public async Task<IActionResult> OnGetAsync()
    {
        var season = SeasonId is { } sid ? await Seasons.GetAsync(sid) : await Seasons.GetCurrentAsync();
        if (season is null)
            return NotFound();
        View = await Ledger.GetCustomerAsync(Id, season);
        Stations = await Ledger.GetStationNamesAsync();
        return View is null ? NotFound() : Page();
    }
}
@{
    var customer = View!.Customer;
    var ledger = View.Ledger;
    var season = View.Season;
    ViewData["Title"] = "Bảng kê công nợ " + customer.Name;
}
<div class="page-head no-print">
    <h1>Bảng kê công nợ</h1>
    <div class="toolbar">
        <button type="button" data-print>In bảng kê</button>
        <a class="btn secondary" asp-page="/Customers/Detail" asp-route-id="@customer.Id" asp-route-SeasonId="@season.Id">← Quay lại</a>
    </div>
</div>

<div class="statement-head">
    <h1>BẢNG KÊ CÔNG NỢ</h1>
</div>
<div class="card">
    <h2>@customer.Name</h2>
    <div>@season.Name · từ @Fmt.Date(season.StartDate) @(season.EndDate is { } e ? $"đến {Fmt.Date(e)}" : "đến " + Fmt.Date(DateOnly.FromDateTime(DateTime.Today)))</div>
    @if (customer.Phone is not null) { <div>Điện thoại: @customer.Phone</div> }
</div>

<div class="stats">
    <div class="stat"><div class="label">Tổng phải trả (@Fmt.Kg(View.TotalBillableKg) kg tính tiền)</div><div class="value">@Fmt.Vnd(ledger.Billed)</div></div>
    <div class="stat"><div class="label">Đã trả</div><div class="value">@Fmt.Vnd(ledger.Paid)</div></div>
    <div class="stat debt"><div class="label">@(ledger.Balance >= 0 ? "CÒN NỢ" : "ĐÃ ỨNG TRƯỚC")</div><div class="value">@Fmt.Vnd(Math.Abs(ledger.Balance))</div></div>
</div>

<div class="card">
    <h2>Sổ công nợ</h2>
    <table class="ledger">
        <thead><tr><th>Ngày</th><th>Nội dung</th><th class="num">Phải trả</th><th class="num">Đã trả</th><th class="num">Còn nợ</th></tr></thead>
        <tbody>
        @foreach (var line in View.Statement)
        {
            <tr class="@(line.Kind == StatementLineKind.Payment ? "payment-row" : "")">
                <td class="nowrap">@Fmt.Date(line.Date)</td>
                <td>@line.Description@(line.Kind == StatementLineKind.Tickets ? $" · {Fmt.Kg(line.TotalBillableKg)} kg" : "")</td>
                <td class="num">@(line.Debit > 0 ? Fmt.Vnd(line.Debit) : "")</td>
                <td class="num credit">@(line.Credit > 0 ? Fmt.Vnd(line.Credit) : "")</td>
                <td class="num">@Fmt.Balance(line.Balance)</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="2" class="right">Tổng</th><th class="num">@Fmt.Vnd(ledger.Billed)</th><th class="num">@Fmt.Vnd(ledger.Paid)</th><th class="num">@Fmt.Balance(ledger.Balance)</th></tr></tfoot>
    </table>
</div>

<div class="card">
    <h2>Chi tiết các xe</h2>
    <table>
        <thead>
        <tr>
            <th>Ngày giờ</th><th>Số phiếu</th><th>Điểm cân</th><th>Biển số</th><th>Loại hàng</th>
            <th class="num">Tổng</th><th class="num">Bì</th><th class="num">Hàng</th><th class="num">KL tính tiền</th>
            <th class="num">Đơn giá</th><th class="num">Thành tiền</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in View.Tickets)
        {
            var t = row.Ticket;
            <tr>
                <td class="nowrap">@Fmt.DateTime(t.TicketDateTime)</td>
                <td>@t.DisplayNumber</td>
                <td>@Stations.GetValueOrDefault(t.StationCode, t.StationCode)</td>
                <td class="nowrap">@t.LicensePlate</td>
                <td>@t.Cargo</td>
                <td class="num">@Fmt.Kg(t.GrossWeightKg)</td>
                <td class="num">@Fmt.Kg(t.TareWeightKg)</td>
                <td class="num">@Fmt.Kg(t.NetWeightKg)</td>
                <td class="num">@Fmt.Kg(t.BillableWeightKg)</td>
                <td class="num">@Fmt.UnitPrice(t)</td>
                <td class="num">@(t.AmountVnd is null ? "Chưa có giá" : Fmt.Vnd(t.AmountVnd))</td>
            </tr>
        }
        </tbody>
        <tfoot>
        <tr>
            <th colspan="7" class="right">Tổng @View.Tickets.Count xe</th>
            <th class="num">@Fmt.Kg(View.TotalNetKg)</th>
            <th class="num">@Fmt.Kg(View.TotalBillableKg)</th>
            <th></th>
            <th class="num">@Fmt.Vnd(ledger.Billed)</th>
        </tr>
        </tfoot>
    </table>
</div>
<p class="muted">In ngày @Fmt.DateTime(DateTimeOffset.Now)</p>
