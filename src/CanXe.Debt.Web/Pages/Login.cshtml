@page
@attribute [AllowAnonymous]
@inject UserService Users
@inject SettingsService Settings
@inject LoginThrottle Throttle
@functions {
    [BindProperty] public string Username { get; set; } = "";
    [BindProperty] public string Password { get; set; } = "";
    [BindProperty(SupportsGet = true)] public string? ReturnUrl { get; set; }
    public string? Error { get; set; }

    public async Task<IActionResult> OnGetAsync()
    {
        if (!await Users.AnyUserAsync())
            return RedirectToPage("/Setup");
        if (User.Identity?.IsAuthenticated == true)
            return RedirectToPage("/Index");
        return Page();
    }

    public async Task<IActionResult> OnPostAsync()
    {
        var name = (Username ?? "").Trim();
        var address = Security.ClientAddress(HttpContext);
        if (Throttle.IsLocked(name, address))
        {
            Error = "Nhập sai nhiều lần. Vui lòng thử lại sau 10–15 phút.";
            return Page();
        }

        var user = await Users.AuthenticateAsync(name, Password ?? "");
        if (user is null)
        {
            Throttle.RegisterFailure(name, address);
            Error = "Tên đăng nhập hoặc mật khẩu không đúng.";
            return Page();
        }

        // Password right but a code from the phone is still needed: the counter is only cleared once that passes too.
        if (user.TotpEnabled)
        {
            Security.SetPending(HttpContext, user.Id);
            return RedirectToPage("/Login2fa", new { ReturnUrl });
        }

        Throttle.Reset(name, address);
        await Security.SignInAsync(HttpContext, user, needsTwoStepSetup: await Settings.GetRequire2faAsync());
        return Url.IsLocalUrl(ReturnUrl) ? LocalRedirect(ReturnUrl!) : RedirectToPage("/Index");
    }
}
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="login-wrap">
    <div class="card">
        <h1>Công nợ cà</h1>
        <p class="muted">Đăng nhập để xem và ghi nhận công nợ chủ hàng.</p>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        <form method="post">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <div class="field">
                <label for="Username">Tên đăng nhập</label>
                <input id="Username" name="Username" type="text" value="@Username" autocomplete="username" autofocus required />
            </div>
            <div class="field">
                <label for="Password">Mật khẩu</label>
                <input id="Password" name="Password" type="password" autocomplete="current-password" required />
            </div>
            <p><button type="submit" class="big-btn">Đăng nhập</button></p>
        </form>
    </div>
</div>
