<Window x:Class="CanXe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:CanXe.Desktop.Converters"
        xmlns:ctrl="clr-namespace:CanXe.Desktop.Controls"
        xmlns:models="clr-namespace:CanXe.Application.Models;assembly=CanXe.Application"
        xmlns:reports="clr-namespace:CanXe.Desktop.Views.Reports"
        xmlns:catalogs="clr-namespace:CanXe.Desktop.Views.Catalogs"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Cân Xe Tiến Trọng"
        MinWidth="1280"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:RowHighlightConverter x:Key="RowHighlight"/>
        <conv:StringEqualsConverter x:Key="StringEq"/>

        <Style x:Key="NavTabActiveTrigger" TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavSystemActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterTabStyle" TargetType="Button" BasedOn="{StaticResource CanXeFilterTabStyle}">
            <Setter Property="Tag" Value=""/>
        </Style>

        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="TicketGridRow" TargetType="DataGridRow" BasedOn="{StaticResource CanXeDataGridRowStyle}">
            <Setter Property="MinHeight" Value="42"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RowHighlight}">
                            <Binding Path="Id"/>
                            <Binding Path="DataContext.HighlightedTicketId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CanXeCompactSummaryCardStyle" TargetType="Border" BasedOn="{StaticResource CanXeSummaryCardStyle}">
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App header -->
        <Border Grid.Row="0" Style="{StaticResource CanXeCardStyle}" Padding="14,12" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBlueBrush}" Margin="0,0,12,0">
                        <TextBlock Text="⚖" Foreground="White" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Cân Xe Tiến Trọng" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding HeaderClockText}" FontSize="16" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border Grid.Row="1" Style="{StaticResource CanXeCardStyle}" Padding="6,4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="HỆ THỐNG" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.System}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavSystemActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="PHIẾU CÂN" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.WeighTicket}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavWeighTicketActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="DANH MỤC" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Catalog}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCatalogActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="THIẾT BỊ" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Device}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavDeviceActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="BÁO CÁO" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Report}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavReportActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="CÀI ĐẶT" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Settings}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavSettingsActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="ADMIN" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Developer}"
                        Visibility="{Binding IsDeveloperPanelAvailable, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavDeveloperActive}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Section: PHIẾU CÂN -->
        <Grid Grid.Row="2" Visibility="{Binding IsWeighTicketSectionVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6"
                  MinHeight="{Binding WorkspaceMinHeight}"
                  MaxHeight="{Binding WorkspaceMaxHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding WeighColumnWidth}" MinWidth="300"/>
                <ColumnDefinition Width="{Binding InfoColumnWidth}" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: live weight -->
            <Border Grid.Column="0" Style="{StaticResource CanXeCardStyle}" Margin="0,0,8,0" Padding="14,10"
                    Background="{DynamicResource PanelBrush}" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: live weight + status -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="TRỌNG LƯỢNG TRỰC TIẾP" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                            <TextBlock Text="{Binding LiveWeightDisplayText}"
                                       FontSize="{Binding LiveWeightFontSize}" FontWeight="Bold"
                                       Foreground="{DynamicResource WeightStableBrush}"/>
                            <TextBlock Text=" kg" FontSize="{Binding LiveWeightUnitFontSize}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,12"
                                       Visibility="{Binding ShowLiveWeightUnit, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ScaleStabilityText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WeightStableBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding WeightSourceText}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding OperatorStatusMessage}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Content="THỬ KẾT NỐI LẠI" Command="{Binding RetryConnectHardwareCommand}"
                                Style="{StaticResource CanXeSecondaryButtonStyle}" MinHeight="44" FontSize="15"
                                Margin="0,0,0,8"
                                Visibility="{Binding IsRetryConnectVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Row 1: admin compact -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Mở khóa Admin" Command="{Binding UnlockAdminCommand}"
                                Style="{StaticResource CanXeSecondaryButtonStyle}" FontSize="11" MaxHeight="28" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="{Binding IsAdminUnlockButtonVisible, Converter={StaticResource BoolToVis}}"/>
                        <DockPanel LastChildFill="True" VerticalAlignment="Center"
                                   Visibility="{Binding IsAdminBadgeVisible, Converter={StaticResource BoolToVis}}">
                            <Border DockPanel.Dock="Left" Background="{DynamicResource AdminBadgeBackgroundBrush}" BorderBrush="{DynamicResource AdminBadgeBorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="ADMIN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AdminBadgeForegroundBrush}"/>
                            </Border>
                            <Button Content="Khóa" Command="{Binding LockAdminCommand}" DockPanel.Dock="Right"
                                    Style="{StaticResource CanXeSecondaryButtonStyle}" FontSize="11" MaxHeight="28" Padding="6,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AdminInlineWeightHint}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>

                    <!-- Row 2: weigh cards -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource WeighPanelBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,4,0"
                                Background="{DynamicResource WeighPanelBackgroundBrush}" CornerRadius="4">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="CÂN LẦN 1" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="✎" FontSize="14" Foreground="{DynamicResource IconAccentBrush}" Margin="6,0,0,0" DockPanel.Dock="Left"
                                               ToolTip="Admin: nhấp vào số cân để sửa"
                                               Visibility="{Binding IsInlineWeightEditEnabled, Converter={StaticResource BoolToVis}}"/>
                                </DockPanel>
                                <Grid Margin="0,2,0,0" MinHeight="28" Background="#00000000">
                                    <TextBlock Text="{Binding Weight1ValueText}"
                                               FontSize="{Binding WeighPanelValueFontSize}" FontWeight="SemiBold"
                                               Visibility="{Binding IsWeight1InlineEditing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                               MouseLeftButtonDown="Weight1Value_OnMouseLeftButtonDown">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInlineWeightEditEnabled}" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource IconAccentBrush}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsInlineWeightEditEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="Weight1InlineEditBox"
                                             Text="{Binding Weight1InlineEditText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{Binding WeighPanelValueFontSize}" FontWeight="SemiBold"
                                             Visibility="{Binding IsWeight1InlineEditing, Converter={StaticResource BoolToVis}}"
                                             KeyDown="Weight1InlineEdit_OnKeyDown"
                                             LostFocus="Weight1InlineEdit_OnLostFocus"
                                             Tag="1"/>
                                </Grid>
                                <TextBlock Text="{Binding Weight1TimeText}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="{Binding Weight1HasValue, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Weight1SourceDisplay}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding Weight1SourceDisplay, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource WeighPanelBorderBrush}" BorderThickness="1" Padding="6" Margin="4,0,0,0"
                                Background="{DynamicResource WeighPanelBackgroundBrush}" CornerRadius="4">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="CÂN LẦN 2" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="✎" FontSize="14" Foreground="{DynamicResource IconAccentBrush}" Margin="6,0,0,0" DockPanel.Dock="Left"
                                               ToolTip="Admin: nhấp vào số cân để sửa"
                                               Visibility="{Binding IsInlineWeightEditEnabled, Converter={StaticResource BoolToVis}}"/>
                                </DockPanel>
                                <Grid Margin="0,2,0,0" MinHeight="28" Background="#00000000">
                                    <TextBlock Text="{Binding Weight2ValueText}"
                                               FontSize="{Binding WeighPanelValueFontSize}" FontWeight="SemiBold"
                                               Visibility="{Binding IsWeight2InlineEditing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                               MouseLeftButtonDown="Weight2Value_OnMouseLeftButtonDown">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInlineWeightEditEnabled}" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource IconAccentBrush}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsInlineWeightEditEnabled}" Value="True"/>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="Weight2InlineEditBox"
                                             Text="{Binding Weight2InlineEditText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{Binding WeighPanelValueFontSize}" FontWeight="SemiBold"
                                             Visibility="{Binding IsWeight2InlineEditing, Converter={StaticResource BoolToVis}}"
                                             KeyDown="Weight2InlineEdit_OnKeyDown"
                                             LostFocus="Weight2InlineEdit_OnLostFocus"
                                             Tag="2"/>
                                </Grid>
                                <TextBlock Text="{Binding Weight2TimeText}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="{Binding Weight2HasValue, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Weight2SourceDisplay}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding Weight2SourceDisplay, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: spacer -->
                    <!-- Row 4: TỔNG / BÌ / HÀNG -->
                    <StackPanel Grid.Row="4">
                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="TỔNG" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding GrossDisplay}" FontSize="{Binding SummaryValueFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="BÌ" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding TareDisplay}" FontSize="{Binding SummaryValueFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="HÀNG" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}"/>
                                <TextBlock Text="{Binding NetDisplay}" FontSize="{Binding SummaryValueFontSize}" FontWeight="Bold" Foreground="{DynamicResource NetHighlightBrush}"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Cân dịch vụ — chưa nhập đơn giá" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,4,0,0"
                                   Visibility="{Binding IsServiceWeighVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Middle: ticket info -->
            <Border Grid.Column="1" Margin="0,0,8,0" Padding="12,8" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CanXeCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingExistingTicket}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WarningBannerBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBannerBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Top">
                    <Border Padding="8,6" Margin="0,0,0,8" CornerRadius="4"
                            Background="{DynamicResource InfoBannerBackgroundBrush}" BorderBrush="{DynamicResource InfoBannerBorderBrush}" BorderThickness="1"
                            Visibility="{Binding IsViewModeActionsVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ViewBannerTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InfoBannerForegroundBrush}"/>
                    </Border>
                    <Border Padding="8,6" Margin="0,0,0,8" CornerRadius="4"
                            Background="{DynamicResource EditBannerBackgroundBrush}" BorderBrush="{DynamicResource EditBannerBorderBrush}" BorderThickness="1"
                            Visibility="{Binding IsEditingExistingTicket, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EditBannerTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource EditBannerForegroundBrush}"/>
                            <TextBlock Text="Thay đổi chỉ được lưu sau khi bấm CẬP NHẬT PHIẾU" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="Số phiếu:" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DisplayNumber}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Số dự kiến" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="8,4,0,0"
                                       Visibility="{Binding IsPreviewDisplayNumber, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TicketDateTimeDisplay}" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Khách hàng" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <ctrl:AutoCompleteTextBox x:Name="CustomerField" TabIndex="1"
                                                      Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding CustomerSuggestions}" FontSize="18"
                                                      SuppressDropDown="{Binding SuppressAutocomplete}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Biển số xe" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <ctrl:AutoCompleteTextBox x:Name="VehicleField" TabIndex="2"
                                                      Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding VehicleSuggestions}" FontSize="18"
                                                      SuppressDropDown="{Binding SuppressAutocomplete}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Loại hàng" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <ctrl:AutoCompleteTextBox x:Name="CargoField" TabIndex="3"
                                                      Text="{Binding CargoTypeName, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding CargoTypeSuggestions}" FontSize="18"
                                                      SuppressDropDown="{Binding SuppressAutocomplete}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Đơn giá (VNĐ/kg)" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <TextBox x:Name="UnitPriceField" TabIndex="4" Style="{StaticResource CanXeTextBoxStyle}"
                                     MinHeight="{Binding FormFieldHeight}" FontSize="20"
                                     GotFocus="UnitPriceField_OnGotFocus" LostFocus="UnitPriceField_OnLostFocus"
                                     Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Trừ bì" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <TextBlock Text="{Binding DeductionDisplay, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Text="KL tính tiền" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <TextBlock Text="{Binding BillableDisplay, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Thành tiền" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <TextBlock Text="{Binding TotalAmountDisplay, Mode=OneWay}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBlueBrush}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Ghi chú" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                        <ctrl:AutoCompleteTextBox x:Name="NotesField" TabIndex="5"
                                                  MinHeight="{Binding NotesFieldHeight}"
                                                  Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding NotesSuggestions}" FontSize="18"
                                                  SuppressDropDown="{Binding SuppressAutocomplete}"/>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsEditingExistingTicket, Converter={StaticResource BoolToVis}}">
                        <Button Content="MỞ KHÓA SỬA TRỌNG LƯỢNG" Command="{Binding UnlockDevWeightEditCommand}"
                                TabIndex="-1" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDeveloperWeightUnlockVisible}" Value="True"/>
                                                <Condition Binding="{Binding IsDevWeightEditUnlocked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Visibility="{Binding IsDevWeightEditUnlocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ADMIN — Sửa trọng lượng thủ công" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Cân lần 1" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding DevWeight1Text, UpdateSourceTrigger=PropertyChanged}" FontSize="17"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Cân lần 2" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding DevWeight2Text, UpdateSourceTrigger=PropertyChanged}" FontSize="17"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Trọng lượng đã được chỉnh sửa thủ công. Ảnh thuộc giá trị cân ban đầu."
                                       Foreground="{DynamicResource WarningTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding IsManualWeightOverrideMessageVisible, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Visibility="{Binding IsWeightOverrideReasonPanelVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Lý do sửa trọng lượng" FontSize="14" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding WeightOverrideReasonOptions}"
                                          SelectedValuePath="Code" DisplayMemberPath="Label"
                                          SelectedValue="{Binding WeightOverrideReasonCode}" FontSize="15" Margin="0,2,0,4"/>
                                <TextBox Text="{Binding WeightOverrideReasonOther, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15" Margin="0,0,0,4"
                                         Visibility="{Binding WeightOverrideReasonCode, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Operator status bar -->
        <Border Grid.Row="1" Background="{DynamicResource FooterBarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,4" Margin="0,0,0,4" MinHeight="36" MaxHeight="40">
            <TextBlock Text="{Binding OperatorBarText}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Border>

        <!-- Action buttons -->
        <UniformGrid Grid.Row="2" Columns="6" Margin="0,2" MinHeight="48" MaxHeight="54"
                     Visibility="{Binding IsCreateModeActionsVisible, Converter={StaticResource BoolToVis}}">
            <Button x:Name="Weigh1Button" TabIndex="6" Content="{Binding Weigh1ButtonText}" Style="{StaticResource RecordWeightButton}"
                    Command="{Binding CaptureWeight1Command}" IsEnabled="{Binding IsWeigh1Enabled}" Margin="3,0"/>
            <Button x:Name="Weigh2Button" TabIndex="7" Content="{Binding Weigh2ButtonText}" Style="{StaticResource RecordWeightButton}"
                    Command="{Binding CaptureWeight2Command}" IsEnabled="{Binding IsWeigh2Enabled}" Margin="3,0"/>
            <Button TabIndex="8" Content="💾 LƯU" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}" Margin="3,0"/>
            <Button TabIndex="9" Content="HỦY BỎ" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Margin="3,0"/>
            <Button TabIndex="10" Content="👁 XEM" Style="{StaticResource ActionButton}" Command="{Binding ViewTicketCommand}" Margin="3,0"/>
            <Button x:Name="MainPrintButtonCreate" TabIndex="11" Content="IN" Style="{StaticResource ActionButton}" Command="{Binding PrintTicketCommand}" PreviewMouseDown="MainPrintButton_OnPreviewMouseDown" Margin="3,0"/>
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="5" Margin="0,2" MinHeight="48" MaxHeight="54"
                     Visibility="{Binding IsEditModeActionsVisible, Converter={StaticResource BoolToVis}}">
            <Button TabIndex="6" Content="CẬP NHẬT" Style="{StaticResource SaveButton}" Command="{Binding UpdateTicketCommand}" Margin="3,0"/>
            <Button TabIndex="7" Content="THOÁT" Style="{StaticResource CancelButton}" Command="{Binding ExitEditCommand}" Margin="3,0"/>
            <Button TabIndex="8" Content="MỞ KHÓA" Command="{Binding UnlockDevWeightEditCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}"
                    Visibility="{Binding IsDeveloperWeightUnlockVisible}" Margin="3,0"/>
            <Button TabIndex="9" Content="👁 XEM" Style="{StaticResource ActionButton}" Command="{Binding ViewTicketCommand}" Margin="3,0"/>
            <Button x:Name="MainPrintButtonEdit" TabIndex="10" Content="IN" Style="{StaticResource ActionButton}" Command="{Binding PrintTicketCommand}" PreviewMouseDown="MainPrintButton_OnPreviewMouseDown" Margin="3,0"/>
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,2" MinHeight="48" MaxHeight="54"
                     Visibility="{Binding IsViewModeActionsVisible, Converter={StaticResource BoolToVis}}">
            <Button TabIndex="6" Content="THOÁT" Style="{StaticResource CancelButton}" Command="{Binding ExitViewCommand}" Margin="3,0"/>
            <Button TabIndex="7" Content="👁 XEM" Style="{StaticResource ActionButton}" Command="{Binding ViewTicketCommand}" Margin="3,0"/>
            <Button x:Name="MainPrintButton" TabIndex="8" Content="IN" Style="{StaticResource ActionButton}" Command="{Binding PrintTicketCommand}" PreviewMouseDown="MainPrintButton_OnPreviewMouseDown" Margin="3,0"/>
            <Button TabIndex="9" Content="MỞ KHÓA" Style="{StaticResource CanXeSecondaryButtonStyle}" Command="{Binding UnlockViewForEditCommand}" Margin="3,0"/>
        </UniformGrid>

        <!-- Filters -->
        <StackPanel Grid.Row="3" Margin="0,2,0,2">
            <WrapPanel Margin="0,0,0,4">
                <ToggleButton Content="HÔM NAY" Command="{Binding FilterTodayCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="Hôm nay">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton Content="HÔM QUA" Command="{Binding FilterYesterdayCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="Hôm qua">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton Content="7 NGÀY" Command="{Binding FilterLast7DaysCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="7 ngày">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton Content="THÁNG NÀY" Command="{Binding FilterThisMonthCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="Tháng này">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button Content="{Binding AdvancedFilterToggleText}" Style="{StaticResource CanXeSecondaryButtonStyle}"
                        Command="{Binding ToggleAdvancedFilterCommand}" TabIndex="-1" Margin="8,0,0,0"/>
            </WrapPanel>

            <StackPanel Visibility="{Binding IsAdvancedFilterVisible, Converter={StaticResource BoolToVis}}">
                <WrapPanel Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <DatePicker SelectedDate="{Binding FilterFromDate}" Width="130" FontSize="15" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <DatePicker SelectedDate="{Binding FilterToDate}" Width="130" FontSize="15" TabIndex="-1"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,4">
                    <StackPanel Width="150" Margin="0,0,8,6">
                        <TextBlock Text="Khách hàng" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding FilterCustomerName, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,8,6">
                        <TextBlock Text="Loại hàng" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding FilterCargoTypeName, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,8,6">
                        <TextBlock Text="Biển số" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding FilterLicensePlate, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,8,6">
                        <TextBlock Text="Số phiếu" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding FilterDisplayNumber, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,8,6">
                        <TextBlock Text="Từ giá" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding FilterUnitPriceText, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,8,6">
                        <TextBlock Text="Đến giá" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBox Text="{Binding FilterUnitPriceToText, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <Button Content="ÁP DỤNG" Style="{StaticResource FilterButton}" Command="{Binding ApplyFilterCommand}" TabIndex="-1"/>
                        <Button Content="XÓA LỌC" Style="{StaticResource FilterButton}" Command="{Binding ClearFilterCommand}" TabIndex="-1"/>
                        <Button Content="XUẤT EXCEL" Style="{StaticResource FilterButton}" Command="{Binding ExportExcelStubCommand}" TabIndex="-1" IsEnabled="False"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ActiveFilterChips}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Margin="0,0,6,4" Padding="8,4" TabIndex="-1"
                                Command="{Binding DataContext.RemoveFilterChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="TicketsGrid" Grid.Row="4"
                  Style="{StaticResource CanXeDataGridStyle}"
                  ItemsSource="{Binding Tickets}"
                  SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CanUserSortColumns="False"
                  RowStyle="{StaticResource TicketGridRow}"
                  RowHeight="{Binding TicketGridRowHeight}"
                  MinHeight="{Binding DataGridMinHeight}"
                  TabIndex="-1"
                  MouseDoubleClick="TicketsGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày giờ" Binding="{Binding TicketDateTime, StringFormat=dd/MM/yyyy HH:mm}" Width="130" DisplayIndex="0"/>
                <DataGridTextColumn Header="Số phiếu" Binding="{Binding DisplayNumber}" Width="72" DisplayIndex="1"/>
                <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate, TargetNullValue=—}" Width="95" DisplayIndex="2"
                                    ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName, TargetNullValue=—}" Width="*" DisplayIndex="3"
                                    MinWidth="160" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Loại hàng" Binding="{Binding CargoTypeName, TargetNullValue=—}" Width="*" DisplayIndex="4"
                                    MinWidth="130" ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Tổng" Binding="{Binding GrossWeightKg, StringFormat=N0, TargetNullValue=—}" Width="72" DisplayIndex="5"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Bì" Binding="{Binding TareWeightKg, StringFormat=N0, TargetNullValue=—}" Width="68" DisplayIndex="6"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Hàng" Binding="{Binding NetWeightKg, StringFormat=N0, TargetNullValue=—}" Width="72" DisplayIndex="7"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="KL tính tiền" Binding="{Binding BillableWeightKg, StringFormat=N0, TargetNullValue=—}" Width="95" DisplayIndex="8"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceVndPerKg, StringFormat=N0, TargetNullValue=—}" Width="85" DisplayIndex="9"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalAmountVnd, StringFormat=N0, TargetNullValue=—}" Width="100" DisplayIndex="10"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes, TargetNullValue=—}" Width="*" MinWidth="120" DisplayIndex="11"
                                    ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding WorkflowStatusText}" Width="Auto" MinWidth="108" MaxWidth="140" DisplayIndex="12"/>
                <DataGridTemplateColumn Header="" Width="44" DisplayIndex="13"
                                        Visibility="{Binding DataContext.IsDeveloperDeleteVisible, RelativeSource={RelativeSource AncestorType=Window}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CanXeHistoryDeleteButtonStyle}"
                                    Command="{Binding DataContext.DeleteTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    PreviewMouseDoubleClick="DeleteTicketButton_OnPreviewMouseDoubleClick"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer summary -->
        <UniformGrid Grid.Row="5" Columns="5" Margin="0,4,0,0" MaxHeight="{Binding SummaryFooterMaxHeight}">
            <Border Style="{StaticResource CanXeCompactSummaryCardStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="📋 Số phiếu" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTicketCount, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeCompactSummaryCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="⚖ Tổng hàng" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTotalNet, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeCompactSummaryCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="💰 KL tính tiền" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTotalBillable, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeCompactSummaryCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="💵 Tổng tiền" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTotalAmount, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SummaryAccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeCompactSummaryCardStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="⚠ Chưa có giá" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">
                        <Run Text="{Binding FooterMissingPriceCount, Mode=OneWay}"/><Run Text=" phiếu"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>
        </Grid>

        <!-- Section: DANH MỤC -->
        <Grid Grid.Row="2" Visibility="{Binding IsCatalogSectionVisible, Converter={StaticResource BoolToVis}}">
            <catalogs:CatalogView DataContext="{Binding Catalog}"/>
        </Grid>

        <!-- Section: THIẾT BỊ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDeviceSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8">
                <TextBlock Text="THIẾT BỊ" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Nguồn đầu cân" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <RadioButton Content="Đầu cân COM" GroupName="ScaleSource"
                                     IsChecked="{Binding IsHardwareScaleMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsHardwareModeEnabled}" Margin="0,4,0,0"/>
                        <RadioButton Content="Tự động mô phỏng" GroupName="ScaleSource"
                                     IsChecked="{Binding IsAutomaticSimulationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSimulationScaleSourceSelectionEnabled}" Margin="0,4,0,0"/>
                        <RadioButton Content="Thủ công mô phỏng" GroupName="ScaleSource"
                                     IsChecked="{Binding IsManualSimulationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSimulationScaleSourceSelectionEnabled}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Đầu cân" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Cổng COM" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PortName}" Style="{StaticResource CanXeTextBoxStyle}"/>
                                <TextBlock Text="Baud rate" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding BaudRate}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Data bits" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DataBits}" Style="{StaticResource CanXeTextBoxStyle}"/>
                                <TextBlock Text="Parity" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Parity}" Style="{StaticResource CanXeTextBoxStyle}"/>
                                <TextBlock Text="Stop bits" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding StopBits}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Handshake" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Handshake}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <CheckBox Content="Tự kết nối khi mở ứng dụng" IsChecked="{Binding AutoConnectScaleOnStartup}"
                                  FontSize="15" Margin="0,10,0,0"
                                  IsEnabled="{Binding DataContext.IsHardwareModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="KIỂM TRA KẾT NỐI" Command="{Binding TestScaleCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding ScaleTestMessage}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>
                        <Button Content="LƯU CẤU HÌNH" Command="{Binding DataContext.SaveScaleConfigurationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding IsHardwareOperationsPanelVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Đầu cân COM — vận hành" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="{Binding HardwareConnectionStatus}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding HardwareStableText}" Margin="0,4,0,4"/>
                        <TextBlock Text="{Binding HardwareLastFrameText, StringFormat=Frame gần nhất: {0}}"/>
                        <TextBlock Text="{Binding HardwareChecksumWarning}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="KẾT NỐI" Command="{Binding ConnectHardwareCommand}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsHardwareConnectEnabled}"/>
                            <Button Content="NGẮT KẾT NỐI" Command="{Binding DisconnectHardwareCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}"
                                    IsEnabled="{Binding IsHardwareDisconnectEnabled}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Máy in" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="Máy in mặc định" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,4"/>
                        <TextBlock Text="{Binding DefaultPrinterName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PrinterStatusText, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Button Content="IN THỬ" Command="{Binding TestPrintCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding PrinterTestMessage}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Section: BÁO CÁO -->
        <Grid Grid.Row="2" Visibility="{Binding IsReportSectionVisible, Converter={StaticResource BoolToVis}}">
            <reports:ReportView DataContext="{Binding Report}"/>
        </Grid>

        <!-- Section: CÀI ĐẶT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsSettingsSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8" DataContext="{Binding Settings}">
                <TextBlock Text="CÀI ĐẶT" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="GIAO DIỆN" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="Giao diện ứng dụng:" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ToggleButton Content="Sáng" Style="{StaticResource CanXeSegmentButtonStyle}"
                                          IsChecked="{Binding IsThemeLightSelected, Mode=OneWay}"
                                          Command="{Binding SelectThemeLightCommand}" Margin="0,0,6,0"/>
                            <ToggleButton Content="Tối" Style="{StaticResource CanXeSegmentButtonStyle}"
                                          IsChecked="{Binding IsThemeDarkSelected, Mode=OneWay}"
                                          Command="{Binding SelectThemeDarkCommand}" Margin="0,0,6,0"/>
                            <ToggleButton Content="Tự động" Style="{StaticResource CanXeSegmentButtonStyle}"
                                          IsChecked="{Binding IsThemeAutoSelected, Mode=OneWay}"
                                          Command="{Binding SelectThemeAutoCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ThemeAutoHint}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="CẤU HÌNH TRẠM CÂN" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Border Style="{StaticResource CanXeCardStyle}">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Trạm cân" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="Tên trạm cân *" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="{Binding StationNameError}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Chủ sở hữu" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="Liên hệ — Địa chỉ" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Điện thoại" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Phone}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Email" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Email}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Mã số thuế (tùy chọn)" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding TaxCode}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="Nội dung chân phiếu" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding TicketFooterText}" Style="{StaticResource CanXeTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"/>
                        <Button Content="LƯU CẤU HÌNH" Command="{Binding SaveStationCommand}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding SettingsStatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Section: HỆ THỐNG -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsSystemSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8" DataContext="{Binding Settings}">
                <TextBlock Text="HỆ THỐNG" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN PHIÊN BẢN" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding BuildInfoText, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Content="SAO CHÉP THÔNG TIN" Command="{Binding CopyBuildInfoCommand}" Style="{StaticResource FilterButton}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="KIỂM TRA HỆ THỐNG" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="CHẠY KIỂM TRA TOÀN BỘ" Command="{Binding RunFullDiagnosticsCommand}" Style="{StaticResource FilterButton}" Margin="0,0,8,0"/>
                            <Button Content="XUẤT BÁO CÁO" Command="{Binding ExportDiagnosticsReportCommand}" Style="{StaticResource FilterButton}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DiagnosticsStatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding DiagnosticRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                  MinHeight="120" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hạng mục" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="Chi tiết" Binding="{Binding Detail}" Width="2*"/>
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding DurationText}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="SAO LƯU &amp; KHÔI PHỤC DỮ LIỆU" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                            <Run Text="Database: "/><Run Text="{Binding DatabasePath, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0"><Run Text="Chế độ: "/><Run Text="{Binding DeviceModeDisplay, Mode=OneWay}"/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"><Run Text="Migration: "/><Run Text="{Binding MigrationStatus, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding ErrorLogSummary}" Margin="0,8,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Thư mục backup" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BackupFolderPath, Mode=OneWay}" IsReadOnly="True"
                                         Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Chọn thư mục" VerticalAlignment="Bottom"
                                    Command="{Binding ChooseBackupFolderCommand}"
                                    Style="{StaticResource FilterButton}"
                                    IsEnabled="{Binding IsBackupAdminUnlocked}"/>
                        </Grid>

                        <TextBlock Margin="0,0,0,8">
                            <Run Text="Backup gần nhất: "/><Run Text="{Binding LatestBackupDisplay, Mode=OneWay}"/>
                        </TextBlock>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="TẠO BACKUP NGAY" Command="{Binding CreateBackupNowCommand}"
                                    Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button Content="KHÔI PHỤC TỪ BACKUP" Command="{Binding RestoreFromBackupCommand}"
                                    Style="{StaticResource FilterButton}" Margin="0,0,8,8"
                                    IsEnabled="{Binding IsBackupAdminUnlocked}"/>
                            <Button Content="MỞ THƯ MỤC BACKUP" Command="{Binding OpenBackupFolderCommand}"
                                    Style="{StaticResource FilterButton}" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <CheckBox Content="Tự động backup mỗi ngày khi mở app"
                                  IsChecked="{Binding AutoBackupEnabled}"
                                  IsEnabled="{Binding IsBackupAdminUnlocked}"
                                  Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Giữ backup:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <RadioButton Content="15 ngày" GroupName="BackupRetention"
                                         IsChecked="{Binding RetentionDays15, Mode=OneWay}"
                                         Command="{Binding SetRetention15Command}"
                                         IsEnabled="{Binding IsBackupAdminUnlocked}"
                                         Margin="0,0,12,0"/>
                            <RadioButton Content="30 ngày" GroupName="BackupRetention"
                                         IsChecked="{Binding RetentionDays30, Mode=OneWay}"
                                         Command="{Binding SetRetention30Command}"
                                         IsEnabled="{Binding IsBackupAdminUnlocked}"/>
                        </StackPanel>

                        <TextBlock Text="Có thể chọn thư mục Google Drive / OneDrive / Dropbox để tự đồng bộ backup lên cloud."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding BackupStatusMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Mở khóa Admin để đổi thư mục, bật auto backup, đổi thời gian giữ, hoặc khôi phục."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsBackupAdminUnlocked, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,20,24,0" Padding="16,10" CornerRadius="8"
                Background="{DynamicResource ToastBackgroundBrush}"
                BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1"
                MaxWidth="340"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="False"
                Panel.ZIndex="100">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource ToastTextBrush}" FontSize="14" TextWrapping="Wrap"/>
        </Border>

        <!-- Section: ADMIN -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDeveloperSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8" DataContext="{Binding Developer}">
                <TextBlock Text="ADMIN" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Thông tin phiên bản" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="{Binding BuildInfoText, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="SAO CHÉP THÔNG TIN" Command="{Binding CopyBuildInfoCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button Content="MỞ THƯ MỤC ỨNG DỤNG" Command="{Binding OpenAppDirectoryCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button Content="MỞ THƯ MỤC LOG" Command="{Binding OpenLogDirectoryCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Trạng thái đầu cân" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="{Binding ScaleStatusText, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="CHẠY KIỂM TRA HỆ THỐNG" Command="{Binding RunFullDiagnosticsCommand}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button Content="XUẤT BÁO CÁO" Command="{Binding ExportDiagnosticsReportCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button Content="MỞ THƯ MỤC LOG" Command="{Binding OpenLogDirectoryCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DiagnosticsSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding IsSimulationVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Simulation" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <CheckBox Content="Ổn định" IsChecked="{Binding SimulateScaleStable}" FontSize="15" Margin="0,4,0,4"/>
                        <CheckBox Content="Mất kết nối đầu cân" IsChecked="{Binding SimulateScaleDisconnected}" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock Text="Trọng lượng mô phỏng (kg)" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SimulatedWeightText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CanXeTextBoxStyle}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CanXeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent errors" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Margin="0,0,0,4"><Run Text="Startup: "/><Run Text="{Binding LastStartupError, Mode=OneWay}"/></TextBlock>
                        <TextBlock Margin="0,0,0,4"><Run Text="Scale: "/><Run Text="{Binding LastScaleError, Mode=OneWay}"/></TextBlock>
                        <TextBlock Margin="0,0,0,4"><Run Text="Database: "/><Run Text="{Binding LastDatabaseError, Mode=OneWay}"/></TextBlock>
                        <TextBlock Margin="0,0,0,0"><Run Text="Printer: "/><Run Text="{Binding LastPrinterError, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
