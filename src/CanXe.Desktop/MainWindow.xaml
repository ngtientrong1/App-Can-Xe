<Window x:Class="CanXe.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:CanXe.Desktop.Converters"
        xmlns:ctrl="clr-namespace:CanXe.Desktop.Controls"
        xmlns:models="clr-namespace:CanXe.Application.Models;assembly=CanXe.Application"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="CanXe — Cân xe"
        MinWidth="1280"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:RowHighlightConverter x:Key="RowHighlight"/>
        <conv:StringEqualsConverter x:Key="StringEq"/>

        <Style x:Key="NavTabActiveTrigger" TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavSystemActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                    <Setter Property="Background" Value="{StaticResource NavActiveBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterTabStyle" TargetType="Button" BasedOn="{StaticResource CanXeFilterTabStyle}">
            <Setter Property="Tag" Value=""/>
        </Style>

        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TicketGridRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource RowHighlight}">
                            <Binding Path="Id"/>
                            <Binding Path="DataContext.HighlightedTicketId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App header -->
        <Border Grid.Row="0" Style="{StaticResource CanXeCardStyle}" Padding="14,12" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBlueBrush}" Margin="0,0,12,0">
                        <TextBlock Text="⚖" Foreground="White" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CanXe" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding HeaderClockText}" FontSize="16" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource CanXeStatusBadgeStyle}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding HeaderScaleStatus}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WeightStableBrush}"/>
                    </Border>
                    <Border Style="{StaticResource CanXeStatusBadgeStyle}" Background="#E3F2FD" BorderBrush="#BBDEFB">
                        <TextBlock Text="{Binding HeaderCameraStatus}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border Grid.Row="1" Style="{StaticResource CanXeCardStyle}" Padding="6,4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="HỆ THỐNG" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.System}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavSystemActive}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="PHIẾU CÂN" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.WeighTicket}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavWeighTicketActive}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="DANH MỤC" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Catalog}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCatalogActive}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="THIẾT BỊ" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Device}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavDeviceActive}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="BÁO CÁO" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Report}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavReportActive}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="CÀI ĐẶT" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:AppNavigationSection.Settings}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CanXeNavigationButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavSettingsActive}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource NavActiveBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Section: PHIẾU CÂN -->
        <Grid Grid.Row="2" Visibility="{Binding IsWeighTicketSectionVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="300"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding WeighColumnWidth}" MinWidth="300"/>
                <ColumnDefinition Width="{Binding InfoColumnWidth}" MinWidth="340"/>
                <ColumnDefinition Width="{Binding CameraDrawerColumnWidth}" MaxWidth="360"/>
                <ColumnDefinition Width="{Binding UtilityRailColumnWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- Left: live weight -->
            <Border Grid.Column="0" Style="{StaticResource CanXeCardStyle}" Margin="0,0,8,0" Padding="14,12"
                    Background="{StaticResource PanelBrush}" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="TRỌNG LƯỢNG TRỰC TIẾP" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" Margin="0,0,0,6"/>
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" MaxHeight="120" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LiveWeightDisplayText}"
                                       FontSize="{Binding LiveWeightFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource WeightStableBrush}"/>
                            <TextBlock Text=" kg" FontSize="{Binding LiveWeightUnitFontSize}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,8"
                                       Visibility="{Binding ShowLiveWeightUnit, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Text="{Binding ScaleStabilityText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource WeightStableBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding WeightSourceText}" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding OperatorStatusMessage}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button Content="THỬ KẾT NỐI LẠI" Command="{Binding RetryConnectHardwareCommand}"
                            Style="{StaticResource CanXeSecondaryButtonStyle}" MinHeight="44" FontSize="15"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsRetryConnectVisible, Converter={StaticResource BoolToVis}}"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#BDBDBD" BorderThickness="1" Padding="6" Margin="0,0,4,0"
                                Background="White" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="CÂN LẦN 1" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Weight1ValueText}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Weight1TimeText}" FontSize="13" Foreground="#616161"
                                           Visibility="{Binding Weight1HasValue, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#BDBDBD" BorderThickness="1" Padding="6" Margin="4,0,0,0"
                                Background="White" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="CÂN LẦN 2" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Weight2ValueText}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Weight2TimeText}" FontSize="13" Foreground="#616161"
                                           Visibility="{Binding Weight2HasValue, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="TỔNG" FontSize="15"/>
                            <TextBlock Text="{Binding GrossDisplay}" FontSize="21" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="BÌ" FontSize="15"/>
                            <TextBlock Text="{Binding TareDisplay}" FontSize="21" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="HÀNG" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                            <TextBlock Text="{Binding NetDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NetHighlightBrush}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock FontSize="15" Margin="0,1,0,0">
                        <Run Text="Trừ bì: "/>
                        <Run Text="{Binding DeductionDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="15" Margin="0,1,0,0">
                        <Run Text="KL tính tiền: "/>
                        <Run Text="{Binding BillableDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="15" Margin="0,1,0,0">
                        <Run Text="Thành tiền: "/>
                        <Run Text="{Binding TotalAmountDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Cân dịch vụ — chưa nhập đơn giá" Foreground="#757575" FontSize="13" Margin="0,4,0,0"
                               Visibility="{Binding IsServiceWeighVisible, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Middle: ticket info -->
            <Border Grid.Column="1" Margin="0,0,8,0" Padding="12,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CanXeCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingExistingTicket}" Value="True">
                                <Setter Property="Background" Value="#FFFDE7"/>
                                <Setter Property="BorderBrush" Value="#FFB74D"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Top">
                    <Border Padding="8,6" Margin="0,0,0,8" CornerRadius="4"
                            Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                            Visibility="{Binding IsEditingExistingTicket, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EditBannerTitle}" FontSize="16" FontWeight="Bold" Foreground="#E65100"/>
                            <TextBlock Text="Thay đổi chỉ được lưu sau khi bấm CẬP NHẬT PHIẾU" FontSize="13" Foreground="#616161"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="Số phiếu:" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DisplayNumber}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Số dự kiến" Foreground="#757575" FontSize="13" Margin="8,4,0,0"
                                       Visibility="{Binding IsPreviewDisplayNumber, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TicketDateTimeDisplay}" FontSize="18" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Khách hàng" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <ctrl:AutoCompleteTextBox x:Name="CustomerField" TabIndex="1"
                                                      Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding CustomerSuggestions}" FontSize="18"
                                                      SuppressDropDown="{Binding SuppressAutocomplete}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Biển số xe" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <ctrl:AutoCompleteTextBox x:Name="VehicleField" TabIndex="2"
                                                      Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding VehicleSuggestions}" FontSize="18"
                                                      SuppressDropDown="{Binding SuppressAutocomplete}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Loại hàng" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <ctrl:AutoCompleteTextBox x:Name="CargoField" TabIndex="3"
                                                      Text="{Binding CargoTypeName, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding CargoTypeSuggestions}" FontSize="18"
                                                      SuppressDropDown="{Binding SuppressAutocomplete}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Đơn giá (VNĐ/kg)" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                            <TextBox x:Name="UnitPriceField" TabIndex="4" Style="{StaticResource CanXeTextBoxStyle}"
                                     MinHeight="56" FontSize="20"
                                     GotFocus="UnitPriceField_OnGotFocus" LostFocus="UnitPriceField_OnLostFocus"
                                     Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Ghi chú" Style="{StaticResource CanXeFormFieldLabelStyle}"/>
                        <ctrl:AutoCompleteTextBox x:Name="NotesField" TabIndex="5" MinHeight="56"
                                                  Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding NotesSuggestions}" FontSize="18"
                                                  SuppressDropDown="{Binding SuppressAutocomplete}"/>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsEditingExistingTicket, Converter={StaticResource BoolToVis}}">
                        <Button Content="MỞ KHÓA SỬA TRỌNG LƯỢNG" Command="{Binding UnlockDevWeightEditCommand}"
                                TabIndex="-1" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDeveloperWeightUnlockVisible}" Value="True"/>
                                                <Condition Binding="{Binding IsDevWeightEditUnlocked}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Visibility="{Binding IsDevWeightEditUnlocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DEV — Sửa trọng lượng thủ công" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Cân lần 1" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding DevWeight1Text, UpdateSourceTrigger=PropertyChanged}" FontSize="17"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Cân lần 2" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding DevWeight2Text, UpdateSourceTrigger=PropertyChanged}" FontSize="17"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Trọng lượng đã được chỉnh sửa thủ công. Ảnh thuộc giá trị cân ban đầu."
                                       Foreground="#E65100" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding IsManualWeightOverrideMessageVisible, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Visibility="{Binding IsWeightOverrideReasonPanelVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Lý do sửa trọng lượng" FontSize="14" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding WeightOverrideReasonOptions}"
                                          SelectedValuePath="Code" DisplayMemberPath="Label"
                                          SelectedValue="{Binding WeightOverrideReasonCode}" FontSize="15" Margin="0,2,0,4"/>
                                <TextBox Text="{Binding WeightOverrideReasonOther, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15" Margin="0,0,0,4"
                                         Visibility="{Binding WeightOverrideReasonCode, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Camera drawer -->
            <Border Grid.Column="2" Style="{StaticResource CanXeCardStyle}" Padding="12" Margin="0,0,8,0"
                    Visibility="{Binding IsCameraDrawerOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="CAMERA" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <Button Content="✕" Command="{Binding ToggleCameraDrawerCommand}" DockPanel.Dock="Right"
                                Style="{StaticResource CanXeSecondaryButtonStyle}" Padding="8,4" MinHeight="36"/>
                    </DockPanel>
                    <Border Background="#263238" CornerRadius="8" Margin="0,0,0,8">
                        <Grid Width="280" Height="158">
                            <TextBlock Text="Preview 16:9" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="14"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CanXeStatusBadgeStyle}" Background="#E3F2FD" BorderBrush="#BBDEFB" Margin="0,0,0,8">
                        <TextBlock Text="{Binding HeaderCameraStatus}" FontSize="13" Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                        <Run Text="Phiếu gần nhất: "/>
                        <Run Text="{Binding LastSavedTicketDisplayNumber, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <Button Content="XEM PHIẾU" Command="{Binding ViewTicketCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,0,0,6"/>
                    <Button Content="THU GỌN" Command="{Binding ToggleCameraDrawerCommand}" Style="{StaticResource CanXePrimaryButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Utility rail -->
            <StackPanel Grid.Column="3" VerticalAlignment="Stretch">
                <Button Command="{Binding ToggleCameraDrawerCommand}" Style="{StaticResource CanXeUtilityRailButtonStyle}"
                        ToolTip="Mở/thu gọn camera">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📷" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="CAMERA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleDevDrawerCommand}" Style="{StaticResource CanXeUtilityRailButtonStyle}"
                        ToolTip="Panel DEV mô phỏng"
                        Visibility="{Binding IsDeveloperPanelAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="DEV" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- DEV drawer -->
        <Border Grid.Row="0" Grid.RowSpan="6" HorizontalAlignment="Right" Width="340"
                Style="{StaticResource CanXeCardStyle}" CornerRadius="11,0,0,11"
                Visibility="{Binding IsDevDrawerOpen, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="10" Margin="0,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding IsDeveloperPanelAvailable, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="DEV — Chẩn đoán" FontSize="17" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <Button Content="✕" Command="{Binding ToggleDevDrawerCommand}" DockPanel.Dock="Right"
                                Style="{StaticResource CanXeSecondaryButtonStyle}" Padding="8,4" MinHeight="36"/>
                    </DockPanel>

                    <TextBlock Text="Trạng thái" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Margin="0,0,0,4"><Run Text="Nguồn hiện tại: "/><Run Text="{Binding DevWeightSourceDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="Active ScaleInputMode: "/><Run Text="{Binding DevActiveScaleInputModeDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="DeviceMode: "/><Run Text="{Binding DevDeviceModeDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="COM connected: "/><Run Text="{Binding DevComConnectedDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="COM port / baud: "/><Run Text="{Binding DevComPortBaudDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="Frame: "/><Run Text="{Binding DevFrameStatusDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="Stable: "/><Run Text="{Binding DevStableDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="Last frame: "/><Run Text="{Binding DevLastFrameDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,4"><Run Text="Last valid reading: "/><Run Text="{Binding DevLastValidReadingTimeDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="0,0,0,12"><Run Text="Simulation running: "/><Run Text="{Binding DevSimulationRunningDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>

                    <TextBlock Text="Chế độ nguồn trọng lượng" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <StackPanel Margin="0,0,0,12">
                        <RadioButton Content="Tự động mô phỏng" GroupName="DevScaleSource"
                                     IsChecked="{Binding IsAutomaticSimulationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"/>
                        <RadioButton Content="Thủ công mô phỏng" GroupName="DevScaleSource"
                                     IsChecked="{Binding IsManualSimulationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"/>
                        <RadioButton Content="Đầu cân COM" GroupName="DevScaleSource"
                                     IsChecked="{Binding IsHardwareScaleMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsHardwareModeEnabled}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="TRỞ VỀ TỰ ĐỘNG" Command="{Binding ReturnToAutomaticModeAsyncCommand}"
                            Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,0,0,12"
                            Visibility="{Binding IsReturnToAutomaticVisible, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Visibility="{Binding IsManualWeightInputVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                        <TextBlock Text="Trọng lượng mô phỏng (kg)" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBox Text="{Binding SimulatedWeightText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="{Binding ManualSimulationInputError}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding ManualSimulationInputError, Converter={StaticResource NullToVis}}"/>
                        <UniformGrid Columns="2" Margin="0,8,0,8">
                            <Button Content="ÁP DỤNG" Command="{Binding ApplySimulatedWeightCommand}"
                                    Style="{StaticResource CanXeWeightButtonStyle}" Margin="0,0,4,0"/>
                            <Button Content="VỀ 0" Command="{Binding ResetSimulatedWeightToZeroCommand}"
                                    Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="8.500 kg" Command="{Binding ApplyPresetWeight8500Command}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,0,4,0"/>
                            <Button Content="18.500 kg" Command="{Binding ApplyPresetWeight18500Command}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock Text="Mô phỏng trạng thái" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <CheckBox Content="Ổn định" IsChecked="{Binding SimulateScaleStable}" FontSize="15" Margin="0,0,0,4"/>
                    <CheckBox Content="Mất kết nối đầu cân" IsChecked="{Binding SimulateScaleDisconnected}" FontSize="15" Margin="0,0,0,4"/>
                    <CheckBox Content="Mô phỏng lỗi camera" IsChecked="{Binding SimulateCameraError}" FontSize="15" Margin="0,0,0,4"/>
                    <CheckBox Content="Mô phỏng lỗi đầu cân" IsChecked="{Binding SimulateScaleError}" FontSize="15" Margin="0,0,0,12"/>

                    <TextBlock Text="Draft Weight1" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="{Binding Weight1ValueText}" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="Draft Weight2" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="{Binding Weight2ValueText}" FontSize="16" Margin="0,0,0,8"/>
                    <CheckBox IsChecked="{Binding DeveloperWeight1OverrideEnabled}" FontSize="14" Margin="0,0,0,12">
                        <TextBlock Text="Cho phép cập nhật lại Weight1 sau Weight2" TextWrapping="Wrap"/>
                    </CheckBox>

                    <Button Content="ĐÓNG DEV" Command="{Binding ToggleDevDrawerCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Operator status bar -->
        <Border Grid.Row="1" Background="#F5F7FA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
            <TextBlock Text="{Binding OperatorBarText}" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>

        <!-- Action buttons -->
        <UniformGrid Grid.Row="2" Columns="6" Margin="0,2"
                     Visibility="{Binding IsCreateModeActionsVisible, Converter={StaticResource BoolToVis}}">
            <Button x:Name="Weigh1Button" TabIndex="6" Content="{Binding Weigh1ButtonText}" Style="{StaticResource RecordWeightButton}"
                    Command="{Binding CaptureWeight1Command}" IsEnabled="{Binding IsWeigh1Enabled}" Margin="3,0"/>
            <Button x:Name="Weigh2Button" TabIndex="7" Content="{Binding Weigh2ButtonText}" Style="{StaticResource RecordWeightButton}"
                    Command="{Binding CaptureWeight2Command}" IsEnabled="{Binding IsWeigh2Enabled}" Margin="3,0"/>
            <Button TabIndex="8" Content="💾 LƯU" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}" Margin="3,0"/>
            <Button TabIndex="9" Content="HỦY BỎ" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Margin="3,0"/>
            <Button TabIndex="10" Content="👁 XEM" Style="{StaticResource ActionButton}" Command="{Binding ViewTicketCommand}" Margin="3,0"/>
            <Button TabIndex="11" Content="🖨 IN" Style="{StaticResource ActionButton}" Command="{Binding PrintTicketCommand}" Margin="3,0"/>
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="5" Margin="0,2"
                     Visibility="{Binding IsEditModeActionsVisible, Converter={StaticResource BoolToVis}}">
            <Button TabIndex="6" Content="CẬP NHẬT" Style="{StaticResource SaveButton}" Command="{Binding UpdateTicketCommand}" Margin="3,0"/>
            <Button TabIndex="7" Content="THOÁT" Style="{StaticResource CancelButton}" Command="{Binding ExitEditCommand}" Margin="3,0"/>
            <Button TabIndex="8" Content="MỞ KHÓA" Command="{Binding UnlockDevWeightEditCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}"
                    Visibility="{Binding IsDeveloperWeightUnlockVisible}" Margin="3,0"/>
            <Button TabIndex="9" Content="👁 XEM" Style="{StaticResource ActionButton}" Command="{Binding ViewTicketCommand}" Margin="3,0"/>
            <Button TabIndex="10" Content="🖨 IN" Style="{StaticResource ActionButton}" Command="{Binding PrintTicketCommand}" Margin="3,0"/>
        </UniformGrid>

        <!-- Filters -->
        <StackPanel Grid.Row="3" Margin="0,4,0,4">
            <WrapPanel Margin="0,0,0,4">
                <ToggleButton Content="HÔM NAY" Command="{Binding FilterTodayCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="Hôm nay">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton Content="HÔM QUA" Command="{Binding FilterYesterdayCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="Hôm qua">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton Content="7 NGÀY" Command="{Binding FilterLast7DaysCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="7 ngày">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton Content="THÁNG NÀY" Command="{Binding FilterThisMonthCommand}" TabIndex="-1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CanXeSegmentButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveQuickFilterKey}" Value="Tháng này">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button Content="{Binding AdvancedFilterToggleText}" Style="{StaticResource CanXeSecondaryButtonStyle}"
                        Command="{Binding ToggleAdvancedFilterCommand}" TabIndex="-1" Margin="8,0,0,0"/>
            </WrapPanel>

            <StackPanel Visibility="{Binding IsAdvancedFilterVisible, Converter={StaticResource BoolToVis}}">
                <WrapPanel Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="15" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FilterFromDate}" Width="130" FontSize="15" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="15" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FilterToDate}" Width="130" FontSize="15" TabIndex="-1"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,4">
                    <StackPanel Width="150" Margin="0,0,8,6">
                        <TextBlock Text="Khách hàng" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FilterCustomerName, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,8,6">
                        <TextBlock Text="Loại hàng" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FilterCargoTypeName, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,8,6">
                        <TextBlock Text="Biển số" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FilterLicensePlate, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,8,6">
                        <TextBlock Text="Số phiếu" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FilterDisplayNumber, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,8,6">
                        <TextBlock Text="Từ giá" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FilterUnitPriceText, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,8,6">
                        <TextBlock Text="Đến giá" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FilterUnitPriceToText, UpdateSourceTrigger=PropertyChanged}" TabIndex="-1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <Button Content="ÁP DỤNG" Style="{StaticResource FilterButton}" Command="{Binding ApplyFilterCommand}" TabIndex="-1"/>
                        <Button Content="XÓA LỌC" Style="{StaticResource FilterButton}" Command="{Binding ClearFilterCommand}" TabIndex="-1"/>
                        <Button Content="XUẤT EXCEL" Style="{StaticResource FilterButton}" Command="{Binding ExportExcelStubCommand}" TabIndex="-1" IsEnabled="False"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ActiveFilterChips}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Margin="0,0,6,4" Padding="8,4" TabIndex="-1"
                                Command="{Binding DataContext.RemoveFilterChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="TicketsGrid" Grid.Row="4"
                  Style="{StaticResource CanXeDataGridStyle}"
                  ItemsSource="{Binding Tickets}"
                  SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CanUserSortColumns="False"
                  RowStyle="{StaticResource TicketGridRow}"
                  TabIndex="-1"
                  MouseDoubleClick="TicketsGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày giờ" Binding="{Binding TicketDateTime, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Số phiếu" Binding="{Binding DisplayNumber}" Width="85"/>
                <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate, TargetNullValue=—}" Width="95"
                                    ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName, TargetNullValue=—}" Width="180"
                                    ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Loại hàng" Binding="{Binding CargoTypeName, TargetNullValue=—}" Width="150"
                                    ElementStyle="{StaticResource GridCellText}"/>
                <DataGridTextColumn Header="Tổng" Binding="{Binding GrossWeightKg, StringFormat=N0, TargetNullValue=—}" Width="72"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Bì" Binding="{Binding TareWeightKg, StringFormat=N0, TargetNullValue=—}" Width="68"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Hàng" Binding="{Binding NetWeightKg, StringFormat=N0, TargetNullValue=—}" Width="72"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="KL tính tiền" Binding="{Binding BillableWeightKg, StringFormat=N0, TargetNullValue=—}" Width="95"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceVndPerKg, StringFormat=N0, TargetNullValue=—}" Width="85"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalAmountVnd, StringFormat=N0, TargetNullValue=—}" Width="100"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes, TargetNullValue=—}" Width="*" MinWidth="120"
                                    ElementStyle="{StaticResource GridCellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer summary -->
        <UniformGrid Grid.Row="5" Columns="5" Margin="0,6,0,0">
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="📋 Số phiếu" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTicketCount, Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="⚖ Tổng hàng" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTotalNet, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="💰 KL tính tiền" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTotalBillable, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="💵 Tổng tiền" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding FooterTotalAmount, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SummaryAccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="⚠ Chưa có giá" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="{Binding FooterMissingPriceCount, Mode=OneWay}"/><Run Text=" phiếu"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>
        </Grid>

        <!-- Section: DANH MỤC -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsCatalogSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8">
                <TextBlock Text="DANH MỤC" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Khách hàng" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="Quản lý danh sách khách hàng — giai đoạn tiếp theo." Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Biển số xe" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="Danh sách biển số được tạo tự động khi nhập phiếu." Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Loại hàng" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="Danh sách loại hàng được tạo tự động khi nhập phiếu." Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Section: THIẾT BỊ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDeviceSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8">
                <TextBlock Text="THIẾT BỊ" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Nguồn đầu cân" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <RadioButton Content="Đầu cân COM" GroupName="ScaleSource"
                                     IsChecked="{Binding IsHardwareScaleMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsHardwareModeEnabled}" Margin="0,4,0,0"/>
                        <RadioButton Content="Tự động mô phỏng" GroupName="ScaleSource"
                                     IsChecked="{Binding IsAutomaticSimulationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSimulationScaleSourceSelectionEnabled}" Margin="0,4,0,0"/>
                        <RadioButton Content="Thủ công mô phỏng" GroupName="ScaleSource"
                                     IsChecked="{Binding IsManualSimulationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSimulationScaleSourceSelectionEnabled}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Đầu cân" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Cổng COM" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PortName}" Style="{StaticResource CanXeTextBoxStyle}"/>
                                <TextBlock Text="Baud rate" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding BaudRate}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Data bits" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DataBits}" Style="{StaticResource CanXeTextBoxStyle}"/>
                                <TextBlock Text="Parity" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Parity}" Style="{StaticResource CanXeTextBoxStyle}"/>
                                <TextBlock Text="Stop bits" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding StopBits}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Handshake" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Handshake}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <CheckBox Content="Tự kết nối khi mở ứng dụng" IsChecked="{Binding AutoConnectScaleOnStartup}"
                                  FontSize="15" Margin="0,10,0,0"
                                  IsEnabled="{Binding DataContext.IsHardwareModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="KIỂM TRA KẾT NỐI" Command="{Binding TestScaleCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding ScaleTestMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/>
                        <Button Content="LƯU CẤU HÌNH" Command="{Binding DataContext.SaveScaleConfigurationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CanXeCardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding IsHardwareOperationsPanelVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Đầu cân COM — vận hành" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="{Binding HardwareConnectionStatus}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding HardwareStableText}" Margin="0,4,0,4"/>
                        <TextBlock Text="{Binding HardwareLastFrameText, StringFormat=Frame gần nhất: {0}}"/>
                        <TextBlock Text="{Binding HardwareChecksumWarning}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="KẾT NỐI" Command="{Binding ConnectHardwareCommand}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsHardwareConnectEnabled}"/>
                            <Button Content="NGẮT KẾT NỐI" Command="{Binding DisconnectHardwareCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}"
                                    IsEnabled="{Binding IsHardwareDisconnectEnabled}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CanXeCardStyle}" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="Camera" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <CheckBox Content="Bật camera" IsChecked="{Binding CameraEnabled}" FontSize="15" Margin="0,4,0,8"/>
                        <TextBlock Text="RTSP URL" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding RtspUrl}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="{Binding RtspUrlError}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Mật khẩu RTSP" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <DockPanel LastChildFill="True">
                            <ToggleButton DockPanel.Dock="Right" Content="👁" Margin="8,0,0,0" MinWidth="48" MinHeight="48"
                                          IsChecked="{Binding ShowCameraPassword, Mode=TwoWay}"
                                          Style="{StaticResource CanXeSecondaryToggleButtonStyle}" ToolTip="Hiện/ẩn mật khẩu"/>
                            <TextBox Text="{Binding CameraPassword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CanXeTextBoxStyle}"/>
                        </DockPanel>
                        <Button Content="KIỂM TRA KẾT NỐI" Command="{Binding TestRtspCommand}" Style="{StaticResource CanXeSecondaryButtonStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding CameraTestMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/>
                        <Button Content="LƯU CẤU HÌNH" Command="{Binding SaveCameraCommand}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Section: BÁO CÁO -->
        <Grid Grid.Row="2" Visibility="{Binding IsReportSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8">
                <TextBlock Text="BÁO CÁO" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Dùng bộ lọc và tổng hợp trên màn PHIẾU CÂN. Xuất Excel sẽ có ở giai đoạn sau." TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="XUẤT EXCEL (DISABLED)" Style="{StaticResource FilterButton}" IsEnabled="False" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Section: CÀI ĐẶT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsSettingsSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8" DataContext="{Binding Settings}">
                <TextBlock Text="CẤU HÌNH TRẠM CÂN" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CanXeCardStyle}">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Trạm cân" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Text="Tên trạm cân *" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="{Binding StationNameError}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Chủ sở hữu" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="Liên hệ — Địa chỉ" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Điện thoại" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Phone}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Email" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Email}" Style="{StaticResource CanXeTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Mã số thuế (tùy chọn)" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding TaxCode}" Style="{StaticResource CanXeTextBoxStyle}"/>
                        <TextBlock Text="Nội dung chân phiếu" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding TicketFooterText}" Style="{StaticResource CanXeTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"/>
                        <Button Content="LƯU CẤU HÌNH" Command="{Binding SaveStationCommand}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding SettingsStatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Section: HỆ THỐNG -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsSystemSectionVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8" DataContext="{Binding Settings}">
                <TextBlock Text="HỆ THỐNG" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock><Run Text="Phiên bản: "/><Run Text="{Binding ApplicationVersion, Mode=OneWay}"/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"><Run Text="Database: "/><Run Text="{Binding DatabasePath, Mode=OneWay}"/></TextBlock>
                        <TextBlock Margin="0,4,0,0"><Run Text="Chế độ: "/><Run Text="{Binding DeviceModeDisplay, Mode=OneWay}"/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"><Run Text="Migration: "/><Run Text="{Binding MigrationStatus, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding ErrorLogSummary}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="SAO LƯU DATABASE" Command="{Binding BackupDatabaseCommand}" Style="{StaticResource FilterButton}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast -->
        <Border Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,12,0,0" Padding="14,8" CornerRadius="4"
                Background="#323232" Opacity="0.92"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="False">
            <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="14"/>
        </Border>

        <!-- Ticket preview overlay -->
        <Border Grid.Row="2" Background="#99000000" Panel.ZIndex="20"
                Visibility="{Binding IsTicketPreviewVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="16" MaxWidth="920" MaxHeight="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,8">
                        <Run Text="XEM TRƯỚC PHIẾU "/>
                        <Run Text="{Binding PreviewTicketDetail.DisplayNumber, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="MẶT TRƯỚC" Command="{Binding ShowPreviewFrontCommand}" Style="{StaticResource FilterButton}" Margin="0,0,6,0"/>
                        <Button Content="MẶT SAU" Command="{Binding ShowPreviewBackCommand}" Style="{StaticResource FilterButton}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding PreviewTicketDetail}">
                            <StackPanel Visibility="{Binding DataContext.IsPreviewFrontSide, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Khách hàng" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName, TargetNullValue=—}" Margin="0,0,0,6"/>
                                <TextBlock Text="Biển số" FontWeight="SemiBold"/><TextBlock Text="{Binding LicensePlate, TargetNullValue=—}" Margin="0,0,0,6"/>
                                <TextBlock Text="Loại hàng" FontWeight="SemiBold"/><TextBlock Text="{Binding CargoTypeName, TargetNullValue=—}" Margin="0,0,0,6"/>
                                <TextBlock Text="Cân lần 1" FontWeight="SemiBold"/><TextBlock Margin="0,0,0,6"><Run Text="{Binding Weight1Kg, StringFormat={}{0:N0} kg, Mode=OneWay, TargetNullValue=—}"/><Run Text="  "/><Run Text="{Binding Weight1RecordedAt, StringFormat=HH:mm:ss dd/MM/yyyy, Mode=OneWay}"/></TextBlock>
                                <TextBlock Text="Cân lần 2" FontWeight="SemiBold"/><TextBlock Margin="0,0,0,6"><Run Text="{Binding Weight2Kg, StringFormat={}{0:N0} kg, Mode=OneWay, TargetNullValue=—}"/><Run Text="  "/><Run Text="{Binding Weight2RecordedAt, StringFormat=HH:mm:ss dd/MM/yyyy, Mode=OneWay}"/></TextBlock>
                                <TextBlock Text="Tổng / Bì / Hàng" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,0,0,6"><Run Text="{Binding GrossWeightKg, StringFormat={}{0:N0}, Mode=OneWay, TargetNullValue=—}"/><Run Text=" / "/><Run Text="{Binding TareWeightKg, StringFormat={}{0:N0}, Mode=OneWay, TargetNullValue=—}"/><Run Text=" / "/><Run Text="{Binding NetWeightKg, StringFormat={}{0:N0}, Mode=OneWay, TargetNullValue=—}"/></TextBlock>
                                <TextBlock Text="Ghi chú" FontWeight="SemiBold"/><TextBlock Text="{Binding Notes, TargetNullValue=—}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding DataContext.IsPreviewFrontSide, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding Weight1PhotoStatusText, TargetNullValue=Chưa có ảnh cân}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Weight2PhotoStatusText, TargetNullValue=Chưa có ảnh cân}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button Content="SAO CHÉP ẢNH" Command="{Binding CopyTicketImageCommand}" Style="{StaticResource FilterButton}"/>
                        <Button Content="LƯU ẢNH" Command="{Binding SaveTicketImageCommand}" Style="{StaticResource FilterButton}"/>
                        <Button Content="IN PHIẾU" Command="{Binding PrintTicketCommand}" Style="{StaticResource FilterButton}"/>
                        <Button Content="ĐÓNG" Command="{Binding CloseTicketPreviewCommand}" Style="{StaticResource CancelButton}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
