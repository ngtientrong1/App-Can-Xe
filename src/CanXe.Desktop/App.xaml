<Application x:Class="CanXe.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/AutoCompleteTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#1B5E20"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF8F00"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#BDBDBD"/>
            <SolidColorBrush x:Key="NetHighlightBrush" Color="#0D47A1"/>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Padding" Value="18,12"/>
                <Setter Property="Margin" Value="6,4"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinHeight" Value="58"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="Button" x:Key="RecordWeightButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="MinWidth" Value="200"/>
            </Style>

            <Style TargetType="Button" x:Key="FilterButton">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinHeight" Value="40"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="SectionHeader">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#424242"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="MinHeight" Value="38"/>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="RowHeight" Value="42"/>
                <Setter Property="ColumnHeaderHeight" Value="44"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
