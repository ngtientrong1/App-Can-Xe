<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

                    xmlns:local="clr-namespace:CanXe.Desktop.Controls"

                    xmlns:models="clr-namespace:CanXe.Application.Models;assembly=CanXe.Application">

    <DataTemplate DataType="{x:Type models:AutocompleteSuggestionItem}">

        <StackPanel Margin="4,6">

            <TextBlock Text="{Binding PrimaryText}" FontSize="17" FontWeight="SemiBold"

                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Text="{Binding SecondaryText}" FontSize="14"

                       Foreground="{DynamicResource SecondaryTextBrush}"

                       Visibility="{Binding SecondaryText, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>

            <TextBlock Text="{Binding TertiaryText}" FontSize="13"

                       Foreground="{DynamicResource SecondaryTextBrush}"

                       Visibility="{Binding TertiaryText, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>

        </StackPanel>

    </DataTemplate>



    <Style TargetType="{x:Type local:AutoCompleteTextBox}">

        <Setter Property="FontSize" Value="16"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type local:AutoCompleteTextBox}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <TextBox x:Name="PART_TextBox" Grid.Row="0"

                                 Style="{DynamicResource CanXeTextBoxStyle}"

                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                 FontSize="{TemplateBinding FontSize}"

                                 MinHeight="56"/>

                        <Border x:Name="PART_DropDown" Grid.Row="1" Margin="0,4,0,0"

                                Background="{DynamicResource CardBackgroundBrush}"

                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"

                                CornerRadius="8" MaxHeight="280"

                                Visibility="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">

                            <ListBox x:Name="PART_ListBox"

                                     ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"

                                     BorderThickness="0" Background="Transparent">

                                <ListBox.ItemContainerStyle>

                                    <Style TargetType="ListBoxItem">

                                        <Setter Property="Padding" Value="10,8"/>

                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                        <Style.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter Property="Background" Value="#F0F4F8"/>

                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">

                                                <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>

                                                <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>

                                            </Trigger>

                                        </Style.Triggers>

                                    </Style>

                                </ListBox.ItemContainerStyle>

                            </ListBox>

                        </Border>

                    </Grid>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>

