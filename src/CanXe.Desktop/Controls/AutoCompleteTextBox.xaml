<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CanXe.Desktop.Controls"
                    xmlns:models="clr-namespace:CanXe.Application.Models;assembly=CanXe.Application">
    <DataTemplate DataType="{x:Type models:AutocompleteSuggestionItem}">
        <StackPanel Margin="0,2">
            <TextBlock Text="{Binding PrimaryText}" FontSize="18"/>
            <TextBlock Text="{Binding SecondaryText}" FontSize="14" Foreground="#757575"
                       Visibility="{Binding SecondaryText, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>
            <TextBlock Text="{Binding TertiaryText}" FontSize="13" Foreground="#9E9E9E"
                       Visibility="{Binding TertiaryText, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type local:AutoCompleteTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AutoCompleteTextBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PART_TextBox" Grid.Row="0"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Padding="8,6"/>
                        <Border x:Name="PART_DropDown" Grid.Row="1"
                                Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                                MaxHeight="220"
                                Visibility="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                            <ListBox x:Name="PART_ListBox"
                                     ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                     BorderThickness="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                <Setter Property="Foreground" Value="#0D47A1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
