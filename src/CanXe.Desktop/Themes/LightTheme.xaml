    <SolidColorBrush x:Key="WarningBannerBackgroundBrush" Color="#FBF1DE"/>
    <SolidColorBrush x:Key="WarningBannerBorderBrush" Color="#B5790F"/>
    <SolidColorBrush x:Key="InfoBannerBackgroundBrush" Color="#E2F2F0"/>
