<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- "Bảng Cân" — modern data-dense enterprise, cool neutral ground, single teal accent. -->

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FBFCFD"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FBFCFD"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DBE1E7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DBE1E7"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#DBE1E7"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#152430"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#152430"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#3E4C59"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3E4C59"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#647787"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0C6E6E"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#1A8754"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B5790F"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#C0392B"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#0C6E6E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0C6E6E"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#E2F2F0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A5B5B"/>
    <SolidColorBrush x:Key="NetHighlightBrush" Color="#0C6E6E"/>
    <SolidColorBrush x:Key="IconAccentBrush" Color="#0C6E6E"/>

    <SolidColorBrush x:Key="SuccessGreenBrush" Color="#1A8754"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1A8754"/>
    <SolidColorBrush x:Key="WeightStableBrush" Color="#1A8754"/>
    <SolidColorBrush x:Key="WeightOrangeBrush" Color="#B5790F"/>
    <SolidColorBrush x:Key="ActionOrangeBrush" Color="#B5790F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="ErrorRedBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B5790F"/>
    <SolidColorBrush x:Key="CancelGrayBrush" Color="#647787"/>

    <!-- Tinted-background button fills: a dim tint of the semantic color, paired with the solid
         semantic brush above as text/border. -->
    <SolidColorBrush x:Key="AccentTintBackgroundBrush" Color="#E2F2F0"/>
    <SolidColorBrush x:Key="SuccessTintBackgroundBrush" Color="#E5F5EC"/>
    <SolidColorBrush x:Key="WeightTintBackgroundBrush" Color="#FBF1DE"/>
    <SolidColorBrush x:Key="DangerTintBackgroundBrush" Color="#FBEAE8"/>
    <SolidColorBrush x:Key="CancelTintBackgroundBrush" Color="#EEF1F3"/>

    <!-- Recessed "digital readout" bezel behind the live-weight number. -->
    <SolidColorBrush x:Key="ReadoutBackgroundBrush" Color="#FBFCFD"/>
    <SolidColorBrush x:Key="ReadoutBorderBrush" Color="#DBE1E7"/>

    <SolidColorBrush x:Key="SelectedRowBrush" Color="#E2F2F0"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#E2F2F0"/>
    <SolidColorBrush x:Key="FilterActiveBackgroundBrush" Color="#0C6E6E"/>
    <SolidColorBrush x:Key="SummaryAccentBrush" Color="#0C6E6E"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FBFCFD"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#DBE1E7"/>
