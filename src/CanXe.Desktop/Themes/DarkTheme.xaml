<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- "Trạm Cân" — industrial scale-indicator control panel, amber as the primary accent. -->

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#12161B"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12161B"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#181D24"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E242C"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1E242C"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A323C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A323C"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#2A323C"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E7ECEF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7ECEF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7C0C9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B7C0C9"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8695A3"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#3ECF8E"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF6259"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#241C0E"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFC559"/>
    <SolidColorBrush x:Key="NetHighlightBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="IconAccentBrush" Color="#FFB020"/>

    <SolidColorBrush x:Key="SuccessGreenBrush" Color="#3ECF8E"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3ECF8E"/>
    <SolidColorBrush x:Key="WeightStableBrush" Color="#3ECF8E"/>
    <SolidColorBrush x:Key="WeightOrangeBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="ActionOrangeBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6259"/>
    <SolidColorBrush x:Key="ErrorRedBrush" Color="#FF6259"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="CancelGrayBrush" Color="#8695A3"/>

    <!-- Tinted-background button fills: a dim, near-black tint of the semantic color, paired with
         the solid semantic brush above as text/border — the mockup's instrument-panel button. -->
    <SolidColorBrush x:Key="AccentTintBackgroundBrush" Color="#241C0E"/>
    <SolidColorBrush x:Key="SuccessTintBackgroundBrush" Color="#0F2B20"/>
    <SolidColorBrush x:Key="WeightTintBackgroundBrush" Color="#2B1F0C"/>
    <SolidColorBrush x:Key="DangerTintBackgroundBrush" Color="#241417"/>
    <SolidColorBrush x:Key="CancelTintBackgroundBrush" Color="#1E242C"/>

    <!-- Recessed "digital readout" bezel behind the live-weight number. -->
    <SolidColorBrush x:Key="ReadoutBackgroundBrush" Color="#0A0D10"/>
    <SolidColorBrush x:Key="ReadoutBorderBrush" Color="#050708"/>

    <SolidColorBrush x:Key="SelectedRowBrush" Color="#241C0E"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#241C0E"/>
    <SolidColorBrush x:Key="FilterActiveBackgroundBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="SummaryAccentBrush" Color="#FFB020"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0A0D10"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2A323C"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#E7ECEF"/>
    <SolidColorBrush x:Key="InputSelectionBrush" Color="#6A4D13"/>
    <SolidColorBrush x:Key="InputCaretBrush" Color="#FFB020"/>

    <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush" Color="#2A323C"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#2A323C"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9FB0BD"/>

    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#181D24"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#1E242C"/>
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#181D24"/>
    <SolidColorBrush x:Key="DataGridAlternateRowBackgroundBrush" Color="#1B2129"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#2A323C"/>

    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#F2181D22"/>
    <SolidColorBrush x:Key="ToastBorderBrush" Color="#3ECF8E"/>
    <SolidColorBrush x:Key="ToastTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastDetailBrush" Color="#B7C0C9"/>

    <SolidColorBrush x:Key="WeighPanelBackgroundBrush" Color="#0A0D10"/>
    <SolidColorBrush x:Key="WeighPanelBorderBrush" Color="#2A323C"/>

    <SolidColorBrush x:Key="AdminBadgeBackgroundBrush" Color="#0F2B20"/>
    <SolidColorBrush x:Key="AdminBadgeBorderBrush" Color="#3ECF8E"/>
    <SolidColorBrush x:Key="AdminBadgeForegroundBrush" Color="#3ECF8E"/>

    <SolidColorBrush x:Key="IconEditHoverBackgroundBrush" Color="#241C0E"/>
    <SolidColorBrush x:Key="IconEditHoverBorderBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="IconEditPressedBackgroundBrush" Color="#6A4D13"/>
    <SolidColorBrush x:Key="IconDeleteHoverBackgroundBrush" Color="#241417"/>
    <SolidColorBrush x:Key="IconDeleteHoverBorderBrush" Color="#FF6259"/>
    <SolidColorBrush x:Key="IconDeletePressedBackgroundBrush" Color="#5A2530"/>

    <SolidColorBrush x:Key="StatusBadgeBackgroundBrush" Color="#0F2B20"/>
    <SolidColorBrush x:Key="StatusBadgeBorderBrush" Color="#1C5B41"/>
    <SolidColorBrush x:Key="FooterBarBackgroundBrush" Color="#1E242C"/>

    <SolidColorBrush x:Key="WarningBannerBackgroundBrush" Color="#2B1F0C"/>
    <SolidColorBrush x:Key="WarningBannerBorderBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="InfoBannerBackgroundBrush" Color="#241C0E"/>
    <SolidColorBrush x:Key="InfoBannerBorderBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="InfoBannerForegroundBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="EditBannerBackgroundBrush" Color="#2B1F0C"/>
    <SolidColorBrush x:Key="EditBannerBorderBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="EditBannerForegroundBrush" Color="#FFB020"/>

    <SolidColorBrush x:Key="TabItemBackgroundBrush" Color="#1E242C"/>
    <SolidColorBrush x:Key="TabItemSelectedBackgroundBrush" Color="#241C0E"/>
    <SolidColorBrush x:Key="TabItemHoverBackgroundBrush" Color="#252C36"/>
    <SolidColorBrush x:Key="ComboBoxDropdownBackgroundBrush" Color="#181D24"/>
    <SolidColorBrush x:Key="DatePickerBackgroundBrush" Color="#181D24"/>
</ResourceDictionary>
