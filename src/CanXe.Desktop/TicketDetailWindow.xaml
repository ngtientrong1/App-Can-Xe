<Window x:Class="CanXe.Desktop.TicketDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CanXe.Desktop.Converters"
        Title="{Binding WindowTitle}"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="18"
        Background="White">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Khách hàng" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail.CustomerName, TargetNullValue=—}"/>
                        <TextBlock Text="Biển số" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Detail.LicensePlate, TargetNullValue=—}"/>
                        <TextBlock Text="Loại hàng" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Detail.CargoTypeName, TargetNullValue=—}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ngày giờ" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail.TicketDateTime, StringFormat=dd/MM/yyyy HH:mm:ss}"/>
                        <TextBlock Text="Đơn giá" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="UnitPriceBlock"/>
                        <TextBlock Text="Ghi chú" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Detail.Notes, TargetNullValue=—}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#BDBDBD" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="CÂN LẦN 1" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail.Weight1Kg, StringFormat={}{0:N0} kg, TargetNullValue=—}"/>
                            <TextBlock Text="{Binding Detail.Weight1RecordedAt, StringFormat=HH:mm:ss dd/MM/yyyy, TargetNullValue=''}" FontSize="14" Foreground="#616161"/>
                            <Image x:Name="Weight1Image" Height="100" Stretch="Uniform" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Weight1PhotoPlaceholder" Text="{Binding Detail.Weight1PhotoStatusText}" Foreground="#757575" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#BDBDBD" BorderThickness="1" Padding="10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="CÂN LẦN 2" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail.Weight2Kg, StringFormat={}{0:N0} kg, TargetNullValue=—}"/>
                            <TextBlock Text="{Binding Detail.Weight2RecordedAt, StringFormat=HH:mm:ss dd/MM/yyyy, TargetNullValue=''}" FontSize="14" Foreground="#616161"/>
                            <Image x:Name="Weight2Image" Height="100" Stretch="Uniform" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Weight2PhotoPlaceholder" Text="{Binding Detail.Weight2PhotoStatusText}" Foreground="#757575" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#F5F5F5" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="KẾT QUẢ CÂN" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="TỔNG"/>
                                <TextBlock Text="{Binding Detail.GrossWeightKg, StringFormat={}{0:N0} kg, TargetNullValue=—}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="BÌ"/>
                                <TextBlock Text="{Binding Detail.TareWeightKg, StringFormat={}{0:N0} kg, TargetNullValue=—}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="HÀNG" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Detail.NetWeightKg, StringFormat={}{0:N0} kg, TargetNullValue=—}" FontWeight="Bold" FontSize="20"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock>
                                <Run Text="Trừ bì: "/>
                                <Run Text="{Binding Detail.DeductionWeightKg, StringFormat={}{0:N3} kg, Mode=OneWay, TargetNullValue=—}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Khối lượng tính tiền: "/>
                                <Run Text="{Binding Detail.BillableWeightKg, StringFormat=N0, Mode=OneWay, TargetNullValue=—}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Thành tiền: "/>
                                <Run Text="{Binding Detail.TotalAmountVnd, StringFormat=N0, Mode=OneWay, TargetNullValue=—}"/>
                            </TextBlock>
                            <TextBlock Text="Cân dịch vụ — chưa nhập đơn giá" Foreground="#757575" FontSize="14"
                                       Visibility="{Binding Detail.IsServiceWeigh, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="TIẾP TỤC CÂN" Click="Continue_Click" MinHeight="44" MinWidth="140" Margin="0,0,8,0"
                    Visibility="{Binding Detail.CanContinue, Converter={StaticResource BoolToVis}}"/>
            <Button Content="ĐÓNG" Click="Close_Click" MinHeight="44" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
