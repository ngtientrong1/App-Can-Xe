<Window x:Class="CanXe.Desktop.Views.Reports.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem báo cáo"
        Width="1240"
        Height="880"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrintButton" Content="IN BÁO CÁO" MinWidth="140" Margin="0,0,8,0"
                            Style="{StaticResource CanXePrimaryButtonStyle}" Click="PrintButton_OnClick" IsDefault="True"/>
                    <Button Content="ĐÓNG" MinWidth="100" Style="{StaticResource FilterButton}"
                            Click="CloseButton_OnClick" IsCancel="True"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PagesControl" HorizontalAlignment="Center" Margin="16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,16" Background="White" BorderBrush="#33000000" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <Image Source="{Binding}" Stretch="None" SnapsToDevicePixels="True"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
