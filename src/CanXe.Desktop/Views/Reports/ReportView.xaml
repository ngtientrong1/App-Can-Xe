<UserControl x:Class="CanXe.Desktop.Views.Reports.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CanXe.Application.Models;assembly=CanXe.Application"
             xmlns:conv="clr-namespace:CanXe.Desktop.Converters"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <conv:VietnameseNumberConverter x:Key="VnNumberConverter"/>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BÁO CÁO PHIẾU CÂN" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Bộ lọc" Style="{StaticResource SectionHeaderTextStyle}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Từ ngày" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FromDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Đến ngày" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ToDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Trạng thái" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding WorkflowFilter}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Tất cả" Tag="{x:Static models:ReportWorkflowFilter.All}"/>
                            <ComboBoxItem Content="Hoàn tất" Tag="{x:Static models:ReportWorkflowFilter.Completed}"/>
                            <ComboBoxItem Content="Chờ cân lần 2" Tag="{x:Static models:ReportWorkflowFilter.AwaitingSecondWeigh}"/>
                            <ComboBoxItem Content="Chưa có giá" Tag="{x:Static models:ReportWorkflowFilter.MissingPrice}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Khách hàng" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomerKeyword}" Style="{StaticResource CanXeTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Biển số xe" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LicensePlateKeyword}" Style="{StaticResource CanXeTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Loại hàng" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CargoTypeKeyword}" Style="{StaticResource CanXeTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="LỌC" Command="{Binding ApplyFilterCommand}" Style="{StaticResource CanXePrimaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="XÓA LỌC" Command="{Binding ClearFilterCommand}" Style="{StaticResource FilterButton}" Margin="0,0,8,0"/>
                    <Button Content="XUẤT EXCEL" Command="{Binding ExportExcelCommand}" Style="{StaticResource FilterButton}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Rows="2" Margin="0,0,0,8">
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="0,0,6,6">
                <StackPanel>
                    <TextBlock Text="Số phiếu" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SummaryTicketCount, Converter={StaticResource VnNumberConverter}, ConverterParameter=integer}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="3,0,3,6">
                <StackPanel>
                    <TextBlock Text="Tổng hàng (kg)" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SummaryTotalNetKg, Converter={StaticResource VnNumberConverter}, ConverterParameter=weight}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="6,0,0,6">
                <StackPanel>
                    <TextBlock Text="KL tính tiền" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SummaryTotalBillableKg, Converter={StaticResource VnNumberConverter}, ConverterParameter=weight}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Tổng tiền" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SummaryTotalAmountVnd, Converter={StaticResource VnNumberConverter}, ConverterParameter=money}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Chưa có giá" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SummaryMissingPriceCount, Converter={StaticResource VnNumberConverter}, ConverterParameter=integer}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CanXeSummaryCardStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Chờ cân lần 2" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SummaryAwaitingSecondWeighCount, Converter={StaticResource VnNumberConverter}, ConverterParameter=integer}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DataGrid x:Name="ReportDataGrid"
                  Grid.Row="3"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Style="{StaticResource CanXeDataGridStyle}"
                  VerticalAlignment="Stretch"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  PreviewMouseWheel="ReportDataGrid_OnPreviewMouseWheel">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày giờ" Binding="{Binding TicketDateTime, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Số phiếu" Binding="{Binding DisplayNumber}" Width="110"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName, TargetNullValue=—}" Width="*"/>
                <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate, TargetNullValue=—}" Width="100"/>
                <DataGridTextColumn Header="Loại hàng" Binding="{Binding CargoTypeName, TargetNullValue=—}" Width="*"/>
                <DataGridTextColumn Header="Tổng" Binding="{Binding GrossWeightKg, Converter={StaticResource VnNumberConverter}, ConverterParameter=weight}" Width="72"/>
                <DataGridTextColumn Header="Bì" Binding="{Binding TareWeightKg, Converter={StaticResource VnNumberConverter}, ConverterParameter=weight}" Width="68"/>
                <DataGridTextColumn Header="Hàng" Binding="{Binding NetWeightKg, Converter={StaticResource VnNumberConverter}, ConverterParameter=weight}" Width="72"/>
                <DataGridTextColumn Header="KL tính tiền" Binding="{Binding BillableWeightKg, Converter={StaticResource VnNumberConverter}, ConverterParameter=weight}" Width="95"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceVndPerKg, Converter={StaticResource VnNumberConverter}, ConverterParameter=money}" Width="85"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalAmountVnd, Converter={StaticResource VnNumberConverter}, ConverterParameter=money}" Width="100"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes, TargetNullValue=—}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
