<UserControl x:Class="CanXe.Desktop.Views.Printing.WeighTicketCopyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:CanXe.Domain.Services;assembly=CanXe.Domain"
             xmlns:typo="clr-namespace:CanXe.Domain.Services;assembly=CanXe.Domain"
             xmlns:local="clr-namespace:CanXe.Desktop.Views.Printing"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             ClipToBounds="False"
             Background="White"
             Width="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
             MaxWidth="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
             Height="{x:Static layout:WeighTicketPrintLayout.TicketLogicalHeightDip}"
             MaxHeight="{x:Static layout:WeighTicketPrintLayout.TicketLogicalHeightDip}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Geometry x:Key="PersonIconGeometry">M12,5.1 C9.55,5.1 7.75,7.05 7.75,9.35 C7.75,10.95 8.75,12.25 10.15,12.8 L10.15,13.75 C7.15,14.3 6,16.05 6,17.35 L18,17.35 C18,16.05 16.85,14.3 13.85,13.75 L13.85,12.8 C15.25,12.25 16.25,10.95 16.25,9.35 C16.25,7.05 14.45,5.1 12,5.1 Z</Geometry>
        <Geometry x:Key="VehicleIconGeometry">M7.6,10.35 L9.1,8.05 H14.9 L16.4,10.35 V12.85 C16.4,13.95 15.75,14.65 14.7,14.65 H9.3 C8.25,14.65 7.6,13.95 7.6,12.85 Z</Geometry>
        <Geometry x:Key="ClockIconGeometry">M12,12 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M12,8 L12,12 L15.5,14.5</Geometry>
        <Geometry x:Key="CalendarIconGeometry">M5,8 L19,8 L19,19 L5,19 Z M8,5.5 L8,9 M16,5.5 L16,9 M5,11.5 L19,11.5 M8.5,14.5 L8.5,14.51 M12,14.5 L12,14.51 M15.5,14.5 L15.5,14.51 M8.5,17 L8.5,17.01 M12,17 L12,17.01 M15.5,17 L15.5,17.01</Geometry>

        <Style x:Key="TicketIconPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style x:Key="TimestampIconPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="Black" />
            <Setter Property="StrokeThickness" Value="{x:Static local:TicketPrintLayoutXaml.TimestampIconStrokeThickness}" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style x:Key="HairlineBottom" TargetType="Border">
            <Setter Property="Height" Value="{x:Static layout:WeighTicketPrintLayout.RowSeparatorThicknessDip}" />
            <Setter Property="Background" Value="#707070" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="TicketCardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="{x:Static local:TicketPrintLayoutXaml.CardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{x:Static local:TicketPrintLayoutXaml.CardCornerRadius}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CardHostStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.CardHostInset}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource TicketCardBorderStyle}" />

        <Style x:Key="HeroCardBorderStyle" TargetType="Border" BasedOn="{StaticResource TicketCardBorderStyle}">
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.WeightCardPadding}" />
        </Style>

        <Style x:Key="IdentityIconTileStyle" TargetType="Border">
            <Setter Property="Background" Value="Black" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static local:TicketPrintLayoutXaml.IdentityIconTileCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{x:Static local:TicketPrintLayoutXaml.IdentityIconTileInset}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="IdentityInnerGridStyle" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="DetailRowSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="{x:Static layout:WeighTicketPrintLayout.DetailRowSeparatorThicknessDip}" />
            <Setter Property="Background" Value="#707070" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="{x:Static local:TicketPrintLayoutXaml.DetailRowSeparatorInset}" />
        </Style>

        <Style x:Key="FieldRowGrid" TargetType="Grid">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.DetailLabelDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.DetailLabelInset}" />
        </Style>

        <Style x:Key="DetailValueRightStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.DetailValueDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.DetailValueInset}" />
        </Style>

        <Style x:Key="NotesValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailValueRightStyle}">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HeroCardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.HeroCardLabelDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="HeroWeightValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.HeroWeightValueDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="HeroWeightUnitStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.HeroWeightUnitDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3,0,0,1" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="CustomerValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.CustomerValueDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="MaxHeight" Value="{x:Static layout:WeighTicketPrintLayout.IdentityCardsHeightDip}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="{x:Static typo:WeighTicketPrintTypography.CustomerValueMinDip}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="PlateValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.PlateValueDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="HeaderAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="PlateAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="{x:Static typo:WeighTicketPrintTypography.PlateValueMinDip}" />
        </Style>

        <Style x:Key="IdentityAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxHeight" Value="{x:Static layout:WeighTicketPrintLayout.IdentityCardsHeightDip}" />
        </Style>

        <Style x:Key="WeighBlockTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighTitleDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="WeighBlockTimeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighTimeDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="WeighBlockTimeAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="{x:Static typo:WeighTicketPrintTypography.WeighTimeMinDip}" />
        </Style>

        <Style x:Key="WeighBlockDateStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighDateDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid MinWidth="0"
          Background="White"
          Width="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
          Height="{x:Static layout:WeighTicketPrintLayout.TicketLogicalHeightDip}"
          MaxWidth="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
          ClipToBounds="False"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <TextBlock x:Name="ReprintWatermark"
                   Panel.ZIndex="0"
                   Text="BẢN IN LẠI"
                   FontFamily="Segoe UI, Arial"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="Black"
                   Opacity="0.04"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="{Binding ShowReprintWatermark, Converter={StaticResource BoolVis}}">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="-22" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <Grid x:Name="SafeContentHost"
              Panel.ZIndex="1"
              MinWidth="0"
              Margin="{x:Static local:TicketPrintLayoutXaml.SafeContentPadding}"
              ClipToBounds="False">
        <Grid MinWidth="0"
              Width="{x:Static layout:WeighTicketPrintLayout.ContentUsableWidthDip}"
              Height="{x:Static layout:WeighTicketPrintLayout.ContentUsableHeightDip}"
              ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.HeaderSectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.TitleSectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.WeightHeroSectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.HeroBodySpacerRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodySectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodySignatureSpacerRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.SignatureSectionRow}" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderSection" Grid.Row="0" MinWidth="0" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.HeaderLeftColumn}" MinWidth="0" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.HeaderRightColumn}" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        MinWidth="0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        ClipToBounds="False"
                        Margin="{x:Static local:TicketPrintLayoutXaml.HeaderLeftInset}">
                <TextBlock x:Name="StationNameText"
                           Text="{Binding StationName}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.StationNameDip}"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           TextWrapping="NoWrap"
                           TextTrimming="None"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0" />
                <TextBlock Text="{Binding Address}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.AddressDip}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="24"
                           MinWidth="0"
                           Foreground="Black" />
                <TextBlock x:Name="StationPhoneText"
                           Text="{Binding Phone}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.AddressDip}"
                           MinWidth="0"
                           TextWrapping="NoWrap"
                           TextTrimming="None"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0"
                           Foreground="Black" />
            </StackPanel>

            <Grid Grid.Column="1"
                  MinWidth="0"
                  Margin="{x:Static local:TicketPrintLayoutXaml.HeaderRightInset}"
                  VerticalAlignment="Center"
                  ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Style="{StaticResource HeaderAutoFitViewbox}">
                    <TextBlock x:Name="StationTypeText"
                               Text="{Binding StationSubtitle}"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.StationTypeDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               TextWrapping="NoWrap"
                               TextTrimming="None"
                               Foreground="Black" />
                </Viewbox>
                <Viewbox Grid.Row="1" Style="{StaticResource HeaderAutoFitViewbox}">
                    <TextBlock x:Name="TicketNumberText"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               TextWrapping="NoWrap"
                               TextTrimming="None"
                               Foreground="Black">
                        <Run Text="SỐ PHIẾU: "
                             FontFamily="Segoe UI, Arial"
                             FontSize="{x:Static typo:WeighTicketPrintTypography.TicketLabelDip}" />
                        <Run Text="{Binding DisplayNumber, Mode=OneWay}"
                             FontFamily="Segoe UI, Arial"
                             FontSize="{x:Static typo:WeighTicketPrintTypography.TicketNumberDip}"
                             FontWeight="Bold" />
                    </TextBlock>
                </Viewbox>
            </Grid>

            <Border Grid.ColumnSpan="2" Style="{StaticResource HairlineBottom}" />
        </Grid>

        <!-- Title -->
        <Grid Grid.Row="1" MinWidth="0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.SeparatorRow}" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="PHIẾU CÂN XE"
                       FontFamily="Segoe UI, Arial"
                       FontSize="{x:Static typo:WeighTicketPrintTypography.TitleDip}"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
            <Border Grid.Row="1" Background="Black" Opacity="0.35" />
        </Grid>

        <!-- Hero weight cards -->
        <Grid Grid.Row="2" MinWidth="0" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.WeightHeroColumn}" MinWidth="0" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.WeightCardGapColumn}" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.WeightHeroColumn}" MinWidth="0" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.WeightCardGapColumn}" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.WeightHeroColumn}" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardHostStyle}">
                <Border x:Name="HeroCardGross" Style="{StaticResource HeroCardBorderStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="0">
                    <TextBlock Text="KHỐI LƯỢNG XE + HÀNG" Style="{StaticResource HeroCardLabelStyle}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GrossWeightValue}" Style="{StaticResource HeroWeightValueStyle}" />
                        <TextBlock Text="{Binding GrossWeightUnit}" Style="{StaticResource HeroWeightUnitStyle}"
                                   Visibility="{Binding ShowGrossWeightUnit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
                </Border>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardHostStyle}">
                <Border x:Name="HeroCardTare" Style="{StaticResource HeroCardBorderStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="0">
                    <TextBlock Text="KHỐI LƯỢNG XE" Style="{StaticResource HeroCardLabelStyle}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TareWeightValue}" Style="{StaticResource HeroWeightValueStyle}" />
                        <TextBlock Text="{Binding TareWeightUnit}" Style="{StaticResource HeroWeightUnitStyle}"
                                   Visibility="{Binding ShowTareWeightUnit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
                </Border>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardHostStyle}">
                <Border x:Name="HeroCardNet" Style="{StaticResource HeroCardBorderStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="0">
                    <TextBlock Text="KHỐI LƯỢNG HÀNG" Style="{StaticResource HeroCardLabelStyle}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NetWeightValue}" Style="{StaticResource HeroWeightValueStyle}" />
                        <TextBlock Text="{Binding NetWeightUnit}" Style="{StaticResource HeroWeightUnitStyle}"
                                   Visibility="{Binding ShowNetWeightUnit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="4" MinWidth="0" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BodyLeftSectionColumn}" MinWidth="0" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BodyGapColumn}" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BodyRightSectionColumn}" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Body left -->
            <Grid Grid.Column="0" MinWidth="0" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.IdentityCardsRow}" />
                    <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.IdentityDetailsSpacerRow}" />
                    <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.DetailsTableRow}" />
                </Grid.RowDefinitions>

                <!-- Identity cards -->
                <Grid Grid.Row="0" MinWidth="0" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.IdentityCustomerColumn}" MinWidth="0" />
                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.IdentityCardGapColumn}" />
                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.IdentityVehicleColumn}" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardHostStyle}">
                        <Border x:Name="CustomerIdentityCard"
                                Style="{StaticResource CardBorderStyle}">
                        <Grid Style="{StaticResource IdentityInnerGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.IdentityIconTileColumn}" />
                                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.IdentityIconSeparatorColumn}" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    x:Name="CustomerIconTile"
                                    Style="{StaticResource IdentityIconTileStyle}">
                                <Viewbox Width="{x:Static local:TicketPrintLayoutXaml.IdentityIconGraphicSize}"
                                         Height="{x:Static local:TicketPrintLayoutXaml.IdentityIconGraphicSize}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Stretch="Uniform">
                                    <Path Data="{StaticResource PersonIconGeometry}"
                                          Style="{StaticResource TicketIconPathStyle}"
                                          Width="24"
                                          Height="24" />
                                </Viewbox>
                            </Border>
                            <Border Grid.Column="1" Background="#707070" BorderThickness="0" />
                            <Viewbox Grid.Column="2"
                                     Style="{StaticResource IdentityAutoFitViewbox}"
                                     Margin="{x:Static local:TicketPrintLayoutXaml.IdentityValuePadding}">
                                <TextBlock x:Name="CustomerValueText"
                                           Text="{Binding CustomerName}"
                                           Style="{StaticResource CustomerValueStyle}" />
                            </Viewbox>
                        </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardHostStyle}">
                        <Border x:Name="PlateIdentityCard"
                                Style="{StaticResource CardBorderStyle}">
                        <Grid Style="{StaticResource IdentityInnerGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.IdentityIconTileColumn}" />
                                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.IdentityIconSeparatorColumn}" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    x:Name="PlateIconTile"
                                    Style="{StaticResource IdentityIconTileStyle}">
                                <Viewbox Width="{x:Static local:TicketPrintLayoutXaml.IdentityIconGraphicSize}"
                                         Height="{x:Static local:TicketPrintLayoutXaml.IdentityIconGraphicSize}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Stretch="Uniform">
                                    <Path Data="{StaticResource VehicleIconGeometry}"
                                          Style="{StaticResource TicketIconPathStyle}"
                                          Width="24"
                                          Height="24" />
                                </Viewbox>
                            </Border>
                            <Border Grid.Column="1" Background="#707070" BorderThickness="0" />
                            <Viewbox Grid.Column="2"
                                     Style="{StaticResource PlateAutoFitViewbox}"
                                     Margin="{x:Static local:TicketPrintLayoutXaml.IdentityValuePadding}">
                                <TextBlock x:Name="PlateValueText"
                                           Text="{Binding LicensePlate}"
                                           Style="{StaticResource PlateValueStyle}" />
                            </Viewbox>
                        </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- Details table -->
                <Border Grid.Row="2" Style="{StaticResource CardHostStyle}">
                <Border x:Name="DetailsTableCard"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="{x:Static local:TicketPrintLayoutXaml.DetailsTablePadding}"
                        MinWidth="0">
                    <Grid MinWidth="0" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Style="{StaticResource FieldRowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldLabelColumn}" MinWidth="0" />
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldValueColumn}" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Loại hàng:" />
                        <TextBlock Grid.Column="1" x:Name="CargoTypeValueText" Style="{StaticResource DetailValueRightStyle}" Text="{Binding CargoTypeName}" />
                        <Border Grid.ColumnSpan="2" Style="{StaticResource DetailRowSeparatorStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" Style="{StaticResource FieldRowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldLabelColumn}" MinWidth="0" />
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldValueColumn}" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Đơn giá:" />
                        <TextBlock Grid.Column="1" x:Name="UnitPriceValueText" Style="{StaticResource DetailValueRightStyle}" Text="{Binding UnitPrice}" />
                        <Border Grid.ColumnSpan="2" Style="{StaticResource DetailRowSeparatorStyle}" />
                    </Grid>

                    <Grid Grid.Row="2" Style="{StaticResource FieldRowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldLabelColumn}" MinWidth="0" />
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldValueColumn}" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Thành tiền:" />
                        <TextBlock Grid.Column="1"
                                   x:Name="TotalAmountValueText"
                                   Style="{StaticResource DetailValueRightStyle}"
                                   FontSize="{x:Static typo:WeighTicketPrintTypography.DetailAmountDip}"
                                   FontWeight="Bold"
                                   Text="{Binding TotalAmount}" />
                        <Border Grid.ColumnSpan="2" Style="{StaticResource DetailRowSeparatorStyle}" />
                    </Grid>

                    <Grid Grid.Row="3" Style="{StaticResource FieldRowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldLabelColumn}" MinWidth="0" />
                            <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.FieldValueColumn}" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Ghi chú:" />
                        <TextBlock Grid.Column="1" Style="{StaticResource NotesValueTextStyle}" Text="{Binding Notes}" />
                        <Border Grid.ColumnSpan="2" Style="{StaticResource DetailRowSeparatorStyle}" />
                    </Grid>
                    </Grid>
                </Border>
                </Border>
            </Grid>

            <!-- Body right: timestamp card + sign date row -->
            <Grid Grid.Column="2" MinWidth="0" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.TimestampCardRow}" />
                    <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.SignDateRow}" />
                </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardHostStyle}">
            <Border x:Name="TimestampCard"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="{x:Static local:TicketPrintLayoutXaml.TimestampCardPadding}"
                    MinWidth="0">
                <Grid MinWidth="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.WeighBlock1Row}" />
                        <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.DashedSeparatorRow}" />
                        <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.WeighBlock2Row}" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="0">
                        <StackPanel HorizontalAlignment="Center" MinWidth="0">
                            <TextBlock Text="CÂN LẦN 1" Style="{StaticResource WeighBlockTitleStyle}" />
                            <StackPanel Visibility="{Binding Weigh1Recorded, Converter={StaticResource BoolVis}}">
                                <Grid HorizontalAlignment="Center" Margin="0,1,0,0" MinWidth="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.TimestampIconColumn}" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0"
                                             x:Name="Weigh1IconTile"
                                             Width="{x:Static local:TicketPrintLayoutXaml.TimestampIconSize}"
                                             Height="{x:Static local:TicketPrintLayoutXaml.TimestampIconSize}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stretch="Uniform">
                                        <Path Data="{StaticResource ClockIconGeometry}"
                                              Style="{StaticResource TimestampIconPathStyle}"
                                              Width="24"
                                              Height="24" />
                                    </Viewbox>
                                    <Viewbox Grid.Column="1"
                                             Style="{StaticResource WeighBlockTimeAutoFitViewbox}"
                                             Margin="2,0,0,0">
                                        <TextBlock x:Name="Weigh1TimeText"
                                                   Text="{Binding Weigh1Time}"
                                                   Style="{StaticResource WeighBlockTimeStyle}" />
                                    </Viewbox>
                                </Grid>
                                <TextBlock x:Name="Weigh1DateText" Text="{Binding Weigh1Date}" Style="{StaticResource WeighBlockDateStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Weigh1Recorded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="CHƯA CÂN" Style="{StaticResource WeighBlockTitleStyle}" />
                                <TextBlock Text="—" Style="{StaticResource WeighBlockDateStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Height="{x:Static layout:WeighTicketPrintLayout.RowSeparatorThicknessDip}"
                            Background="Black"
                            Opacity="0.35"
                            VerticalAlignment="Center" />

                    <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="0">
                        <StackPanel HorizontalAlignment="Center" MinWidth="0">
                            <TextBlock Text="CÂN LẦN 2" Style="{StaticResource WeighBlockTitleStyle}" />
                            <StackPanel Visibility="{Binding Weigh2Recorded, Converter={StaticResource BoolVis}}">
                                <Grid HorizontalAlignment="Center" Margin="0,1,0,0" MinWidth="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.TimestampIconColumn}" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0"
                                             x:Name="Weigh2IconTile"
                                             Width="{x:Static local:TicketPrintLayoutXaml.TimestampIconSize}"
                                             Height="{x:Static local:TicketPrintLayoutXaml.TimestampIconSize}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stretch="Uniform">
                                        <Path Data="{StaticResource CalendarIconGeometry}"
                                              Style="{StaticResource TimestampIconPathStyle}"
                                              Width="24"
                                              Height="24" />
                                    </Viewbox>
                                    <Viewbox Grid.Column="1"
                                             Style="{StaticResource WeighBlockTimeAutoFitViewbox}"
                                             Margin="2,0,0,0">
                                        <TextBlock x:Name="Weigh2TimeText"
                                                   Text="{Binding Weigh2Time}"
                                                   Style="{StaticResource WeighBlockTimeStyle}" />
                                    </Viewbox>
                                </Grid>
                                <TextBlock x:Name="Weigh2DateText" Text="{Binding Weigh2Date}" Style="{StaticResource WeighBlockDateStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Weigh2Recorded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="CHƯA CÂN" Style="{StaticResource WeighBlockTitleStyle}" />
                                <TextBlock Text="—" Style="{StaticResource WeighBlockDateStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
            </Border>

            <Grid Grid.Row="1"
                  x:Name="SignDateRowPanel"
                  MinWidth="0"
                  VerticalAlignment="Stretch">
                <TextBlock x:Name="SignDateText"
                           Text="{Binding SignDateText}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.SignDateDip}"
                           Foreground="Black"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="None"
                           MinWidth="0" />
            </Grid>
            </Grid>
        </Grid>

        <!-- Signature -->
        <Grid Grid.Row="6"
              x:Name="SignatureSection"
              MinWidth="0"
              ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.SeparatorRow}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="SignatureTopSeparator" Background="Black" Opacity="0.35" />

            <Grid Grid.Row="1" MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.SignatureSeparatorColumn}" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.SignatureSeparatorColumn}" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" MinWidth="0" Margin="{x:Static local:TicketPrintLayoutXaml.SignatureRoleInset}">
                    <TextBlock Text="LÁI XE"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.SignatureRoleDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                    <Border Height="{x:Static layout:WeighTicketPrintLayout.SignatureBlankHeightDip}" />
                </StackPanel>

                <Border Grid.Column="1" Background="Black" Opacity="0.35" />

                <StackPanel Grid.Column="2" MinWidth="0" Margin="{x:Static local:TicketPrintLayoutXaml.SignatureRoleInset}">
                    <TextBlock Text="CHỦ HÀNG"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.SignatureRoleDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                    <Border Height="{x:Static layout:WeighTicketPrintLayout.SignatureBlankHeightDip}" />
                </StackPanel>

                <Border Grid.Column="3" Background="Black" Opacity="0.35" />

                <StackPanel Grid.Column="4" MinWidth="0" Margin="{x:Static local:TicketPrintLayoutXaml.SignatureRoleInset}">
                    <TextBlock Text="NGƯỜI CÂN"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.SignatureRoleDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                    <Border Height="{x:Static layout:WeighTicketPrintLayout.SignatureBlankHeightDip}" />
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
