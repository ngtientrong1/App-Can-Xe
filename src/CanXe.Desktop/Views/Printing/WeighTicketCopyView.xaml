<UserControl x:Class="CanXe.Desktop.Views.Printing.WeighTicketCopyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:CanXe.Domain.Services;assembly=CanXe.Domain"
             xmlns:typo="clr-namespace:CanXe.Domain.Services;assembly=CanXe.Domain"
             xmlns:local="clr-namespace:CanXe.Desktop.Views.Printing"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             ClipToBounds="False"
             Background="White"
             Width="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
             MaxWidth="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
             Height="{x:Static layout:WeighTicketPrintLayout.TicketLogicalHeightDip}"
             MaxHeight="{x:Static layout:WeighTicketPrintLayout.TicketLogicalHeightDip}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Geometry x:Key="PersonIconGeometry">M12,5.1 C9.55,5.1 7.75,7.05 7.75,9.35 C7.75,10.95 8.75,12.25 10.15,12.8 L10.15,13.75 C7.15,14.3 6,16.05 6,17.35 L18,17.35 C18,16.05 16.85,14.3 13.85,13.75 L13.85,12.8 C15.25,12.25 16.25,10.95 16.25,9.35 C16.25,7.05 14.45,5.1 12,5.1 Z</Geometry>
        <Geometry x:Key="VehicleIconGeometry">M7.6,10.35 L9.1,8.05 H14.9 L16.4,10.35 V12.85 C16.4,13.95 15.75,14.65 14.7,14.65 H9.3 C8.25,14.65 7.6,13.95 7.6,12.85 Z</Geometry>
        <Geometry x:Key="ClockIconGeometry">M12,12 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M12,8 L12,12 L15.5,14.5</Geometry>
        <Geometry x:Key="CalendarIconGeometry">M5,8 L19,8 L19,19 L5,19 Z M8,5.5 L8,9 M16,5.5 L16,9 M5,11.5 L19,11.5 M8.5,14.5 L8.5,14.51 M12,14.5 L12,14.51 M15.5,14.5 L15.5,14.51 M8.5,17 L8.5,17.01 M12,17 L12,17.01 M15.5,17 L15.5,17.01</Geometry>

        <Style x:Key="TicketIconPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style x:Key="TimestampIconPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="Black" />
            <Setter Property="StrokeThickness" Value="{x:Static local:TicketPrintLayoutXaml.TimestampIconStrokeThickness}" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style x:Key="HairlineBottom" TargetType="Border">
            <Setter Property="Height" Value="{x:Static layout:WeighTicketPrintLayout.RowSeparatorThicknessDip}" />
            <Setter Property="Background" Value="#707070" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="TicketCardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="{x:Static local:TicketPrintLayoutXaml.CardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{x:Static local:TicketPrintLayoutXaml.CardCornerRadius}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CardHostStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.CardHostInset}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource TicketCardBorderStyle}" />

        <Style x:Key="HeroCardBorderStyle" TargetType="Border" BasedOn="{StaticResource TicketCardBorderStyle}">
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.WeightCardPadding}" />
        </Style>

        <Style x:Key="IdentityIconTileStyle" TargetType="Border">
            <Setter Property="Background" Value="Black" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static local:TicketPrintLayoutXaml.IdentityIconTileCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{x:Static local:TicketPrintLayoutXaml.IdentityIconTileInset}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="IdentityInnerGridStyle" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="DetailRowSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="{x:Static layout:WeighTicketPrintLayout.DetailRowSeparatorThicknessDip}" />
            <Setter Property="Background" Value="#707070" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="{x:Static local:TicketPrintLayoutXaml.DetailRowSeparatorInset}" />
        </Style>

        <Style x:Key="FieldRowGrid" TargetType="Grid">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.DetailLabelDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.DetailLabelInset}" />
        </Style>

        <Style x:Key="DetailValueRightStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.DetailValueDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="{x:Static local:TicketPrintLayoutXaml.DetailValueInset}" />
        </Style>

        <Style x:Key="NotesValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailValueRightStyle}">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HeroCardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.HeroCardLabelDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="HeroWeightValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.HeroWeightValueDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="HeroWeightUnitStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.HeroWeightUnitDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3,0,0,1" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="CustomerValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.CustomerValueDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="MaxHeight" Value="{x:Static layout:WeighTicketPrintLayout.IdentityCardsHeightDip}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="{x:Static typo:WeighTicketPrintTypography.CustomerValueMinDip}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="PlateValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.PlateValueDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="HeaderAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="PlateAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="{x:Static typo:WeighTicketPrintTypography.PlateValueMinDip}" />
        </Style>

        <Style x:Key="IdentityAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxHeight" Value="{x:Static layout:WeighTicketPrintLayout.IdentityCardsHeightDip}" />
        </Style>

        <Style x:Key="WeighBlockTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighTitleDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="WeighBlockTimeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighTimeDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="WeighBlockTimeAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="{x:Static typo:WeighTicketPrintTypography.WeighTimeMinDip}" />
        </Style>

        <Style x:Key="WeighBlockDateStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighDateDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- rc24: band-based body redesign — one tinted horizontal band, split by thin dividers,
             used for the hero (plate/weight), the two weighings, and the customer/cargo fields. -->
        <Style x:Key="BandContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#F4F4F2" />
            <Setter Property="CornerRadius" Value="{x:Static local:TicketPrintLayoutXaml.CardCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style x:Key="BandDividerStyle" TargetType="Border">
            <Setter Property="Background" Value="#CCCCCC" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="WeighTagStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighTagDip}" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="WeighCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighDateDip}" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="WeighValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighValueDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="WeighValueUnitStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.WeighTagDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="3,0,0,1" />
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.InfoLabelDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.InfoValueDip}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="NotesLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InfoLabelStyle}" />
        <Style x:Key="NotesValueStyle" TargetType="TextBlock" BasedOn="{StaticResource InfoValueStyle}" />

        <Style x:Key="TotalCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="{x:Static local:TicketPrintLayoutXaml.CardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{x:Static local:TicketPrintLayoutXaml.CardCornerRadius}" />
            <Setter Property="Background" Value="#F4F4F2" />
            <Setter Property="Padding" Value="10,3,10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="{x:Static layout:WeighTicketPrintLayout.TotalCardMaxWidthDip}" />
        </Style>

        <Style x:Key="TotalCardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.TotalCardLabelDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- An unusually large amount shrinks to fit the card instead of pushing past it,
             same idiom as the plate/customer auto-fit viewboxes elsewhere on the ticket. Lives in
             a Grid star column (not a StackPanel) so it actually receives a bounded width to
             shrink against instead of being measured with infinite available space. -->
        <Style x:Key="TotalCardValueAutoFitViewbox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="TotalCardValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="{x:Static typo:WeighTicketPrintTypography.TotalCardValueDip}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <Grid MinWidth="0"
          Background="White"
          Width="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
          Height="{x:Static layout:WeighTicketPrintLayout.TicketLogicalHeightDip}"
          MaxWidth="{x:Static layout:WeighTicketPrintLayout.TicketLogicalWidthDip}"
          ClipToBounds="False"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <TextBlock x:Name="ReprintWatermark"
                   Panel.ZIndex="0"
                   Text="BẢN IN LẠI"
                   FontFamily="Segoe UI, Arial"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="Black"
                   Opacity="0.04"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="{Binding ShowReprintWatermark, Converter={StaticResource BoolVis}}">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="-22" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <Grid x:Name="SafeContentHost"
              Panel.ZIndex="1"
              MinWidth="0"
              Margin="{x:Static local:TicketPrintLayoutXaml.SafeContentPadding}"
              ClipToBounds="False">
        <Grid MinWidth="0"
              Width="{x:Static layout:WeighTicketPrintLayout.ContentUsableWidthDip}"
              Height="{x:Static layout:WeighTicketPrintLayout.ContentUsableHeightDip}"
              ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.HeaderSectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.TitleSectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.WeightHeroSectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.HeroBodySpacerRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodySectionRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodySignatureSpacerRow}" />
            <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.SignatureSectionRow}" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderSection" Grid.Row="0" MinWidth="0" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.HeaderLeftColumn}" MinWidth="0" />
                <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.HeaderRightColumn}" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        MinWidth="0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        ClipToBounds="False"
                        Margin="{x:Static local:TicketPrintLayoutXaml.HeaderLeftInset}">
                <TextBlock x:Name="StationNameText"
                           Text="{Binding StationName}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.StationNameDip}"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           TextWrapping="NoWrap"
                           TextTrimming="None"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0" />
                <TextBlock Text="{Binding Address}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.AddressDip}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="24"
                           MinWidth="0"
                           Foreground="Black" />
                <TextBlock x:Name="StationPhoneText"
                           Text="{Binding Phone}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.AddressDip}"
                           MinWidth="0"
                           TextWrapping="NoWrap"
                           TextTrimming="None"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0"
                           Foreground="Black" />
            </StackPanel>

            <Grid Grid.Column="1"
                  MinWidth="0"
                  Margin="{x:Static local:TicketPrintLayoutXaml.HeaderRightInset}"
                  VerticalAlignment="Center"
                  ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Style="{StaticResource HeaderAutoFitViewbox}">
                    <TextBlock x:Name="StationTypeText"
                               Text="{Binding StationSubtitle}"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.StationTypeDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               TextWrapping="NoWrap"
                               TextTrimming="None"
                               Foreground="Black" />
                </Viewbox>
                <Viewbox Grid.Row="1" Style="{StaticResource HeaderAutoFitViewbox}">
                    <TextBlock x:Name="TicketNumberText"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               TextWrapping="NoWrap"
                               TextTrimming="None"
                               Foreground="Black">
                        <Run Text="SỐ PHIẾU: "
                             FontFamily="Segoe UI, Arial"
                             FontSize="{x:Static typo:WeighTicketPrintTypography.TicketLabelDip}" />
                        <Run Text="{Binding DisplayNumber, Mode=OneWay}"
                             FontFamily="Segoe UI, Arial"
                             FontSize="{x:Static typo:WeighTicketPrintTypography.TicketNumberDip}"
                             FontWeight="Bold" />
                    </TextBlock>
                </Viewbox>
            </Grid>

            <Border Grid.ColumnSpan="2" Style="{StaticResource HairlineBottom}" />
        </Grid>

        <!-- Title -->
        <Grid Grid.Row="1" MinWidth="0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.SeparatorRow}" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="PHIẾU CÂN XE"
                       FontFamily="Segoe UI, Arial"
                       FontSize="{x:Static typo:WeighTicketPrintTypography.TitleDip}"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
            <Border Grid.Row="1" Background="Black" Opacity="0.35" />
        </Grid>

        <!-- Hero band: the two facts that matter most at a glance — plate and net cargo weight. -->
        <Border Grid.Row="2" Style="{StaticResource BandContainerStyle}">
            <Grid MinWidth="0" ClipToBounds="False" Margin="{x:Static local:TicketPrintLayoutXaml.WeightCardPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BandDividerColumn}" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="0">
                    <TextBlock Text="BIỂN SỐ XE" Style="{StaticResource HeroCardLabelStyle}" Margin="0,0,0,2" />
                    <Viewbox Style="{StaticResource PlateAutoFitViewbox}" HorizontalAlignment="Center">
                        <TextBlock x:Name="PlateValueText" Text="{Binding LicensePlate}" Style="{StaticResource PlateValueStyle}" />
                    </Viewbox>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource BandDividerStyle}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="0">
                    <TextBlock Text="KHỐI LƯỢNG HÀNG" Style="{StaticResource HeroCardLabelStyle}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NetWeightValue}" Style="{StaticResource HeroWeightValueStyle}" />
                        <TextBlock Text="{Binding NetWeightUnit}" Style="{StaticResource HeroWeightUnitStyle}"
                                   Visibility="{Binding ShowNetWeightUnit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: three stacked full-width bands instead of a left/right column split — weigh
             band, info band, then notes + the highlighted total. -->
        <Grid Grid.Row="4" MinWidth="0" ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodyWeighBandRow}" />
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodyRowGapRow}" />
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodyInfoBandRow}" />
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodyRowGapRow}" />
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.BodyBottomRowRow}" />
            </Grid.RowDefinitions>

            <!-- Weigh band: Cân lần 1 (Tổng) | Cân lần 2 (Bì) -->
            <Border Grid.Row="0" Style="{StaticResource BandContainerStyle}">
                <Grid MinWidth="0" ClipToBounds="True" Margin="{x:Static local:TicketPrintLayoutXaml.TimestampCardPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BandDividerColumn}" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CÂN LẦN 1" Style="{StaticResource WeighBlockTitleStyle}" TextAlignment="Left" HorizontalAlignment="Left" />
                                <TextBlock Text=" (Tổng)" Style="{StaticResource WeighTagStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Weigh1Recorded, Converter={StaticResource BoolVis}}">
                                <TextBlock x:Name="Weigh1TimeText" Text="{Binding Weigh1Time}" Style="{StaticResource WeighCaptionStyle}" />
                                <TextBlock Text=" · " Style="{StaticResource WeighCaptionStyle}" />
                                <TextBlock x:Name="Weigh1DateText" Text="{Binding Weigh1Date}" Style="{StaticResource WeighCaptionStyle}" />
                            </StackPanel>
                            <TextBlock Text="CHƯA CÂN">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WeighCaptionStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Weigh1Recorded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock Text="{Binding GrossWeightValue}" Style="{StaticResource WeighValueStyle}" />
                            <TextBlock Text="{Binding GrossWeightUnit}" Style="{StaticResource WeighValueUnitStyle}"
                                       Visibility="{Binding ShowGrossWeightUnit, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Style="{StaticResource BandDividerStyle}" />

                    <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="0" Margin="6,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CÂN LẦN 2" Style="{StaticResource WeighBlockTitleStyle}" TextAlignment="Left" HorizontalAlignment="Left" />
                                <TextBlock Text=" (Bì)" Style="{StaticResource WeighTagStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Weigh2Recorded, Converter={StaticResource BoolVis}}">
                                <TextBlock x:Name="Weigh2TimeText" Text="{Binding Weigh2Time}" Style="{StaticResource WeighCaptionStyle}" />
                                <TextBlock Text=" · " Style="{StaticResource WeighCaptionStyle}" />
                                <TextBlock x:Name="Weigh2DateText" Text="{Binding Weigh2Date}" Style="{StaticResource WeighCaptionStyle}" />
                            </StackPanel>
                            <TextBlock Text="CHƯA CÂN">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WeighCaptionStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Weigh2Recorded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock Text="{Binding TareWeightValue}" Style="{StaticResource WeighValueStyle}" />
                            <TextBlock Text="{Binding TareWeightUnit}" Style="{StaticResource WeighValueUnitStyle}"
                                       Visibility="{Binding ShowTareWeightUnit, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Info band: Khách hàng | Loại hàng | Đơn giá | Trừ hao -->
            <Border Grid.Row="2" Style="{StaticResource BandContainerStyle}">
                <Grid MinWidth="0" ClipToBounds="True" Margin="{x:Static local:TicketPrintLayoutXaml.TimestampCardPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" MinWidth="0" />
                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BandDividerColumn}" />
                        <ColumnDefinition Width="1*" MinWidth="0" />
                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BandDividerColumn}" />
                        <ColumnDefinition Width="1*" MinWidth="0" />
                        <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.BandDividerColumn}" />
                        <ColumnDefinition Width="0.85*" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0">
                        <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock x:Name="CustomerValueText" Text="{Binding CustomerName}" Style="{StaticResource InfoValueStyle}"
                                   MaxHeight="{x:Static layout:WeighTicketPrintLayout.BodyInfoBandHeightDip}" />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource BandDividerStyle}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0" Margin="6,0,6,0">
                        <TextBlock Text="LOẠI HÀNG" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock x:Name="CargoTypeValueText" Text="{Binding CargoTypeName}" Style="{StaticResource InfoValueStyle}" />
                    </StackPanel>

                    <Border Grid.Column="3" Style="{StaticResource BandDividerStyle}" />

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="0" Margin="6,0,6,0">
                        <TextBlock Text="ĐƠN GIÁ" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock x:Name="UnitPriceValueText" Style="{StaticResource InfoValueStyle}" Text="{Binding UnitPrice}" />
                    </StackPanel>

                    <Border Grid.Column="5" Style="{StaticResource BandDividerStyle}" />

                    <StackPanel Grid.Column="6" VerticalAlignment="Center" MinWidth="0" Margin="6,0,0,0">
                        <TextBlock Text="TRỪ HAO" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock x:Name="DeductionWeightValueText" Style="{StaticResource InfoValueStyle}" Text="{Binding DeductionWeightDisplay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom row: Ghi chú takes the spare width, Thành tiền stays a contained highlight,
                 with the sign-date line tucked underneath leading into the signature section. -->
            <Grid Grid.Row="4" x:Name="SignDateRowPanel" MinWidth="0" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MinWidth="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0" Margin="0,0,10,0">
                        <TextBlock Text="GHI CHÚ" Style="{StaticResource NotesLabelStyle}" />
                        <TextBlock Style="{StaticResource NotesValueStyle}" Text="{Binding Notes}" />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource TotalCardStyle}">
                        <Grid MinWidth="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="THÀNH TIỀN" Style="{StaticResource TotalCardLabelStyle}" />
                            <Viewbox Grid.Column="1" Style="{StaticResource TotalCardValueAutoFitViewbox}">
                                <TextBlock x:Name="TotalAmountValueText" Style="{StaticResource TotalCardValueStyle}" Text="{Binding TotalAmount}" />
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="SignDateText"
                           Grid.Row="1"
                           Text="{Binding SignDateText}"
                           FontFamily="Segoe UI, Arial"
                           FontSize="{x:Static typo:WeighTicketPrintTypography.SignDateDip}"
                           Foreground="#777777"
                           TextAlignment="Right"
                           HorizontalAlignment="Right"
                           Margin="0,1,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="None"
                           MinWidth="0" />
            </Grid>
        </Grid>

        <!-- Signature -->
        <Grid Grid.Row="6"
              x:Name="SignatureSection"
              MinWidth="0"
              ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="{x:Static local:TicketPrintLayoutXaml.SeparatorRow}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="SignatureTopSeparator" Background="Black" Opacity="0.35" />

            <Grid Grid.Row="1" MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.SignatureSeparatorColumn}" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="{x:Static local:TicketPrintLayoutXaml.SignatureSeparatorColumn}" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" MinWidth="0" Margin="{x:Static local:TicketPrintLayoutXaml.SignatureRoleInset}">
                    <TextBlock Text="LÁI XE"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.SignatureRoleDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                    <Border Height="{x:Static layout:WeighTicketPrintLayout.SignatureBlankHeightDip}" />
                </StackPanel>

                <StackPanel Grid.Column="2" MinWidth="0" Margin="{x:Static local:TicketPrintLayoutXaml.SignatureRoleInset}">
                    <TextBlock Text="CHỦ HÀNG"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.SignatureRoleDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                    <Border Height="{x:Static layout:WeighTicketPrintLayout.SignatureBlankHeightDip}" />
                </StackPanel>

                <StackPanel Grid.Column="4" MinWidth="0" Margin="{x:Static local:TicketPrintLayoutXaml.SignatureRoleInset}">
                    <TextBlock Text="NGƯỜI CÂN"
                               FontFamily="Segoe UI, Arial"
                               FontSize="{x:Static typo:WeighTicketPrintTypography.SignatureRoleDip}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                    <Border Height="{x:Static layout:WeighTicketPrintLayout.SignatureBlankHeightDip}" />
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
