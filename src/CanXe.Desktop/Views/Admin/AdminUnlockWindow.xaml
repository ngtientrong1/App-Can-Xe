<Window x:Class="CanXe.Desktop.Views.Admin.AdminUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MỞ KHÓA ADMIN"
        MinWidth="440"
        Width="440"
        MinHeight="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CardBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Border Padding="24,20,24,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="MỞ KHÓA ADMIN"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,16"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Grid.Row="1"
                       Text="Nhập mã Admin"
                       FontSize="14"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <PasswordBox x:Name="PasswordBox"
                         Grid.Row="2"
                         MinHeight="44"
                         FontSize="16"
                         Margin="0,0,0,8"
                         Padding="10,8"
                         KeyDown="PasswordBox_OnKeyDown"/>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       FontSize="13"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource DangerTextBrush}"/>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Mở khóa"
                        MinWidth="120"
                        MinHeight="44"
                        Margin="0,0,10,0"
                        Padding="16,8"
                        IsDefault="True"
                        Click="Unlock_Click"
                        Style="{StaticResource CanXePrimaryButtonStyle}"/>
                <Button Content="Hủy"
                        MinWidth="100"
                        MinHeight="44"
                        Padding="16,8"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Style="{StaticResource CanXeSecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
