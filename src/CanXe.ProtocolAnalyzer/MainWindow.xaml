<Window x:Class="CanXe.ProtocolAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CanXe Protocol Analyzer — Offline"
        Width="1280" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F3F5F8">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Import log..." Command="{Binding ImportFilesCommand}" MinWidth="120" MinHeight="36" Margin="0,0,8,0"/>
            <Button Content="Run full analysis" Command="{Binding RunFullAnalysisCommand}" MinWidth="140" MinHeight="36" Margin="0,0,8,0"/>
            <Button Content="Export report" Command="{Binding ExportReportCommand}" MinWidth="120" MinHeight="36"/>
            <TextBlock Text="Kéo thả file .log vào cửa sổ" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#546E7A"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Sessions">
                <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding SessionLabel}" Width="*"/>
                        <DataGridTextColumn Header="Known kg" Binding="{Binding KnownWeightKg}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Stable" Binding="{Binding IsStableSession}" Width="60"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Bytes" Binding="{Binding TotalBytes}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Replay">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Play" Command="{Binding PlayCommand}" MinWidth="70" Margin="0,0,6,0"/>
                        <Button Content="Pause" Command="{Binding PauseCommand}" MinWidth="70" Margin="0,0,6,0"/>
                        <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70" Margin="0,0,6,0"/>
                        <Button Content="Instant" Command="{Binding InstantCommand}" MinWidth="80" Margin="0,0,12,0"/>
                        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox SelectedValue="{Binding ReplaySpeed}" Width="80">
                            <ComboBoxItem Content="0.25" Tag="0.25"/>
                            <ComboBoxItem Content="0.5" Tag="0.5"/>
                            <ComboBoxItem Content="1" Tag="1"/>
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="10" Tag="10"/>
                        </ComboBox>
                    </StackPanel>
                    <GroupBox Grid.Row="1" Header="Current chunk HEX" Margin="0,0,0,8">
                        <TextBox Text="{Binding ReplayHex, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Accumulated stream">
                        <TextBox Text="{Binding AccumulatedHex, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Analyzer">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Text="{Binding AnalysisOutput, Mode=OneWay}" IsReadOnly="True" MinHeight="80" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Candidate" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="0 kg" Binding="{Binding ZeroKg}" Width="70"/>
                            <DataGridTextColumn Header="50 kg" Binding="{Binding FiftyKg}" Width="70"/>
                            <DataGridTextColumn Header="5030 kg" Binding="{Binding FiveTon}" Width="80"/>
                            <DataGridTextColumn Header="Dynamic" Binding="{Binding Dynamic}" Width="80"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="80"/>
                            <DataGridTextColumn Header="Transform" Binding="{Binding Transform}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusText, Mode=OneWay}" Margin="0,8,0,0" Foreground="#1565C0"/>
    </Grid>
</Window>
