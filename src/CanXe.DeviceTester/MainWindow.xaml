<Window x:Class="CanXe.DeviceTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CanXe Device Tester — Chẩn đoán COM"
        Width="1280" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Variable"
        Background="#F3F5F8">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <TextBlock Text="{Binding WarningBanner, Mode=OneWay}" TextWrapping="Wrap" FontSize="14" Foreground="#E65100"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE3EA" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,0,8,0">
                <StackPanel IsEnabled="{Binding IsConfigurationEnabled, Mode=OneWay}">
                    <TextBlock Text="Cấu hình cổng" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Port name"/><ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,0,6"/>
                    <TextBlock Text="Baud rate"/><TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBlock Text="Data bits"/><TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBlock Text="Parity"/><ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" Margin="0,0,0,6"/>
                    <TextBlock Text="Stop bits"/><ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" Margin="0,0,0,6"/>
                    <TextBlock Text="Handshake"/><ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding Handshake}" Margin="0,0,0,6"/>
                    <TextBlock Text="Read timeout (ms)"/><TextBox Text="{Binding ReadTimeout, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBlock Text="Encoding xem text"/><ComboBox ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding TextEncoding}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="QUÉT CỔNG" Command="{Binding ScanPortsCommand}" MinWidth="100" MinHeight="40" Margin="0,0,6,6"/>
                        <Button Content="MỞ CỔNG" Command="{Binding OpenPortCommand}" MinWidth="100" MinHeight="40" Margin="0,0,6,6"/>
                        <Button Content="ĐÓNG CỔNG" Command="{Binding ClosePortCommand}" MinWidth="100" MinHeight="40" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Phiên capture" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Nhãn phiên"/><ComboBox ItemsSource="{Binding SessionLabels}" SelectedItem="{Binding SelectedSessionLabel}" Margin="0,0,0,6"/>
                        <TextBlock Text="Trọng lượng hiển thị trên đầu cân"/><TextBox Text="{Binding ScaleDisplayWeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Tình trạng xe"/><TextBox Text="{Binding VehicleCondition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Thời gian bắt đầu / ghi chú"/><TextBox Text="{Binding SessionStartNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Ghi chú khác"/><TextBox Text="{Binding AdditionalNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Trạng thái" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#1565C0" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatsLine, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Thư mục log"/>
                        <TextBox Text="{Binding LogDirectory, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 Margin="0,0,0,4"/>
                        <Button Content="Chọn thư mục log" Command="{Binding ChooseLogFolderCommand}" HorizontalAlignment="Left" MinHeight="36" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LastSavedLogPath, Mode=OneWay, StringFormat=Đã lưu: {0}}" TextWrapping="Wrap" Foreground="#546E7A"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="BẮT ĐẦU GHI" Command="{Binding StartRecordingCommand}" MinWidth="130" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="DỪNG GHI" Command="{Binding StopRecordingCommand}" MinWidth="110" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="LƯU LOG" Command="{Binding SaveLogCommand}" MinWidth="110" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="XÓA MÀN HÌNH" Command="{Binding ClearDisplayCommand}" MinWidth="130" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="PAUSE HIỂN THỊ" Command="{Binding TogglePauseDisplayCommand}" MinWidth="150" MinHeight="44"/>
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,6,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Raw HEX (chunk gần nhất)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding LatestHex, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" BorderThickness="0" Background="Transparent"/></ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="3,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Raw text đã escape (chunk gần nhất)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding LatestEscaped, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" BorderThickness="0" Background="Transparent"/></ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="6,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Event chunks (DataReceived)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding EventChunks, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/></ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Buffer tích lũy (quan sát — không chia frame)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                            <TextBox Text="{Binding AccumulatedHex, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/>
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="4,0,0,0">
                            <TextBox Text="{Binding AccumulatedEscaped, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="#607D8B" FontSize="12"
                   Text="Chế độ chỉ đọc — không gửi byte xuống cổng. Không tự mở cổng khi khởi động."/>
    </Grid>
</Window>
