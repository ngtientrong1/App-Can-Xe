<Window x:Class="CanXe.DeviceTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CanXe Device Tester — Chẩn đoán COM"
        Width="1280" Height="920" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Variable"
        Background="#F3F5F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Chế độ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton Content="Chế độ thủ công" GroupName="CaptureMode" Margin="0,0,12,0"
                         IsChecked="{Binding IsManualMode, Mode=OneWay}"
                         Command="{Binding SetManualModeCommand}"
                         IsEnabled="{Binding IsModeSelectionEnabled, Mode=OneWay}"/>
            <RadioButton Content="Đo theo hướng dẫn" GroupName="CaptureMode"
                         IsChecked="{Binding IsGuidedMode, Mode=OneWay}"
                         Command="{Binding SetGuidedModeCommand}"
                         IsEnabled="{Binding IsModeSelectionEnabled, Mode=OneWay}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <TextBlock Text="{Binding WarningBanner, Mode=OneWay}" TextWrapping="Wrap" FontSize="14" Foreground="#E65100"/>
        </Border>

        <Border Grid.Row="2" Background="#FFEBEE" BorderBrush="#E53935" BorderThickness="1"
                CornerRadius="8" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding IsGuidedMode, Converter={StaticResource BoolVis}}">
            <TextBlock Text="KHÔNG MỞ PHẦN MỀM CÂN CŨ CÙNG LÚC" FontWeight="Bold" FontSize="16"
                       Foreground="#B71C1C" HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE3EA" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,0,8,0">
                <StackPanel IsEnabled="{Binding IsConfigurationEnabled, Mode=OneWay}">
                    <TextBlock Text="Cấu hình cổng" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Cấu hình thử nghiệm"/>
                    <ComboBox ItemsSource="{Binding AvailableComTestPresets}" SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Name" Margin="0,0,0,6"
                              IsEnabled="{Binding IsPresetSelectionEnabled, Mode=OneWay}"/>
                    <TextBlock Text="Port name"/><ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,0,6"/>
                    <TextBlock Text="Baud rate"/><TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBlock Text="Data bits"/><TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBlock Text="Parity"/><ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" Margin="0,0,0,6"/>
                    <TextBlock Text="Stop bits"/><ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" Margin="0,0,0,6"/>
                    <TextBlock Text="Handshake"/><ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding Handshake}" Margin="0,0,0,6"/>
                    <TextBlock Text="Read timeout (ms)"/><TextBox Text="{Binding ReadTimeout, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBlock Text="Encoding xem text"/><ComboBox ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding TextEncoding}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="QUÉT CỔNG" Command="{Binding ScanPortsCommand}" MinWidth="100" MinHeight="40" Margin="0,0,6,6"/>
                        <Button Content="MỞ CỔNG" Command="{Binding OpenPortCommand}" MinWidth="100" MinHeight="40" Margin="0,0,6,6"/>
                        <Button Content="ĐÓNG CỔNG" Command="{Binding ClosePortCommand}" MinWidth="100" MinHeight="40" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <Grid>
                    <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Phiên capture" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Nhãn phiên"/><ComboBox ItemsSource="{Binding SessionLabels}" SelectedItem="{Binding SelectedSessionLabel}" Margin="0,0,0,6"/>
                                <TextBlock Text="Trọng lượng hiển thị trên đầu cân"/><TextBox Text="{Binding ScaleDisplayWeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Tình trạng xe"/><TextBox Text="{Binding VehicleCondition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Thời gian bắt đầu / ghi chú"/><TextBox Text="{Binding SessionStartNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Ghi chú khác"/><TextBox Text="{Binding AdditionalNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Trạng thái" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#1565C0" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding StatsLine, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Thư mục log"/>
                                <TextBox Text="{Binding LogDirectory, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Margin="0,0,0,4"/>
                                <Button Content="Chọn thư mục log" Command="{Binding ChooseLogFolderCommand}" HorizontalAlignment="Left" MinHeight="36" Margin="0,0,0,6"/>
                                <CheckBox Content="Lưu thêm .raw.bin" IsChecked="{Binding SaveRawBinary}" Margin="0,0,0,4"/>
                                <CheckBox Content="Lưu thêm .session.json" IsChecked="{Binding SaveSessionJson}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding LastSavedLogPath, Mode=OneWay, StringFormat=Đã lưu: {0}}" TextWrapping="Wrap" Foreground="#546E7A"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsGuidedMode, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding GuidedStepTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding GuidedInstruction, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CountdownSeconds, Mode=OneWay, StringFormat=Countdown: {0}s}"
                                   FontSize="36" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Trọng lượng đầu cân (kg)"/>
                        <TextBox Text="{Binding ScaleDisplayWeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{Binding GuidedPrimaryButtonText, Mode=OneWay}" Command="{Binding GuidedStartStepCommand}" MinWidth="150" MinHeight="40" Margin="0,0,6,6"/>
                            <Button Content="{Binding GuidedTransitionButtonText, Mode=OneWay}" Command="{Binding GuidedTransitionMarkerCommand}" MinWidth="220" MinHeight="40" Margin="0,0,6,6"/>
                            <Button Content="HỦY PHIÊN" Command="{Binding GuidedCancelSessionCommand}" MinWidth="110" MinHeight="40" Margin="0,0,6,6"/>
                            <Button Content="LƯU PHIÊN" Command="{Binding GuidedSaveSessionCommand}" MinWidth="110" MinHeight="40" Margin="0,0,6,6"/>
                            <Button Content="LÀM LẠI PHIÊN" Command="{Binding GuidedRetrySessionCommand}" MinWidth="130" MinHeight="40" Margin="0,0,6,6"/>
                            <Button Content="SANG BƯỚC TIẾP" Command="{Binding GuidedNextStepCommand}" MinWidth="140" MinHeight="40" Margin="0,0,6,6"/>
                            <Button Content="DỪNG KHẨN CẤP" Command="{Binding GuidedEmergencyStopCommand}" MinWidth="130" MinHeight="40"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding GuidedConfigSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="#546E7A" Margin="0,0,0,8"/>
                        <TextBlock Text="Kiểm tra chất lượng" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding QualityReport, Mode=OneWay}" IsReadOnly="True" MinHeight="100" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="So sánh stable" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ComparisonReport, Mode=OneWay}" IsReadOnly="True" MinHeight="80" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="4" Margin="0,0,0,8" Visibility="{Binding IsManualMode, Converter={StaticResource BoolVis}}">
            <Button Content="BẮT ĐẦU GHI" Command="{Binding StartRecordingCommand}" MinWidth="130" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="DỪNG GHI" Command="{Binding StopRecordingCommand}" MinWidth="110" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="LƯU LOG" Command="{Binding SaveLogCommand}" MinWidth="110" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="XÓA MÀN HÌNH" Command="{Binding ClearDisplayCommand}" MinWidth="130" MinHeight="44" Margin="0,0,6,0"/>
            <Button Content="PAUSE HIỂN THỊ" Command="{Binding TogglePauseDisplayCommand}" MinWidth="150" MinHeight="44"/>
        </WrapPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Dữ liệu đã giải mã" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding DecodedFrameText, Mode=OneWay, StringFormat=Frame hiện tại: {0}}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding DecodedWeightText, Mode=OneWay, StringFormat=Weight: {0}}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding DecodedProtocolCode, Mode=OneWay, StringFormat=Protocol code: {0}}"/>
                        <TextBlock Text="{Binding DecodedChecksumReceived, Mode=OneWay, StringFormat=Checksum nhận được: {0}}"/>
                        <TextBlock Text="{Binding DecodedChecksumExpected, Mode=OneWay, StringFormat=Checksum dự kiến: {0}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DecodedValidityText, Mode=OneWay, StringFormat=Valid/Invalid: {0}}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DecodedStabilityText, Mode=OneWay, StringFormat=Stable/Unstable: {0}}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DecodedLastValidFrameTime, Mode=OneWay, StringFormat=Last valid frame time: {0}}"/>
                        <TextBlock Text="{Binding DecodedStatsText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,6,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Raw HEX (chunk gần nhất)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding LatestHex, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" BorderThickness="0" Background="Transparent"/></ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="3,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Raw text đã escape (chunk gần nhất)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding LatestEscaped, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" BorderThickness="0" Background="Transparent"/></ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="6,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Event chunks (DataReceived)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding EventChunks, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/></ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Buffer tích lũy (quan sát — không chia frame)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                            <TextBox Text="{Binding AccumulatedHex, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/>
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="4,0,0,0">
                            <TextBox Text="{Binding AccumulatedEscaped, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="6" Margin="0,8,0,0" Foreground="#607D8B" FontSize="12"
                   Text="Chế độ chỉ đọc — không gửi byte xuống cổng. Không tự mở cổng khi khởi động."/>
    </Grid>
</Window>
